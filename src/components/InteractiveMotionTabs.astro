              </li>
            </ul>
          </div>

          <!-- Visual Showcase -->
          <div class="lg:col-span-7 rounded-xl bg-secondary-bg/80 border border-subtle-stroke p-4 shadow-attio-3 space-y-3 font-sans">
            <div class="p-3.5 rounded-xl bg-surface border border-subtle-stroke space-y-2.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                  <span class="text-xs font-semibold text-foreground font-mono">Captain AI Guardrail Engine</span>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded bg-purple-500/15 text-purple-300 font-mono">Confidence: 99.8%</span>
              </div>
              
