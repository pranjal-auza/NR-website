          <!-- Visual Showcase -->
          <div class="lg:col-span-7 rounded-xl bg-secondary-bg/80 border border-subtle-stroke p-4 shadow-attio-3 space-y-3 font-sans">
            <div class="grid grid-cols-3 gap-2 text-xs">
              
              <!-- Column 1: Qualified -->
              <div class="p-2.5 rounded-xl bg-surface border border-subtle-stroke space-y-2">
