</section>

<style>
  .motion-tab-btn {
    background: transparent;
    color: var(--color-tertiary-foreground);
    border: 1px solid transparent;
  }
  
  .motion-tab-btn:hover {
    color: var(--color-primary-foreground);
    background: var(--color-surface-subtle);
  }

  .motion-tab-btn.active {
    background: var(--color-surface);
    color: var(--color-primary-foreground);
    border-color: var(--color-subtle-stroke);
    box-shadow: var(--shadow-attio-layer-2);
  }
</style>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.motion-tab-btn');
  const tabContents = document.querySelectorAll<HTMLElement>('.motion-tab-content');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      
      tabButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      tabContents.forEach(content => {
        if (content.id === targetId) {
          content.classList.remove('hidden');
          content.classList.add('block');
        } else {
          content.classList.remove('block');
          content.classList.add('hidden');
        }
      });
    });
  });
</script>
