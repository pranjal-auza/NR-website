          <!-- Visual Showcase -->
          <div class="lg:col-span-7 rounded-xl bg-secondary-bg/80 border border-subtle-stroke p-4 shadow-attio-3 space-y-2.5 font-sans">
            <div class="p-3.5 rounded-xl bg-surface border border-subtle-stroke space-y-2">
              <div class="flex items-center gap-2 text-xs font-mono font-semibold text-brand-400">
                <span class="w-2 h-2 rounded-full bg-brand-400"></span>
                <span>TRIGGER: Inbound Lead &gt; $10k Budget</span>
