---
import Icon from './icons/Icon.astro';
---

<section id="inbox" class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-500/10 text-brand-400 text-xs font-semibold uppercase tracking-wider border border-brand-500/20 font-mono">
        <Icon name="layers" class="w-3.5 h-3.5" />
        <span>Unified Enterprise Revenue Engine</span>
      </div>
      
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        Autonomous speed. Complete visibility.
      </h2>
      
      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        Picks up WhatsApp leads at 2am. Runs multi-channel nurture sequences. Catches high-value deals before they slip. Hands your reps the answer before they ask.
      </p>
    </div>

    <!-- Motion Navigation Tab Buttons -->
    <div class="flex items-center justify-center gap-2 overflow-x-auto pb-4 max-w-4xl mx-auto no-scrollbar">
      <button class="motion-tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer flex items-center gap-2" data-target="tab-inbox">
        <Icon name="inbox" class="w-4 h-4" />
        <span>Omnichannel Inbox</span>
      </button>

      <button class="motion-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer flex items-center gap-2" data-target="tab-captain">
        <Icon name="bot" class="w-4 h-4" />
        <span>Captain AI</span>
      </button>

      <button class="motion-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer flex items-center gap-2" data-target="tab-pipelines">
        <Icon name="kanban" class="w-4 h-4" />
        <span>CRM & Pipelines</span>
      </button>

      <button class="motion-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer flex items-center gap-2" data-target="tab-reputation">
        <Icon name="video" class="w-4 h-4" />
        <span>Reputation & Video</span>
      </button>

      <button class="motion-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer flex items-center gap-2" data-target="tab-workflows">
        <Icon name="zap" class="w-4 h-4" />
        <span>Workflows & Triggers</span>
      </button>
    </div>

    <!-- Motion Content Cards -->
    <div class="mt-8 max-w-5xl mx-auto">
      
      <!-- TAB 1: OMNICHANNEL INBOX -->
      <div id="tab-inbox" class="motion-tab-content block animate-fade-in">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center rounded-2xl enterprise-card p-6 sm:p-10 shadow-attio-5">
          <div class="lg:col-span-5 space-y-5">
            <div class="p-2.5 w-10 h-10 rounded-xl bg-brand-500/10 text-brand-400 border border-brand-500/20 flex items-center justify-center">
              <Icon name="inbox" class="w-5 h-5" />
            </div>
            <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              Every customer channel, unified in one stream.
            </h3>
            <p class="text-sm sm:text-base text-secondary-fg leading-relaxed">
              Stop juggling 5 disconnected apps. Live chat, WhatsApp Business API, 2-way SMS, Email, and Instagram DMs flow directly into a single collaborative team inbox with smart collision detection and auto-assignment.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-foreground pt-2">
              <li class="flex items-center gap-2.5">
                <span class="p-0.5 rounded-full bg-emerald-500/20 text-emerald-400"><Icon name="check" class="w-3 h-3" /></span>
                <span>Unified threads across WhatsApp, SMS, Email, and Live Chat</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="p-0.5 rounded-full bg-emerald-500/20 text-emerald-400"><Icon name="check" class="w-3 h-3" /></span>
                <span>Collision locking: visual badges prevent duplicate rep replies</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="p-0.5 rounded-full bg-emerald-500/20 text-emerald-400"><Icon name="check" class="w-3 h-3" /></span>
                <span>Sub-50ms carrier delivery with global webhook streams</span>
              </li>
            </ul>
          </div>

          <!-- Visual Showcase -->
          <div class="lg:col-span-7 rounded-xl bg-secondary-bg/80 border border-subtle-stroke p-4 shadow-attio-3 space-y-3 font-sans">
            <div class="flex items-center justify-between text-xs text-caption-fg pb-2 border-b border-subtle-stroke">
              <span class="font-mono text-foreground font-semibold">Unified Inbox • 24 Unread</span>
              <span class="text-emerald-400 font-mono text-[11px]">● 4 Reps Online • SLA 99.99%</span>
            </div>

            <!-- Inbox list simulation -->
            <div class="space-y-2">
              <div class="p-3 rounded-lg bg-surface border border-brand-500/40 shadow-attio-1 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">WA</div>
                  <div>
                    <div class="text-xs font-semibold text-foreground">David Miller (VP Product, ScaleBio)</div>
                    <div class="text-[11px] text-secondary-fg">"Ready to sign the $60k annual contract today..."</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-brand-500/10 text-brand-400 font-semibold">Assign to Alex</span>
              </div>

              <div class="p-3 rounded-lg bg-surface/50 border border-subtle-stroke flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-xs">SMS</div>
                  <div>
                    <div class="text-xs font-semibold text-foreground">Chloe Sterling (Founder, Pulse)</div>
                    <div class="text-[11px] text-secondary-fg">"Confirmed the 3pm product architecture demo."</div>
                  </div>
                </div>
                <span class="text-[10px] text-caption-fg font-mono">3m ago</span>
              </div>

              <div class="p-3 rounded-lg bg-surface/50 border border-subtle-stroke flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold text-xs">CHAT</div>
                  <div>
                    <div class="text-xs font-semibold text-foreground">Enterprise Buyer #1092</div>
                    <div class="text-[11px] text-secondary-fg">"Captain AI answered 4 pricing & SLA questions in 6s."</div>
                  </div>
                </div>
                <span class="text-[10px] text-emerald-400 font-mono">Resolved by AI ✓</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: CAPTAIN AI -->
      <div id="tab-captain" class="motion-tab-content hidden animate-fade-in">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center rounded-2xl enterprise-card p-6 sm:p-10 shadow-attio-5">
          <div class="lg:col-span-5 space-y-5">
            <div class="p-2.5 w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center">
              <Icon name="bot" class="w-5 h-5" />
            </div>
            <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              Autonomous resolution with Captain AI.
            </h3>
            <p class="text-sm sm:text-base text-secondary-fg leading-relaxed">
              Upload your company documents, knowledge base, and pricing sheets. Captain AI learns your business instantly to answer complex questions, schedule meetings, and draft high-converting replies for human reps.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-foreground pt-2">
              <li class="flex items-center gap-2.5">
                <span class="p-0.5 rounded-full bg-purple-500/20 text-purple-400"><Icon name="check" class="w-3 h-3" /></span>
