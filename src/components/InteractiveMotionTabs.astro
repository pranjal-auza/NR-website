          <!-- Visual Showcase -->
          <div class="lg:col-span-7 rounded-xl bg-secondary-bg/80 border border-subtle-stroke p-4 shadow-attio-3 space-y-3 font-sans">
            <div class="p-4 rounded-xl bg-surface border border-subtle-stroke space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <Icon name="star" class="w-4 h-4 text-amber-400" />
