                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: CRM & PIPELINES -->
      <div id="tab-pipelines" class="motion-tab-content hidden animate-fade-in">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center rounded-2xl enterprise-card p-6 sm:p-10 shadow-attio-5">
          <div class="lg:col-span-5 space-y-5">
            <div class="p-2.5 w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center">
              <Icon name="kanban" class="w-5 h-5" />
            </div>
            <h3 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              Dynamic pipeline built for how modern sales teams close.
