---
import Icon from '../icons/Icon.astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-[#F6F7F8] dark:bg-[#080B10] transition-colors duration-200">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-[#FF4D36]/10 via-[#FF4D36]/5 to-transparent rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Header Text Block -->
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <!-- Lamossa-Style Square Status Pill -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] text-xs font-semibold text-neutral-800 dark:text-neutral-200 shadow-sm font-sans">
        <span class="w-2.5 h-2.5 rounded-sm bg-[#FF4D36]"></span>
        <span>AI Revenue & Omnichannel Platform</span>
        <span class="text-neutral-300 dark:text-neutral-700">|</span>
        <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Open for 14-Day Pilot
        </span>
      </div>

      <!-- Main Lamossa Bold Headline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-[68px] font-extrabold tracking-tight leading-[1.08] text-neutral-950 dark:text-white">
        Uniting conversations, AI technology, and <br class="hidden sm:inline" />
        <span class="text-[#FF4D36]">revenue to deliver growth</span>.
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg md:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl mx-auto font-normal">
        The intelligent operating system that captures WhatsApp leads at 2 AM, resolves customer requests autonomously with Captain AI, and accelerates enterprise pipeline.
      </p>

      <!-- Dual Lamossa-Style CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a href="#demo" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#FF4D36] hover:bg-[#E1443A] text-white font-semibold text-sm sm:text-base shadow-lg shadow-[#FF4D36]/25 transition-all transform hover:-translate-y-0.5 cursor-pointer w-full sm:w-auto">
          <span>Book A Demo</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>

        <a href="#services" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white dark:bg-[#12161F] hover:bg-neutral-100 dark:hover:bg-[#1B212E] text-neutral-900 dark:text-white border border-[#E5E7EB] dark:border-[#222938] font-semibold text-sm sm:text-base shadow-sm transition-all cursor-pointer w-full sm:w-auto">
          <span>Explore Capabilities</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-400">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>
      </div>

      <!-- Trust signals bar -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-neutral-500 dark:text-neutral-400 pt-2 font-mono">
        <span class="flex items-center gap-1.5"><span class="text-[#FF4D36]">✓</span> No credit card required</span>
        <span class="flex items-center gap-1.5"><span class="text-[#FF4D36]">✓</span> 2-minute instant carrier sync</span>
        <span class="flex items-center gap-1.5"><span class="text-[#FF4D36]">✓</span> SOC 2 Type II & HIPAA compliant</span>
      </div>
    </div>

    <!-- Hero Interactive Canvas / Product Showcase -->
    <div class="mt-14 max-w-5xl mx-auto relative">
      
      <!-- Floating Badge 1: Top Left -->
      <div class="hidden md:flex absolute -top-5 -left-6 z-20 items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-white dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] shadow-xl text-xs font-semibold text-neutral-900 dark:text-white">
        <div class="w-8 h-8 rounded-xl bg-[#FF4D36]/10 text-[#FF4D36] flex items-center justify-center font-bold">
          📈
        </div>
        <div>
          <div class="text-[10px] text-neutral-400 uppercase font-mono">Conversion Impact</div>
          <div class="text-sm font-bold text-[#FF4D36]">+142% Inbound Growth</div>
        </div>
      </div>

      <!-- Floating Badge 2: Top Right -->
      <div class="hidden md:flex absolute -top-5 -right-6 z-20 items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-white dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] shadow-xl text-xs font-semibold text-neutral-900 dark:text-white">
        <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">
          ⚡
        </div>
        <div>
          <div class="text-[10px] text-neutral-400 uppercase font-mono">Speed to Lead</div>
          <div class="text-sm font-bold text-emerald-500">&lt; 10s AI Triage</div>
        </div>
      </div>

      <!-- Main Showcase Window -->
      <div class="rounded-3xl bg-white dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] shadow-2xl p-2 sm:p-3 overflow-hidden">
        
        <!-- App Window Header Bar -->
        <div class="flex items-center justify-between px-4 py-3 bg-[#F8F9FA] dark:bg-[#141A26] rounded-2xl border border-[#E5E7EB] dark:border-[#1E2636] text-xs">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
            </div>
            <span class="font-mono text-neutral-400 text-[11px] hidden sm:inline">relay.app/inbox/live-session</span>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FF4D36]/10 text-[#FF4D36] text-[11px] font-semibold font-mono border border-[#FF4D36]/20">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF4D36] animate-ping"></span>
              Captain AI: Autonomous Mode
            </span>
          </div>
        </div>

        <!-- Simulated Software Body -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-0 bg-white dark:bg-[#0A0E17] min-h-[460px] text-sm mt-2 rounded-2xl border border-[#E5E7EB] dark:border-[#1E2636] overflow-hidden">
          
          <!-- Column 1: Threads (4 cols) -->
          <div class="md:col-span-4 border-r border-[#E5E7EB] dark:border-[#1E2636] p-3.5 space-y-2.5 bg-[#FAFAFA] dark:bg-[#0D121D]">
            <div class="flex items-center justify-between pb-2 border-b border-[#E5E7EB] dark:border-[#1E2636] text-xs font-semibold text-neutral-400 font-mono">
              <span>ACTIVE CHANNELS</span>
              <span class="px-2 py-0.5 rounded-full bg-[#FF4D36]/10 text-[#FF4D36] text-[10px]">4 LIVE</span>
            </div>

            <!-- Thread 1: WhatsApp Active -->
            <div class="p-3 rounded-2xl bg-white dark:bg-[#131926] border-2 border-[#FF4D36] shadow-sm cursor-pointer space-y-1.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
                    WA
                  </div>
                  <div>
                    <div class="font-bold text-neutral-900 dark:text-white text-xs">Sarah Jenkins</div>
                    <div class="text-[10px] text-neutral-400">VP Ops @ CloudScale</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-[#FF4D36]">Just now</span>
              </div>
              <p class="text-xs text-neutral-600 dark:text-neutral-300 line-clamp-2">"Can Captain AI integrate with our PostgreSQL tables & enforce SOC2?"</p>
              <div class="flex items-center gap-1.5 pt-1">
                <span class="px-2 py-0.5 rounded-md bg-purple-500/10 text-purple-600 dark:text-purple-400 text-[10px] font-mono font-medium">AI Triaged</span>
                <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono font-bold">$75k Deal</span>
              </div>
            </div>

            <!-- Thread 2: SMS -->
            <div class="p-3 rounded-2xl hover:bg-white/80 dark:hover:bg-[#131926]/50 border border-transparent transition-all cursor-pointer space-y-1">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-blue-500/20 text-blue-500 flex items-center justify-center font-bold text-xs">
                    SMS
                  </div>
                  <div>
                    <div class="font-bold text-neutral-900 dark:text-white text-xs">Marcus Thorne</div>
                    <div class="text-[10px] text-neutral-400">Founder @ Horizon</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-neutral-400">2m ago</span>
              </div>
              <p class="text-xs text-neutral-500 truncate">"Demo booking confirmed for 3pm EST."</p>
            </div>

            <!-- Thread 3: Video Review -->
            <div class="p-3 rounded-2xl hover:bg-white/80 dark:hover:bg-[#131926]/50 border border-transparent transition-all cursor-pointer space-y-1">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-500 flex items-center justify-center font-bold text-xs">
                    VID
                  </div>
                  <div>
                    <div class="font-bold text-neutral-900 dark:text-white text-xs">Elena Rostova</div>
                    <div class="text-[10px] text-neutral-400">CMO @ FinPulse</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-amber-500">5.0 ★</span>
              </div>
              <p class="text-xs text-neutral-500 truncate">"Submitted 60s video testimonial."</p>
            </div>
          </div>

          <!-- Column 2: Live Chat Flow (5 cols) -->
          <div class="md:col-span-5 p-4 flex flex-col justify-between border-r border-[#E5E7EB] dark:border-[#1E2636] bg-white dark:bg-[#0A0E17]">
            <div class="space-y-3.5">
              
              <!-- Customer WhatsApp Message -->
              <div class="flex items-start gap-2.5 max-w-[92%]">
                <div class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-600 flex items-center justify-center text-xs shrink-0 font-bold">
                  SJ
                </div>
                <div class="p-3.5 rounded-2xl rounded-tl-none bg-[#F4F5F7] dark:bg-[#131824] border border-[#E5E7EB] dark:border-[#1E2636] text-xs text-neutral-900 dark:text-white space-y-1">
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">Sarah Jenkins (via WhatsApp)</span>
                    <span class="text-[10px] text-neutral-400 font-mono">02:14 AM</span>
                  </div>
                  <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
                    We manage 120 global reps. Can New-Relay auto-enrich leads, answer pricing FAQs, and create deals in our pipeline without human lag?
                  </p>
                </div>
              </div>

              <!-- Captain AI Autonomous Reply -->
              <div class="flex items-start gap-2.5 max-w-[96%] ml-auto flex-row-reverse">
                <div class="w-7 h-7 rounded-full bg-[#FF4D36] text-white flex items-center justify-center text-xs shrink-0 shadow-md">
                  <Icon name="bot" class="w-4 h-4" />
                </div>
                <div class="p-3.5 rounded-2xl rounded-tr-none bg-[#FF4D36]/10 border border-[#FF4D36]/30 text-xs text-neutral-900 dark:text-white space-y-2.5">
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-bold text-[#FF4D36] flex items-center gap-1">
                      <Icon name="sparkles" class="w-3.5 h-3.5" />
                      Captain AI Autonomous Reply
                    </span>
                    <span class="text-[10px] text-neutral-400 font-mono">Confidence 99.6%</span>
                  </div>
                  <p class="text-neutral-700 dark:text-neutral-200 leading-relaxed">
                    Hello Sarah! Yes, absolutely. Captain AI uses New-Relay's <strong>Universal Context™</strong> to ingest your product docs, qualify leads across WhatsApp/SMS, and automatically route qualified $10k+ opportunities directly into your Sales Pipeline.
                  </p>
                  
                  <div class="p-2.5 rounded-xl bg-white dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] flex items-center justify-between text-[11px] font-mono">
                    <span class="text-neutral-500">Auto-Action Triggered:</span>
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ Created Deal: $75,000 ARR</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Composer Bar -->
            <div class="pt-3 mt-3 border-t border-[#E5E7EB] dark:border-[#1E2636] flex items-center gap-2">
              <div class="flex-1 px-3.5 py-2 rounded-xl bg-[#F8F9FA] dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] text-xs text-neutral-400 flex items-center justify-between">
                <span>Captain AI monitoring live (type '/' for macros)</span>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-white dark:bg-[#1A202C] text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">⌘K</span>
              </div>
              <button class="p-2 rounded-xl bg-[#FF4D36] text-white shadow-md hover:bg-[#E1443A] transition-colors">
                <Icon name="zap" class="w-3.5 h-3.5" />
              </button>
            </div>
          </div>

          <!-- Column 3: Live CRM Card (3 cols) -->
          <div class="md:col-span-3 p-4 bg-[#FAFAFA] dark:bg-[#0D121D] space-y-3">
            <div class="text-xs font-semibold text-neutral-400 uppercase tracking-wider font-mono">
              Customer 360 Context™
            </div>

            <div class="p-3.5 rounded-2xl bg-white dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] space-y-2.5 shadow-sm">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-[#FF4D36]/10 text-[#FF4D36] flex items-center justify-center font-bold text-xs">
                  CS
                </div>
                <div>
                  <div class="text-xs font-bold text-neutral-900 dark:text-white">CloudScale Bio</div>
                  <div class="text-[10px] text-neutral-400">Series B • 120 Employees</div>
                </div>
              </div>

              <div class="pt-2 border-t border-[#E5E7EB] dark:border-[#222938] space-y-1.5 text-[11px]">
                <div class="flex justify-between">
                  <span class="text-neutral-400">Pipeline Stage:</span>
                  <span class="font-bold text-[#FF4D36]">Demo Scheduled</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-neutral-400">Deal Value:</span>
                  <span class="font-bold text-neutral-900 dark:text-white font-mono">$75,000 / yr</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-neutral-400">Security Review:</span>
                  <span class="text-emerald-500 font-mono font-medium">SOC 2 In Review ✓</span>
                </div>
              </div>
            </div>

            <!-- Quick Triggers -->
            <div class="p-3.5 rounded-2xl bg-white dark:bg-[#12161F] border border-[#E5E7EB] dark:border-[#222938] space-y-2 shadow-sm">
              <div class="text-[10px] font-semibold text-neutral-400 uppercase font-mono">One-Click Actions</div>
              <button class="w-full text-left px-2.5 py-1.5 rounded-lg bg-[#F8F9FA] dark:bg-[#161D2B] hover:bg-[#FF4D36]/10 text-[11px] font-medium text-neutral-700 dark:text-neutral-300 transition-colors flex items-center justify-between">
                <span>Send WhatsApp Video Ask</span>
                <span class="text-[#FF4D36]">→</span>
              </button>
              <button class="w-full text-left px-2.5 py-1.5 rounded-lg bg-[#F8F9FA] dark:bg-[#161D2B] hover:bg-[#FF4D36]/10 text-[11px] font-medium text-neutral-700 dark:text-neutral-300 transition-colors flex items-center justify-between">
                <span>Push to Salesforce Sync</span>
                <span class="text-[#FF4D36]">→</span>
              </button>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Client Logo Strip -->
    <div class="mt-16 pt-8 border-t border-[#E5E7EB] dark:border-[#1E2636] text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-6 font-mono">
        Trusted by 1,200+ fast-growing modern revenue teams and founders
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="font-display font-bold text-lg tracking-tight text-neutral-800 dark:text-white">LINEAR</span>
        <span class="font-display font-bold text-lg tracking-tight text-neutral-800 dark:text-white">MODAL</span>
        <span class="font-display font-bold text-lg tracking-tight text-neutral-800 dark:text-white">GRANOLA</span>
        <span class="font-display font-bold text-lg tracking-tight text-neutral-800 dark:text-white">RAILWAY</span>
        <span class="font-display font-bold text-lg tracking-tight text-neutral-800 dark:text-white">TASKRABBIT</span>
        <span class="font-display font-bold text-lg tracking-tight text-neutral-800 dark:text-white">STRIPE</span>
      </div>
    </div>

  </div>
</section>
