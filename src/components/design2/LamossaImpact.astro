---
import Icon from '../icons/Icon.astro';
---

<section class="py-20 border-t border-[#E5E7EB] dark:border-[#1E2636] bg-white dark:bg-[#0A0E17] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="p-8 sm:p-12 rounded-3xl bg-[#F6F7F8] dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] shadow-sm">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center divide-y lg:divide-y-0 lg:divide-x divide-[#E5E7EB] dark:divide-[#1E2636]">
        
        <!-- Metric 1 -->
        <div class="space-y-2 pt-4 lg:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight font-mono">
            +142%
          </div>
          <div class="text-sm font-bold text-[#FF4D36]">Inbound Conversion</div>
          <div class="text-xs text-neutral-500 font-mono">WhatsApp & SMS lead triage</div>
        </div>

        <!-- Metric 2 -->
        <div class="space-y-2 pt-4 lg:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight font-mono">
            &lt; 10s
          </div>
          <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">Speed to Lead</div>
          <div class="text-xs text-neutral-500 font-mono">Down from 45 minutes</div>
        </div>

        <!-- Metric 3 -->
        <div class="space-y-2 pt-4 lg:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight font-mono">
            $1.4B+
          </div>
          <div class="text-sm font-bold text-purple-600 dark:text-purple-400">Pipeline Influenced</div>
          <div class="text-xs text-neutral-500 font-mono">Attributed across deal stages</div>
        </div>

        <!-- Metric 4 -->
        <div class="space-y-2 pt-4 lg:pt-0">
          <div class="font-display text-4xl sm:text-5xl font-extrabold text-neutral-950 dark:text-white tracking-tight font-mono">
            99.99%
          </div>
          <div class="text-sm font-bold text-amber-500">Carrier SLA Uptime</div>
          <div class="text-xs text-neutral-500 font-mono">Multi-region fallback network</div>
        </div>

      </div>
    </div>

  </div>
</section>
