---
import Icon from '../icons/Icon.astro';
---

<section id="process" class="py-24 border-t border-[#E5E7EB] dark:border-[#1E2636] bg-[#F6F7F8] dark:bg-[#080B10] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header in Lamossa Style -->
    <div class="max-w-3xl space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FF4D36]/10 text-[#FF4D36] text-xs font-semibold uppercase tracking-wider font-mono">
        <span class="w-1.5 h-1.5 rounded-sm bg-[#FF4D36]"></span>
        <span>Workflow & Process</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
        Simple 4-step deployment. <br />
        <span class="text-[#FF4D36]">Live in under 2 hours.</span>
      </h2>

      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base leading-relaxed">
        We engineered New-Relay to be friction-free. Zero lengthy engineering cycles or complex custom code required.
      </p>
    </div>

    <!-- 4-Step Process Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      
      <!-- Step 01 -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] space-y-4 hover:border-[#FF4D36]/40 transition-all shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FF4D36]/10 text-[#FF4D36] font-mono font-bold text-base flex items-center justify-center border border-[#FF4D36]/20">
            01
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white">Carrier & Channel Sync</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Connect official WhatsApp Business numbers, 2-way SMS lines, and team email inboxes with our 1-click wizard.
          </p>
        </div>
        <div class="pt-3 border-t border-[#E5E7EB] dark:border-[#1E2636] text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
          ✓ 2-Minute Setup
        </div>
      </div>

      <!-- Step 02 -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] space-y-4 hover:border-[#FF4D36]/40 transition-all shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FF4D36]/10 text-[#FF4D36] font-mono font-bold text-base flex items-center justify-center border border-[#FF4D36]/20">
            02
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white">Knowledge Ingestion</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Upload product documentation, pricing sheets, and refund SLAs. Captain AI learns your policies with Zero Data Retention.
          </p>
        </div>
        <div class="pt-3 border-t border-[#E5E7EB] dark:border-[#1E2636] text-[11px] font-mono text-purple-600 dark:text-purple-400">
          ✓ RAG Vector Vectorized
        </div>
      </div>

      <!-- Step 03 -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] space-y-4 hover:border-[#FF4D36]/40 transition-all shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FF4D36]/10 text-[#FF4D36] font-mono font-bold text-base flex items-center justify-center border border-[#FF4D36]/20">
            03
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white">Guardrail Sandbox</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Test simulated edge-case queries in our interactive simulator. Set deterministic confidence gates before going live.
          </p>
        </div>
        <div class="pt-3 border-t border-[#E5E7EB] dark:border-[#1E2636] text-[11px] font-mono text-[#FF4D36]">
          ✓ 99.6% Accuracy Check
        </div>
      </div>

      <!-- Step 04 -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] space-y-4 hover:border-[#FF4D36]/40 transition-all shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FF4D36]/10 text-[#FF4D36] font-mono font-bold text-base flex items-center justify-center border border-[#FF4D36]/20">
            04
          </div>
          <h3 class="text-lg font-bold text-neutral-950 dark:text-white">Autonomous Scale</h3>
          <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Captain AI handles 70%+ of customer inquiries 24/7, routes high-value deals to reps, and automatically collects 60s video reviews.
          </p>
        </div>
        <div class="pt-3 border-t border-[#E5E7EB] dark:border-[#1E2636] text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
          ✓ Continuous Revenue Growth
        </div>
      </div>

    </div>

  </div>
</section>
