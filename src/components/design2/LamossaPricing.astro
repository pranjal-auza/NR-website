---
import Icon from '../icons/Icon.astro';
---

<section id="pricing" class="py-24 border-t border-[#E5E7EB] dark:border-[#1E2636] bg-[#F6F7F8] dark:bg-[#080B10] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header in Lamossa Style -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FF4D36]/10 text-[#FF4D36] text-xs font-semibold uppercase tracking-wider font-mono">
        <span class="w-1.5 h-1.5 rounded-sm bg-[#FF4D36]"></span>
        <span>Pricing & Plans</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
        Predictable plans. <br />
        <span class="text-[#FF4D36]">Scale as your revenue grows.</span>
      </h2>

      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base leading-relaxed">
        Start free for 14 days. No credit card required. Upgrade when you're ready to deploy autonomous AI agents.
      </p>

      <!-- Billing Period Switcher -->
      <div class="flex items-center justify-center gap-3 pt-4">
        <span id="lamossa-monthly-label" class="text-sm font-medium text-neutral-500">Monthly</span>
        <button id="lamossa-billing-toggle" aria-label="Toggle annual billing" class="relative w-12 h-6 rounded-full bg-neutral-200 dark:bg-neutral-800 border border-[#E5E7EB] dark:border-[#222938] p-0.5 transition-colors cursor-pointer">
          <span id="lamossa-toggle-thumb" class="block w-5 h-5 rounded-full bg-[#FF4D36] shadow-md transition-transform duration-200"></span>
        </button>
        <span id="lamossa-annual-label" class="text-sm font-medium text-neutral-950 dark:text-white flex items-center gap-1.5 font-mono">
          <span>Annual</span>
          <span class="px-2 py-0.5 rounded-full bg-[#FF4D36]/10 text-[#FF4D36] text-xs font-bold border border-[#FF4D36]/20">Save 20%</span>
        </span>
      </div>
    </div>

    <!-- 3 Tier Cards in Lamossa Style -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      
      <!-- Tier 1: Starter -->
      <div class="p-8 rounded-3xl bg-white dark:bg-[#0E131C] border border-[#E5E7EB] dark:border-[#1E2636] shadow-sm flex flex-col justify-between space-y-6 hover:border-neutral-300 transition-all">
        <div class="space-y-4">
          <div>
            <span class="text-xs font-mono font-bold text-neutral-400 uppercase">PLAN 01</span>
            <h3 class="text-2xl font-bold text-neutral-950 dark:text-white mt-1">Starter</h3>
            <p class="text-xs text-neutral-500 mt-1">For founders establishing omnichannel customer workflows.</p>
          </div>

          <div class="pt-2">
            <span class="lamossa-price-val text-4xl font-display font-extrabold text-neutral-950 dark:text-white font-mono" data-monthly="39" data-annual="29">$29</span>
            <span class="text-xs text-neutral-400">/ seat / mo</span>
          </div>

          <a href="#demo" class="inline-flex items-center justify-center w-full py-3 rounded-full bg-[#F6F7F8] dark:bg-[#161D2B] hover:bg-neutral-200 dark:hover:bg-[#1F293D] text-neutral-900 dark:text-white font-semibold text-sm transition-all border border-[#E5E7EB] dark:border-[#222938]">
            Start 14-Day Free Trial
          </a>

          <div class="pt-4 border-t border-[#E5E7EB] dark:border-[#1E2636] space-y-2.5 text-xs text-neutral-700 dark:text-neutral-300">
            <div class="font-bold text-neutral-400 uppercase tracking-wider text-[10px] font-mono">Features Included:</div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Unified Inbox (WhatsApp, SMS & Email)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Basic Deal Pipelines (Kanban)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>500 Captain AI automated resolutions / mo</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Video Review outreach widget</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tier 2: Growth Pro (Highlighted with Coral Red) -->
      <div class="p-8 rounded-3xl bg-white dark:bg-[#0E131C] border-2 border-[#FF4D36] shadow-xl relative flex flex-col justify-between space-y-6 scale-105 z-10">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-[#FF4D36] text-white font-bold text-xs shadow-md font-mono">
          MOST POPULAR
        </div>

        <div class="space-y-4">
          <div>
            <span class="text-xs font-mono font-bold text-[#FF4D36] uppercase">PLAN 02</span>
            <h3 class="text-2xl font-bold text-neutral-950 dark:text-white mt-1">Growth Pro</h3>
            <p class="text-xs text-neutral-500 mt-1">For scaling revenue teams that want full AI autonomy.</p>
          </div>

          <div class="pt-2">
            <span class="lamossa-price-val text-4xl font-display font-extrabold text-neutral-950 dark:text-white font-mono" data-monthly="79" data-annual="59">$59</span>
            <span class="text-xs text-neutral-400">/ seat / mo</span>
          </div>

          <a href="#demo" class="inline-flex items-center justify-center w-full py-3.5 rounded-full bg-[#FF4D36] hover:bg-[#E1443A] text-white font-bold text-sm shadow-lg shadow-[#FF4D36]/25 transition-all transform hover:-translate-y-0.5">
            Start 14-Day Free Trial
          </a>

          <div class="pt-4 border-t border-[#E5E7EB] dark:border-[#1E2636] space-y-2.5 text-xs text-neutral-700 dark:text-neutral-300">
            <div class="font-bold text-neutral-400 uppercase tracking-wider text-[10px] font-mono">Everything in Starter, plus:</div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Unlimited Captain AI automated triage</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>AI Copilot real-time draft suggestions</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Multi-channel sequence & autoresponder</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Full REST API, Webhooks & TypeScript SDK</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tier 3: Enterprise Scale -->
      <div class="p-8 rounded-3xl bg-[#111622] text-white border border-[#222B3D] shadow-xl flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div>
            <span class="text-xs font-mono font-bold text-[#FF4D36] uppercase">PLAN 03</span>
            <h3 class="text-2xl font-bold text-white mt-1">Enterprise</h3>
            <p class="text-xs text-neutral-400 mt-1">For global organizations requiring custom RAG models and dedicated SLAs.</p>
          </div>

          <div class="pt-2">
            <span class="text-4xl font-display font-extrabold text-white font-mono">Custom</span>
            <span class="text-xs text-neutral-400">/ volume license</span>
          </div>

          <a href="#demo" class="inline-flex items-center justify-center w-full py-3 rounded-full bg-white hover:bg-neutral-100 text-neutral-950 font-bold text-sm transition-all shadow-md">
            Talk to Enterprise Sales
          </a>

          <div class="pt-4 border-t border-[#222B3D] space-y-2.5 text-xs text-neutral-300">
            <div class="font-bold text-neutral-400 uppercase tracking-wider text-[10px] font-mono">Enterprise Inclusions:</div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Dedicated Account Manager & 99.99% SLA</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>Custom RAG vector models & private VPC</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[#FF4D36]">✓</span>
              <span>SOC 2 Type II, HIPAA & GDPR enterprise MSA</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const lamossaToggle = document.getElementById('lamossa-billing-toggle');
  const lamossaThumb = document.getElementById('lamossa-toggle-thumb');
  const lamossaPrices = document.querySelectorAll<HTMLElement>('.lamossa-price-val');
  const lamossaMonthly = document.getElementById('lamossa-monthly-label');
  const lamossaAnnual = document.getElementById('lamossa-annual-label');

  let isLamossaAnnual = true;

  if (lamossaToggle && lamossaThumb) {
    lamossaToggle.addEventListener('click', () => {
      isLamossaAnnual = !isLamossaAnnual;
      
      if (isLamossaAnnual) {
        lamossaThumb.classList.remove('translate-x-0');
        lamossaThumb.classList.add('translate-x-6');
        if (lamossaMonthly) lamossaMonthly.className = 'text-sm font-medium text-neutral-500';
        if (lamossaAnnual) lamossaAnnual.className = 'text-sm font-medium text-neutral-950 dark:text-white flex items-center gap-1.5 font-mono';
      } else {
        lamossaThumb.classList.remove('translate-x-6');
        lamossaThumb.classList.add('translate-x-0');
        if (lamossaMonthly) lamossaMonthly.className = 'text-sm font-medium text-neutral-950 dark:text-white';
        if (lamossaAnnual) lamossaAnnual.className = 'text-sm font-medium text-neutral-500 flex items-center gap-1.5 font-mono';
      }

      lamossaPrices.forEach(p => {
        const amt = isLamossaAnnual ? p.getAttribute('data-annual') : p.getAttribute('data-monthly');
        p.textContent = `$${amt}`;
      });
    });

    lamossaThumb.classList.add('translate-x-6');
  }
</script>
