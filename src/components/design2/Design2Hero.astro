---
import Icon from '../icons/Icon.astro';
---

<section class="relative pt-12 pb-24 md:pt-20 md:pb-32 overflow-hidden bg-background">
  <!-- Glowing Ambient Mesh Background -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[650px] bg-gradient-to-b from-indigo-500/20 via-purple-500/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-40 right-10 w-96 h-96 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Header -->
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <!-- Design Concept Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gradient-to-r from-purple-500/20 to-indigo-500/20 border border-purple-500/30 text-xs font-semibold text-purple-300 shadow-attio-2 font-mono">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        <span>CONCEPT 2: KINETIC COMMAND CENTER</span>
        <span class="text-purple-400/50">|</span>
        <span class="text-foreground">Interactive AI Engine</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-[70px] font-extrabold tracking-tight leading-[1.06] text-foreground">
        The Autonomous <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">Revenue Command Center</span>.
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg md:text-xl text-secondary-fg leading-relaxed max-w-2xl mx-auto font-normal">
        Test-drive Captain AI live. Ingest customer inquiries at 2 AM, auto-qualify five-figure deals, and execute multi-channel sequences with zero human latency.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a href="#demo" class="button-primary text-base px-8 py-3.5 rounded-xl shadow-attio-4 w-full sm:w-auto font-semibold bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500">
          <span>Deploy Captain AI Free</span>
          <Icon name="arrow-right" class="w-4 h-4 ml-2" />
        </a>

        <a href="#calculator" class="button-outline text-base px-8 py-3.5 rounded-xl w-full sm:w-auto font-medium flex items-center justify-center gap-2">
          <Icon name="activity" class="w-4 h-4 text-purple-400" />
          <span>Calculate Team ROI</span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-caption-fg pt-2 font-mono">
        <span class="flex items-center gap-1.5 text-foreground"><Icon name="shield" class="w-3.5 h-3.5 text-emerald-400" /> SOC 2 Type II Audited</span>
        <span class="flex items-center gap-1.5 text-foreground"><Icon name="activity" class="w-3.5 h-3.5 text-emerald-400" /> 12ms Execution Latency</span>
        <span class="flex items-center gap-1.5 text-foreground"><Icon name="database" class="w-3.5 h-3.5 text-emerald-400" /> Zero LLM Data Retention</span>
      </div>
    </div>

    <!-- Interactive Live AI Terminal Sandbox -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="rounded-2xl border border-indigo-500/30 bg-gray-950/90 shadow-2xl overflow-hidden backdrop-blur-2xl">
        
        <!-- Terminal Header Bar -->
        <div class="flex items-center justify-between px-4 py-3 bg-gray-900/90 border-b border-indigo-500/20 text-xs">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            </div>
            <span class="font-mono text-gray-400 text-[11px] hidden sm:inline">captain-ai-sandbox.live // v2.4-engine</span>
          </div>

          <div class="flex items-center gap-3 font-mono text-[11px]">
            <span class="text-emerald-400 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              RAG VECTORS LOADED (520k chunks)
            </span>
            <span class="px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
              Confidence: 99.8%
            </span>
          </div>
        </div>

        <!-- Terminal Interactive Controls Bar -->
        <div class="p-3.5 bg-gray-900/50 border-b border-indigo-500/15 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-gray-400 font-mono text-[11px] mr-1">Select Live Scenario:</span>
          
          <button class="sandbox-preset active px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-mono text-[11px] transition-all hover:brightness-110" data-scenario="lead">
            ⚡ 2AM WhatsApp Enterprise Lead ($75k)
          </button>
          
          <button class="sandbox-preset px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-300 font-mono text-[11px] transition-all" data-scenario="security">
            🔒 SOC 2 & HIPAA Guardrail Check
          </button>
          
          <button class="sandbox-preset px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-300 font-mono text-[11px] transition-all" data-scenario="pricing">
            📊 100-Seat Pricing Breakdown
          </button>
        </div>

        <!-- Terminal Live Execution Stream -->
        <div class="p-5 font-mono text-xs sm:text-[13px] space-y-4 min-h-[300px] bg-gray-950/95 text-gray-300">
          
          <!-- Inbound Event -->
          <div class="p-3.5 rounded-xl bg-gray-900/80 border border-gray-800 space-y-1">
            <div class="flex items-center justify-between text-gray-400 text-[11px]">
              <span class="text-emerald-400 font-bold flex items-center gap-1.5">
                <span>[INBOUND EVENT]</span>
                <span class="text-gray-300">WhatsApp Business API (+1 415-890-2341)</span>
              </span>
              <span>02:14:19 AM EST</span>
            </div>
            <div id="sandbox-inbound-text" class="text-white text-xs sm:text-sm font-sans pt-1">
              "Hi! We are evaluating New-Relay for our 140 sales reps. Can Captain AI auto-enrich inbound leads, enforce SOC 2 Type II compliance, and create deals in Salesforce automatically?"
            </div>
          </div>

          <!-- Captain AI Real-Time Inference Stream -->
          <div class="p-4 rounded-xl bg-indigo-950/30 border border-indigo-500/30 space-y-3">
            <div class="flex items-center justify-between text-[11px] text-indigo-300">
              <span class="flex items-center gap-2 font-bold">
                <Icon name="sparkles" class="w-3.5 h-3.5 text-indigo-400" />
                <span>CAPTAIN AI AUTONOMOUS RESOLVER</span>
              </span>
              <span class="text-emerald-400">Latency: 14ms • Guardrail: VERIFIED ✓</span>
            </div>

            <div id="sandbox-response-text" class="text-gray-200 text-xs sm:text-sm font-sans leading-relaxed">
              Hello! Yes, absolutely. Captain AI handles all three seamlessly:
              <br/><br/>
              1. <strong>Autonomous Enrichment:</strong> Leads are instantly verified using company domain & revenue signals.<br/>
              2. <strong>SOC 2 Type II Enforced:</strong> Operates under strict Zero Data Retention policies with AES-256 encryption.<br/>
              3. <strong>Bi-Directional CRM Sync:</strong> Creates structured opportunities directly in Salesforce & HubSpot with automatic ARR attribution.
            </div>

            <!-- Auto-Actions Triggered -->
            <div class="pt-2 border-t border-indigo-500/20 flex flex-wrap items-center justify-between gap-2 text-[11px]">
              <div class="flex items-center gap-2 text-gray-400">
                <span>Auto-Actions:</span>
                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">✓ Deal Created ($75,000 ARR)</span>
                <span class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">✓ Rep Sarah M. Alerted</span>
              </div>
              <span class="text-indigo-400 font-bold">Resolution Status: COMPLETED</span>
            </div>
          </div>

        </div>

        <!-- Terminal Footer -->
        <div class="px-4 py-2.5 bg-gray-900 border-t border-gray-800 flex items-center justify-between text-xs text-gray-500 font-mono">
          <span>Simulation Mode • Universal Context Engine Active</span>
          <span class="text-indigo-400">Click presets above to run different workflows</span>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const presets = document.querySelectorAll<HTMLButtonElement>('.sandbox-preset');
  const inboundText = document.getElementById('sandbox-inbound-text');
  const responseText = document.getElementById('sandbox-response-text');

  const scenarios: Record<string, { inbound: string; response: string }> = {
    lead: {
      inbound: '"Hi! We are evaluating New-Relay for our 140 sales reps. Can Captain AI auto-enrich inbound leads, enforce SOC 2 Type II compliance, and create deals in Salesforce automatically?"',
      response: 'Hello! Yes, absolutely. Captain AI handles all three seamlessly:\n\n1. Autonomous Enrichment: Leads are instantly verified using company domain & revenue signals.\n2. SOC 2 Type II Enforced: Operates under strict Zero Data Retention policies with AES-256 encryption.\n3. Bi-Directional CRM Sync: Creates structured opportunities directly in Salesforce & HubSpot with automatic ARR attribution.'
    },
    security: {
      inbound: '"Does New-Relay store our customer WhatsApp messages for model training? We require HIPAA BAA and single-tenant VPC."',
      response: 'Security Policy Confirmation:\n\n• Zero LLM Data Retention: Customer transcripts and prompts are never stored or used to train third-party foundation models.\n• HIPAA & SOC 2 Type II: Business Associate Agreements (BAA) signed with full audit logging.\n• Private VPC: Single-tenant deployment available in AWS us-east-1 with Bring-Your-Own-Key (BYOK) AES-256 encryption.'
    },
    pricing: {
      inbound: '"What is the total annual cost for 100 enterprise seats with dedicated WhatsApp phone numbers and SLA guarantees?"',
      response: 'Enterprise Plan Quotation Breakdown:\n\n• 100 Seats on Scale Plan: $59 / seat / mo ($70,800 annually)\n• Dedicated WhatsApp Numbers: 10 Included with multi-carrier failover\n• 99.99% Carrier SLA & 24/7 Phone Support: Included\n• Estimated Annual ROI Savings vs Legacy Stacks: $38,400 / year'
    }
  };

  presets.forEach(btn => {
    btn.addEventListener('click', () => {
      presets.forEach(b => {
        b.className = 'sandbox-preset px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-300 font-mono text-[11px] transition-all';
      });
      btn.className = 'sandbox-preset active px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-mono text-[11px] transition-all hover:brightness-110';

      const scenarioKey = btn.getAttribute('data-scenario') || 'lead';
      const data = scenarios[scenarioKey];
      if (inboundText && responseText && data) {
        inboundText.textContent = data.inbound;
        responseText.innerHTML = data.response.replace(/\n/g, '<br/>');
      }
    });
  });
</script>
