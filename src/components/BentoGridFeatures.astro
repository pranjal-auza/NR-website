---
import Icon from './icons/Icon.astro';
---

<section class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider border border-emerald-500/20 font-mono">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>Enterprise Engineering</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        Every detail crafted for extreme speed.
      </h2>

      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        From keyboard-first shortcuts to collision locking, New-Relay gives your team superpowers across every customer touchpoint.
      </p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 max-w-6xl mx-auto">
      
      <!-- Bento 1: AI Copilot (8 cols) -->
      <div class="md:col-span-8 p-6 sm:p-8 rounded-2xl enterprise-card flex flex-col justify-between space-y-6 hover:border-brand-500/40 transition-all">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="p-2 rounded-lg bg-brand-500/10 text-brand-400 border border-brand-500/20">
              <Icon name="bot" class="w-4 h-4" />
            </span>
            <span class="text-[11px] font-mono text-caption-fg px-2.5 py-1 rounded-md bg-surface-subtle border border-subtle-stroke">
              Keyboard Shortcut: ⌘J
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-foreground">AI Copilot Real-Time Draft Assistant</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed max-w-xl">
            Human reps close deals 3x faster with AI-generated replies tuned to your corporate tone. Copilot automatically drafts accurate technical answers and quote breakdowns for rep 1-click approval.
          </p>
        </div>

        <!-- Visual UI Snippet -->
        <div class="rounded-xl bg-secondary-bg/90 border border-subtle-stroke p-3.5 space-y-2.5 text-xs font-sans">
          <div class="text-[11px] text-caption-fg font-mono">Suggested Copilot Draft (1-click insert):</div>
          <div class="p-3 rounded-lg bg-brand-500/10 border border-brand-500/30 text-foreground text-xs leading-relaxed">
            "Hi David, our Scale tier includes 10 dedicated WhatsApp Business numbers, SOC 2 Type II security documentation, and custom RAG scenarios. I've reserved a 15-minute onboarding slot for you tomorrow at 2 PM EST."
          </div>
          <div class="flex items-center justify-between pt-1">
            <span class="text-[10px] text-emerald-400 font-mono">Tone: Confident & Executive • Confidence 99.4%</span>
            <button class="px-3 py-1.5 rounded-lg bg-brand-500 text-white font-medium text-xs shadow-attio-2 hover:brightness-110 transition-all">
              Apply Suggestion (Tab)
            </button>
          </div>
        </div>
      </div>

      <!-- Bento 2: Video Testimonial Collector (4 cols) -->
      <div class="md:col-span-4 p-6 sm:p-8 rounded-2xl enterprise-card flex flex-col justify-between space-y-6 hover:border-amber-500/40 transition-all">
        <div class="space-y-3">
          <span class="p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 inline-block">
            <Icon name="video" class="w-4 h-4" />
          </span>
          <h3 class="text-xl font-bold text-foreground">Video Social Proof</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Collect authentic 60-second customer video reviews with zero app downloads or logins.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 space-y-2 text-xs text-center">
          <div class="text-amber-400 font-bold text-sm font-mono">4.9 ★ Rating Score</div>
          <div class="text-[11px] text-secondary-fg">Automated post-purchase review request triggered via SMS & WhatsApp</div>
        </div>
      </div>

      <!-- Bento 3: Directory Listings Sync (4 cols) -->
      <div class="md:col-span-4 p-6 sm:p-8 rounded-2xl enterprise-card flex flex-col justify-between space-y-6 hover:border-emerald-500/40 transition-all">
        <div class="space-y-3">
          <span class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block">
            <Icon name="globe" class="w-4 h-4" />
          </span>
          <h3 class="text-xl font-bold text-foreground">Directory Sync</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Sync company hours, locations, and reviews across Google Business, Yelp, Facebook, and Bing in 1 click.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-surface border border-subtle-stroke space-y-2 text-[11px] font-mono">
          <div class="flex justify-between text-caption-fg">
            <span>Google Business:</span>
            <span class="text-emerald-400 font-semibold">100% Synced</span>
          </div>
          <div class="flex justify-between text-caption-fg">
            <span>Yelp Directory:</span>
            <span class="text-emerald-400 font-semibold">100% Synced</span>
          </div>
          <div class="flex justify-between text-caption-fg">
            <span>Facebook Page:</span>
            <span class="text-emerald-400 font-semibold">100% Synced</span>
          </div>
        </div>
      </div>

      <!-- Bento 4: Collision Locking & Round-Robin (8 cols) -->
      <div class="md:col-span-8 p-6 sm:p-8 rounded-2xl enterprise-card flex flex-col justify-between space-y-6 hover:border-blue-500/40 transition-all">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="p-2 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20">
              <Icon name="users" class="w-4 h-4" />
            </span>
            <span class="text-[11px] font-mono text-caption-fg px-2.5 py-1 rounded-md bg-surface-subtle border border-subtle-stroke">
              Zero Duplication Guard
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-foreground">Collision Locking & Round-Robin Routing</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed max-w-xl">
            See who is currently typing in real time. Automatically assign leads based on rep availability, deal tier, customer geography, or language proficiency.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-sans">
          <div class="p-3.5 rounded-xl bg-surface border border-subtle-stroke flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
            <div>
              <div class="font-bold text-foreground text-xs">Alex R. is viewing this thread</div>
              <div class="text-[10px] text-caption-fg font-mono">Auto-locked to prevent duplicate replies</div>
            </div>
          </div>
          <div class="p-3.5 rounded-xl bg-surface border border-subtle-stroke flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-400"></span>
            <div>
              <div class="font-bold text-foreground text-xs">Round-Robin Assignment</div>
              <div class="text-[10px] text-caption-fg font-mono">Auto-routed 18 leads equally today</div>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
