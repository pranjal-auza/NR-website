---
// Platform / Unified Inbox Section — FULL-WIDTH PRODUCT-LED COMPOSITION
---

<section id="inbox" class="py-20 md:py-32 bg-[#FCFCFA] border-b border-[#E9E9EF]/60 relative overflow-hidden">
  <!-- Subtle Soft Blue Atmospheric Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-[#EEF5FF]/70 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Centered Editorial Statement -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EEF5FF] border border-[#D0E2FF] text-xs font-bold tracking-wider text-[#0066FF] uppercase mb-4">
        <span>The Unified Workspace</span>
      </div>

      <h2 class="text-4xl sm:text-6xl font-extrabold text-[#17172A] tracking-[-0.04em] leading-[1.02] font-['Plus_Jakarta_Sans']">
        Every conversation. <br />
        <span class="text-[#635BFF]">Finally in sync.</span>
      </h2>

      <p class="text-base sm:text-lg text-[#656579] leading-relaxed mt-5 max-w-2xl mx-auto">
        No more tab chaos or fragmented context. Unify WhatsApp, Instagram, Email, Live Chat, and SMS into one lightning-fast command center built for modern teams.
      </p>

      <div class="mt-6 flex items-center justify-center gap-4">
        <a href="#demo" class="btn-dark">
          <span>Explore unified inbox</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 2. FULL-WIDTH PRODUCT UI (Software Mockup) -->
    <div class="product-surface overflow-hidden border border-[#E9E9EF] bg-white rounded-[20px] sm:rounded-[24px] shadow-[0_20px_60px_rgba(30,30,60,0.08)]">
      
      <!-- Top Window Command Bar -->
      <div class="h-12 bg-[#F8F8FA] border-b border-[#E9E9EF] px-4 sm:px-6 flex items-center justify-between">
        <!-- Mac Window Dots -->
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E]/50"></div>
          <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]/50"></div>
          <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29]/50"></div>
          <span class="ml-3 text-xs font-bold text-[#17172A] hidden sm:inline-block">NewRelay Workspace</span>
        </div>

        <!-- Center Search / Cmd+K Pill -->
        <div class="hidden md:flex items-center gap-2 px-3 py-1 bg-white border border-[#E5E5EA] rounded-lg text-xs text-[#656579] w-72 shadow-xs">
          <svg class="w-3.5 h-3.5 text-[#9696A8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <span class="text-[11px]">Search conversations or actions...</span>
          <span class="ml-auto text-[10px] bg-[#F4F4F6] px-1.5 py-0.5 rounded font-mono text-[#9696A8]">⌘K</span>
        </div>

        <!-- Live Sync Status -->
        <div class="flex items-center gap-2 text-xs font-medium text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200/60">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[11px] font-semibold">6 channels synced</span>
        </div>
      </div>

      <!-- Main 3-Column Software Interface -->
      <div class="grid grid-cols-12 min-h-[520px] text-xs">
        
        <!-- Column 1: Left Navigation & Channel Filters (3 cols on lg, 2.5 on xl) -->
        <div class="hidden md:flex md:col-span-3 lg:col-span-2.5 bg-[#FCFCFA] border-r border-[#E9E9EF] p-4 flex-col justify-between">
          <div class="space-y-5">
            
            <!-- Quick Views -->
            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-[#9696A8] px-2 mb-2">Views</div>
              <div class="space-y-0.5">
                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-[#635BFF]/10 text-[#635BFF] font-semibold cursor-pointer">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <span>All Inboxes</span>
                  </div>
                  <span class="text-[10px] bg-[#635BFF] text-white px-1.5 py-0.2 rounded-full font-bold">14</span>
                </div>

                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[#656579] hover:bg-[#F0F0F4] font-medium cursor-pointer transition-colors">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/></svg>
                    <span>Assigned to Me</span>
                  </div>
                  <span class="text-[10px] text-[#9696A8]">3</span>
                </div>

                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[#656579] hover:bg-[#F0F0F4] font-medium cursor-pointer transition-colors">
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span>VIP & High Intent</span>
                  </div>
                  <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.2 rounded-full font-bold">5</span>
                </div>
              </div>
            </div>

            <!-- Connected Channels Breakdown -->
            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-[#9696A8] px-2 mb-2">Channels</div>
              <div class="space-y-0.5">
                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[#17172A] hover:bg-[#F0F0F4] font-medium cursor-pointer transition-colors">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
                    <span>WhatsApp</span>
                  </div>
                  <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">8</span>
                </div>

                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[#17172A] hover:bg-[#F0F0F4] font-medium cursor-pointer transition-colors">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#FD1D1D]"></span>
                    <span>Instagram DMs</span>
                  </div>
                  <span class="text-[10px] font-bold text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded">3</span>
                </div>

                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[#17172A] hover:bg-[#F0F0F4] font-medium cursor-pointer transition-colors">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#0066FF]"></span>
                    <span>Email Support</span>
                  </div>
                  <span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">2</span>
                </div>

                <div class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-[#17172A] hover:bg-[#F0F0F4] font-medium cursor-pointer transition-colors">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#FFB800]"></span>
                    <span>Reviews & Calls</span>
                  </div>
                  <span class="text-[10px] text-[#9696A8]">1</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Team Presence Footer -->
          <div class="pt-4 border-t border-[#E9E9EF] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="relative">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80&auto=format&fit=crop&q=80" alt="Avatar" class="w-6 h-6 rounded-full object-cover" />
                <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 border border-white"></span>
              </div>
              <span class="text-[11px] font-semibold text-[#17172A]">Priya (You)</span>
            </div>
            <span class="text-[10px] bg-emerald-100 text-emerald-800 font-semibold px-1.5 py-0.5 rounded">Active</span>
          </div>

        </div>

        <!-- Column 2: Conversation Stream / Triage List (4 cols) -->
        <div class="col-span-12 sm:col-span-5 md:col-span-4 lg:col-span-4 border-r border-[#E9E9EF] p-3 sm:p-4 bg-white flex flex-col justify-between">
          <div>
            <!-- Header with Search & Filter -->
            <div class="flex items-center justify-between mb-3">
              <span class="font-bold text-[#17172A] text-sm">Conversations</span>
              <div class="flex items-center gap-1">
                <span class="px-2 py-0.5 rounded-md bg-[#17172A] text-white text-[10px] font-semibold">Open (14)</span>
                <span class="px-2 py-0.5 rounded-md text-[#656579] hover:bg-[#F4F4F6] text-[10px] font-medium cursor-pointer">Closed</span>
              </div>
            </div>

            <!-- List of Conversation Cards -->
            <div class="space-y-2">
              
              <!-- Card 1: Active Thread (Riya Singh) -->
              <div class="p-3 rounded-xl bg-[#F4F0FF] border border-[#635BFF]/30 shadow-xs cursor-pointer">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="relative">
                      <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" alt="Riya" class="w-8 h-8 rounded-full object-cover" />
                      <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-[#25D366] border-2 border-white flex items-center justify-center text-[7px] text-white font-bold">W</span>
                    </div>
                    <div>
                      <div class="font-bold text-[#17172A] text-xs">Riya Singh</div>
                      <div class="text-[10px] text-[#656579]">Studio Luxe · Mumbai</div>
                    </div>
                  </div>
                  <span class="text-[10px] font-semibold text-[#635BFF]">Just now</span>
                </div>
                <div class="text-[11px] text-[#17172A] font-medium truncate mt-2">
                  "Can NewRelay sync our Shopify customer orders directly into the inbox?"
                </div>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="px-2 py-0.5 rounded-full bg-purple-200/60 text-purple-900 text-[9px] font-bold">⚡ High Intent</span>
                  <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[9px] font-bold">Shopify VIP</span>
                </div>
              </div>

              <!-- Card 2: Karan Sharma -->
              <div class="p-3 rounded-xl hover:bg-[#F8F8FA] border border-transparent hover:border-[#E9E9EF] cursor-pointer transition-all">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="relative">
                      <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80" alt="Karan" class="w-8 h-8 rounded-full object-cover" />
                      <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-gradient-to-tr from-[#FFDC80] via-[#FD1D1D] to-[#833AB4] border-2 border-white flex items-center justify-center text-[7px] text-white font-bold">I</span>
                    </div>
                    <div>
                      <div class="font-bold text-[#17172A] text-xs">Karan Sharma</div>
                      <div class="text-[10px] text-[#656579]">ZapScale · CTO</div>
                    </div>
                  </div>
                  <span class="text-[10px] text-[#9696A8]">12m ago</span>
                </div>
                <div class="text-[11px] text-[#656579] truncate mt-2">
                  "Can we integrate with our custom Postgres database using webhooks?"
                </div>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[9px] font-semibold">API Inquiry</span>
                </div>
              </div>

              <!-- Card 3: Dr. Anita Desai -->
              <div class="p-3 rounded-xl hover:bg-[#F8F8FA] border border-transparent hover:border-[#E9E9EF] cursor-pointer transition-all">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="relative">
                      <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=100&auto=format&fit=crop&q=80" alt="Anita" class="w-8 h-8 rounded-full object-cover" />
                      <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-[#0066FF] border-2 border-white flex items-center justify-center text-[7px] text-white font-bold">@</span>
                    </div>
                    <div>
                      <div class="font-bold text-[#17172A] text-xs">Dr. Anita Desai</div>
                      <div class="text-[10px] text-[#656579]">HealthPlus Clinic</div>
                    </div>
                  </div>
                  <span class="text-[10px] text-[#9696A8]">45m ago</span>
                </div>
                <div class="text-[11px] text-[#656579] truncate mt-2">
                  "Contract renewal for Q4 and adding 15 new doctor seats."
                </div>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[9px] font-semibold">Renewal · 15 Seats</span>
                </div>
              </div>

            </div>
          </div>

          <!-- Bottom SLA Meter -->
          <div class="mt-4 p-2.5 rounded-xl bg-[#F8F8FA] border border-[#E9E9EF] flex items-center justify-between">
            <span class="text-[10px] text-[#656579] font-medium">Avg Team Response: <strong class="text-[#17172A]">1m 42s</strong></span>
            <span class="text-[10px] font-bold text-emerald-600">✓ 99.2% SLA Target</span>
          </div>
        </div>

        <!-- Column 3: Active Rich Conversation & Live App Context (5 cols on sm/lg) -->
        <div class="col-span-12 sm:col-span-7 md:col-span-5 lg:col-span-5.5 bg-[#FCFCFA]/50 p-4 sm:p-5 flex flex-col justify-between">
          
          <!-- Conversation Header -->
          <div class="flex items-center justify-between pb-3 border-b border-[#E9E9EF]">
            <div class="flex items-center gap-2.5">
              <div class="relative">
                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" alt="Riya" class="w-9 h-9 rounded-full object-cover" />
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 border-2 border-white"></span>
              </div>
              <div>
                <div class="font-bold text-[#17172A] text-xs sm:text-sm flex items-center gap-1.5">
                  <span>Riya Singh</span>
                  <span class="text-[10px] font-normal text-[#656579] font-mono">+91 98201 44821</span>
                </div>
                <div class="text-[10px] text-[#656579] flex items-center gap-2">
                  <span class="text-emerald-600 font-semibold">● WhatsApp Business</span>
                  <span>·</span>
                  <span>Assigned to <strong>Priya S.</strong></span>
                </div>
              </div>
            </div>

            <!-- Customer LTV Pill -->
            <div class="text-right hidden sm:block">
              <div class="text-[10px] text-[#9696A8]">Customer Value</div>
              <div class="text-xs font-extrabold text-[#17172A] font-mono">₹1,42,800</div>
            </div>
          </div>

          <!-- Message Thread Stream -->
          <div class="py-4 space-y-3.5">
            
            <!-- 1. Customer Message (Incoming) -->
            <div class="max-w-[85%] bg-white p-3 rounded-2xl rounded-tl-sm border border-[#E9E9EF] shadow-xs">
              <p class="text-xs text-[#17172A] leading-relaxed">
                Hi team! We love the demo. Can NewRelay sync our Shopify customer orders directly into the inbox?
              </p>
              <div class="text-[9px] text-[#9696A8] text-right mt-1">10:14 AM</div>
            </div>

            <!-- 2. AI Intelligence Event Pill -->
            <div class="flex justify-center">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#F2EEFF] border border-[#635BFF]/20 text-[10px] text-[#635BFF] font-semibold">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>AI Copilot: Intent identified as E-commerce Sync · Live order #8291 retrieved</span>
              </div>
            </div>

            <!-- 3. Embedded Live Order Card -->
            <div class="max-w-[88%] ml-auto bg-white p-3 rounded-xl border border-emerald-200 shadow-xs bg-gradient-to-r from-white to-emerald-50/30">
              <div class="flex items-center justify-between pb-1.5 border-b border-emerald-100">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs">🛍️</span>
                  <span class="font-bold text-[11px] text-[#17172A]">Shopify Order #8291</span>
                </div>
                <span class="text-[9px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.2 rounded">Paid · Dispatching</span>
              </div>
              <div class="text-[10px] text-[#656579] mt-1.5 flex justify-between">
                <span>Silk Linen Blazer (M) × 1</span>
                <span class="font-bold text-[#17172A]">₹14,200</span>
              </div>
            </div>

            <!-- 4. Agent Response (Outgoing) -->
            <div class="ml-auto max-w-[85%] bg-[#17172A] text-white p-3 rounded-2xl rounded-tr-sm shadow-xs">
              <p class="text-xs text-[#FCFCFA] leading-relaxed">
                Hey Riya! Absolutely. Here is your recent Shopify order (#8291). Your team can view details, process returns, or share tracking links without switching apps! ✨
              </p>
              <div class="text-[9px] text-slate-400 text-right mt-1 flex items-center justify-end gap-1">
                <span>10:15 AM</span>
                <span class="text-[#635BFF]">✓✓</span>
              </div>
            </div>

          </div>

          <!-- Bottom Smart Reply Bar -->
          <div class="pt-2">
            <!-- AI Quick Actions -->
            <div class="flex items-center gap-1.5 pb-2 overflow-x-auto text-[10px]">
              <button class="px-2.5 py-1 rounded-lg bg-white border border-[#E5E5EA] text-[#17172A] font-semibold hover:border-[#635BFF] flex items-center gap-1 shadow-2xs whitespace-nowrap">
                <span>⚡ Send Tracking Link</span>
              </button>
              <button class="px-2.5 py-1 rounded-lg bg-white border border-[#E5E5EA] text-[#17172A] font-semibold hover:border-[#635BFF] flex items-center gap-1 shadow-2xs whitespace-nowrap">
                <span>📅 Schedule Onboarding</span>
              </button>
            </div>

            <!-- Input Box -->
            <div class="flex items-center gap-2 bg-white border border-[#E5E5EA] rounded-xl px-3 py-2 shadow-xs">
              <input 
                type="text" 
                placeholder="Type a reply or press '/' for AI templates..." 
                class="w-full bg-transparent text-xs text-[#17172A] focus:outline-none placeholder-[#9696A8]"
              />
              <button class="btn-dark !h-8 !px-3 !text-xs !rounded-lg">
                <span>Send</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
