---
// AutomateX CTA Section: Conversion-Focused Banner with Floating Avatars & Decorations
---

<section class="relative py-20 md:py-28 overflow-hidden bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- CTA Main Wrapper Container -->
    <div class="relative bg-gradient-to-b from-[#161520] to-[#0D0C13] border border-slate-800 rounded-3xl sm:rounded-[36px] p-8 sm:p-14 md:p-18 text-center text-white overflow-hidden shadow-2xl">
      
      <!-- Top Radial Purple Atmospheric Light -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-purple-600/30 rounded-full blur-[100px] pointer-events-none"></div>

      <!-- Floating Avatars Decorating the Outer edges of the Container -->
      <img 
        src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69a29cb0253f9fde4cf24dc9_bbdffbfbc5d6ab2e9e446930ae3857cc_avatar-26.jpg" 
        alt="Avatar" 
        class="absolute top-8 left-8 w-12 h-12 rounded-full border-2 border-purple-400/60 object-cover shadow-lg hidden md:block animate-float-1" 
      />

      <img 
        src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975cdd83db13d6c96cb66_008896ea654c782341b9f7f6add8daa2_avatar-23.jpg" 
        alt="Avatar" 
        class="absolute bottom-8 left-12 w-11 h-11 rounded-full border-2 border-purple-400/60 object-cover shadow-lg hidden md:block animate-float-2" 
      />

      <img 
        src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975cd11f086a89279d088_2bad96b3d86f7a95bf3c0c07eaf6214b_avatar-24.jpg" 
        alt="Avatar" 
        class="absolute top-10 right-10 w-12 h-12 rounded-full border-2 border-purple-400/60 object-cover shadow-lg hidden md:block animate-float-2" 
      />

      <img 
        src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69a29b525ce26ae402faa206_d62fc6b01c629cd48891999d54770052_avatar-25.jpg" 
        alt="Avatar" 
        class="absolute bottom-10 right-12 w-11 h-11 rounded-full border-2 border-purple-400/60 object-cover shadow-lg hidden md:block animate-float-1" 
      />

      <!-- Content -->
      <div class="relative z-10 max-w-2xl mx-auto space-y-6">
        
        <h2 class="text-3xl sm:text-5xl md:text-[54px] font-extrabold text-white tracking-tight leading-[1.08] font-['Plus_Jakarta_Sans']">
          Build your first agent today.
        </h2>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl mx-auto">
          Pick a template, connect your tools and knowledge, and deploy with guardrails. Scale to more workflows once the first agent proves value.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          
          <a 
            href="#pricing" 
            class="btn-text-roll group inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-gradient-to-r from-[#5925DC] via-[#7C3AED] to-[#C026D3] text-white font-bold text-xs sm:text-sm shadow-[0_12px_30px_rgba(124,58,237,0.45)] hover:shadow-[0_16px_36px_rgba(124,58,237,0.55)] transition-all"
          >
            <div class="button-text-wrap">
              <span class="text-default">Start free trial</span>
              <span class="text-hover">Start free trial</span>
            </div>
          </a>

          <a 
            href="#agents" 
            class="btn-text-roll group inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold text-xs sm:text-sm transition-all"
          >
            <div class="button-text-wrap">
              <span class="text-default">Browse templates</span>
              <span class="text-hover">Browse templates</span>
            </div>
          </a>

        </div>

      </div>

    </div>

  </div>
</section>
