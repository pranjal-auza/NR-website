---
// Partner Logos Section: Seamless blend on #FCFCFA with elegant interactive hover states
---

<section class="py-6 sm:py-8 bg-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Tag -->
    <p class="text-center text-[11px] sm:text-xs font-bold tracking-[0.2em] text-[#656579]/70 uppercase font-['Plus_Jakarta_Sans'] mb-7">
      TRUSTED BY GROWING BUSINESSES
    </p>

    <!-- Logo Strip -->
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 md:gap-18 opacity-85 hover:opacity-100 transition-opacity duration-300">
      
      <!-- 1. Zomato -->
      <div class="group cursor-pointer transition-all duration-300 transform hover:scale-105">
        <span class="text-2xl sm:text-3xl font-black italic tracking-tighter text-[#17172A]/80 group-hover:text-[#E23744] transition-colors duration-300">
          zomato
        </span>
      </div>

      <!-- 2. Shiprocket -->
      <div class="group cursor-pointer transition-all duration-300 transform hover:scale-105 flex items-center gap-1.5 font-bold text-[#17172A]/80 text-xl tracking-tight">
        <svg class="w-6 h-6 text-[#17172A]/80 group-hover:text-[#6C5CE7] transition-colors duration-300" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        <span class="text-[#17172A]/80 group-hover:text-[#2D3436] transition-colors duration-300">Shiprocket</span>
      </div>

      <!-- 3. Razorpay -->
      <div class="group cursor-pointer transition-all duration-300 transform hover:scale-105 flex items-center gap-1 font-extrabold text-[#17172A]/80 text-xl tracking-tight">
        <svg class="w-4 h-6 text-[#17172A]/80 group-hover:text-[#0C2340] group-hover:fill-[#02042B] transition-colors duration-300" viewBox="0 0 20 24">
          <path d="M14.5 2L5 13.5h5.5L8 22l11-13h-6l1.5-7z" fill="currentColor"/>
        </svg>
        <span class="text-[#17172A]/80 group-hover:text-[#0C2340] transition-colors duration-300">Razorpay</span>
      </div>

      <!-- 4. Mamaearth -->
      <div class="group cursor-pointer transition-all duration-300 transform hover:scale-105 flex items-center font-bold text-[#17172A]/80 text-xl tracking-tight lowercase">
        <span class="text-[#17172A]/80 group-hover:text-[#00A86B] transition-colors duration-300">mamaearth</span>
        <span class="text-[10px] text-slate-400 group-hover:text-[#00A86B] ml-0.5 mb-2 font-normal">™</span>
      </div>

      <!-- 5. CRED -->
      <div class="group cursor-pointer transition-all duration-300 transform hover:scale-105 flex items-center gap-1 font-black text-[#17172A]/80 text-xl tracking-widest border-2 border-[#17172A]/80 px-2 py-0.5 rounded group-hover:bg-[#17172A] group-hover:text-white group-hover:border-[#17172A] transition-all duration-300">
        <span>CRED</span>
      </div>

      <!-- 6. Unacademy -->
      <div class="group cursor-pointer transition-all duration-300 transform hover:scale-105 flex items-center gap-2 font-bold text-[#17172A]/80 text-xl tracking-tight lowercase">
        <div class="w-5 h-5 rounded-full bg-[#17172A]/80 group-hover:bg-[#08BD80] transition-colors duration-300 flex items-center justify-center text-white text-[10px] font-bold">
          U
        </div>
        <span class="text-[#17172A]/80 group-hover:text-[#0858F7] transition-colors duration-300">unacademy</span>
      </div>

    </div>

  </div>
</section>

