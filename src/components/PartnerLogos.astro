---
// Partner Logos Section — Infinite Smooth Scrolling Brand Marquee with Dividers & Gradient Overlays
const brandLogos = [
  { name: "Netdot", src: "https://cdn.prod.website-files.com/673442f44c948080a43e913b/6735a91dd6170340af3b9b5b_brand-logo1.svg" },
  { name: "Sparkweb", src: "https://cdn.prod.website-files.com/673442f44c948080a43e913b/6735a91ded48997c8d27ff38_brand-logo2.svg" },
  { name: "Webgear", src: "https://cdn.prod.website-files.com/673442f44c948080a43e913b/6735a91de72fef2ffb2bb77e_brand-logo3.svg" },
  { name: "Digitech", src: "https://cdn.prod.website-files.com/673442f44c948080a43e913b/6735a91ef6970e5e72dbd2f7_brand-logo4.svg" },
  { name: "Codelink", src: "https://cdn.prod.website-files.com/673442f44c948080a43e913b/6735a91ef2412e3b3e12e42b_brand-logo5.svg" },
];

// Duplicate for seamless 60fps infinite marquee loop
const marqueeList = [...brandLogos, ...brandLogos, ...brandLogos, ...brandLogos];
---

<section class="py-8 sm:py-12 bg-transparent relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <p class="text-center text-xs sm:text-sm font-semibold tracking-normal text-[#656579] font-['Plus_Jakarta_Sans'] mb-8 sm:mb-10">
      Trusted by the world’s most innovative teams
    </p>

    <!-- Marquee Slider Container with Gradient Edge Overlays -->
    <div class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      
      <!-- Infinite Running Track -->
      <div class="flex items-center w-max animate-marquee hover:[animation-play-state:paused] py-2">
        {marqueeList.map((logo) => (
          <div class="flex items-center">
            <div class="px-6 sm:px-10 flex items-center justify-center opacity-85 hover:opacity-100 transition-all duration-300 transform hover:scale-105 cursor-pointer">
              <img 
                src={logo.src} 
                alt={logo.name} 
                class="h-7 sm:h-8 w-auto object-contain max-w-[140px] select-none"
                loading="lazy"
              />
            </div>
            <!-- Vertical Divider -->
            <div class="h-6 w-[1px] bg-slate-200/90 flex-shrink-0"></div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-marquee {
    animation: marquee 28s linear infinite;
    will-change: transform;
  }
</style>


