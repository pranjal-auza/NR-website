---
import Icon from './icons/Icon.astro';
---

<section id="pricing" class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold uppercase tracking-wider border border-blue-500/20 font-mono">
        <Icon name="star" class="w-3.5 h-3.5" />
        <span>Transparent Enterprise Pricing</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        Predictable plans. Uncompromised scale.
      </h2>

      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        Start free for 14 days. No credit card required. Upgrade when you're ready to scale your revenue team and AI agents.
      </p>

      <!-- Billing Period Switcher -->
      <div class="flex items-center justify-center gap-3 pt-4">
        <span id="monthly-label" class="text-sm font-medium text-secondary-fg">Monthly</span>
        <button id="billing-toggle" aria-label="Toggle annual billing" class="relative w-12 h-6 rounded-full bg-surface border border-subtle-stroke p-0.5 transition-colors cursor-pointer">
          <span id="toggle-thumb" class="block w-5 h-5 rounded-full bg-brand-500 shadow-attio-1 transition-transform duration-200"></span>
        </button>
        <span id="annual-label" class="text-sm font-medium text-foreground flex items-center gap-1.5 font-mono">
          <span>Annual</span>
          <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-xs font-semibold border border-emerald-500/20">Save 20%</span>
        </span>
      </div>
    </div>

    <!-- 3 Tier Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto items-stretch">
      
      <!-- Tier 1: Starter -->
      <div class="p-8 rounded-2xl enterprise-card flex flex-col justify-between space-y-6 hover:border-default-stroke transition-all">
        <div class="space-y-4">
          <div>
            <h3 class="text-xl font-bold text-foreground">Starter</h3>
            <p class="text-xs text-secondary-fg mt-1">For high-velocity founders and early teams establishing omnichannel customer workflows.</p>
          </div>

          <div class="pt-2">
            <span class="price-val text-4xl font-display font-bold text-foreground font-mono" data-monthly="39" data-annual="29">$29</span>
            <span class="text-xs text-caption-fg">/ seat / mo</span>
          </div>

          <a href="#demo" class="button-outline w-full justify-center text-sm font-medium">Start 14-Day Free Trial</a>

          <div class="pt-4 border-t border-subtle-stroke space-y-2.5 text-xs text-foreground">
            <div class="font-semibold text-caption-fg uppercase tracking-wider text-[10px] font-mono">Core Inclusions:</div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Unified Inbox (WhatsApp, SMS & Email)</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Basic Deal Pipelines (Kanban View)</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>500 Captain AI automated resolutions / mo</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Video Review outreach widget</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tier 2: Growth Pro (Highlighted) -->
      <div class="p-8 rounded-2xl enterprise-card border-2 border-brand-500 shadow-attio-6 relative flex flex-col justify-between space-y-6 scale-105 z-10">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-brand-500 text-white font-semibold text-xs shadow-attio-2 font-mono">
          MOST POPULAR
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-xl font-bold text-foreground">Growth Pro</h3>
            <p class="text-xs text-secondary-fg mt-1">For scaling revenue teams that want full AI autonomy and pipeline velocity.</p>
          </div>

          <div class="pt-2">
            <span class="price-val text-4xl font-display font-bold text-foreground font-mono" data-monthly="79" data-annual="59">$59</span>
            <span class="text-xs text-caption-fg">/ seat / mo</span>
          </div>

          <a href="#demo" class="button-primary w-full justify-center shadow-attio-3 text-sm font-medium">Start 14-Day Free Trial</a>

          <div class="pt-4 border-t border-subtle-stroke space-y-2.5 text-xs text-foreground">
            <div class="font-semibold text-caption-fg uppercase tracking-wider text-[10px] font-mono">Everything in Starter, plus:</div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-brand-400 shrink-0" />
              <span>Unlimited Captain AI automated triage</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-brand-400 shrink-0" />
              <span>AI Copilot real-time draft suggestions</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-brand-400 shrink-0" />
              <span>Multi-channel sequence & autoresponder builder</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-brand-400 shrink-0" />
              <span>Directory listing sync (Google, Yelp, Facebook)</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-brand-400 shrink-0" />
              <span>Full REST API, Webhooks & TypeScript SDK</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tier 3: Enterprise Scale -->
      <div class="p-8 rounded-2xl enterprise-card flex flex-col justify-between space-y-6 hover:border-default-stroke transition-all">
        <div class="space-y-4">
          <div>
            <h3 class="text-xl font-bold text-foreground">Enterprise Scale</h3>
            <p class="text-xs text-secondary-fg mt-1">For global organizations requiring custom RAG models, dedicated carrier SLAs, and custom VPC.</p>
          </div>

          <div class="pt-2">
            <span class="text-4xl font-display font-bold text-foreground font-mono">Custom</span>
            <span class="text-xs text-caption-fg">/ tailored volume</span>
          </div>

          <a href="#demo" class="button-outline w-full justify-center text-sm font-medium">Talk to Enterprise Sales</a>

          <div class="pt-4 border-t border-subtle-stroke space-y-2.5 text-xs text-foreground">
            <div class="font-semibold text-caption-fg uppercase tracking-wider text-[10px] font-mono">Enterprise Governance:</div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Dedicated Account Manager & 99.99% SLA</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Custom RAG vector models & private VPC deployment</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Custom carrier WhatsApp phone number onboarding</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>SOC 2 Type II, HIPAA & GDPR enterprise MSA</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Native Okta & Azure AD SAML 2.0 SSO</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const toggle = document.getElementById('billing-toggle');
  const thumb = document.getElementById('toggle-thumb');
  const prices = document.querySelectorAll<HTMLElement>('.price-val');
  const monthlyLabel = document.getElementById('monthly-label');
  const annualLabel = document.getElementById('annual-label');

  let isAnnual = true;

  if (toggle && thumb) {
    toggle.addEventListener('click', () => {
      isAnnual = !isAnnual;
      
      if (isAnnual) {
        thumb.classList.remove('translate-x-0');
        thumb.classList.add('translate-x-6');
        if (monthlyLabel) monthlyLabel.className = 'text-sm font-medium text-secondary-fg';
        if (annualLabel) annualLabel.className = 'text-sm font-medium text-foreground flex items-center gap-1.5 font-mono';
      } else {
        thumb.classList.remove('translate-x-6');
        thumb.classList.add('translate-x-0');
        if (monthlyLabel) monthlyLabel.className = 'text-sm font-medium text-foreground';
        if (annualLabel) annualLabel.className = 'text-sm font-medium text-secondary-fg flex items-center gap-1.5 font-mono';
      }

      prices.forEach(p => {
        const amt = isAnnual ? p.getAttribute('data-annual') : p.getAttribute('data-monthly');
        p.textContent = `$${amt}`;
      });
    });

    // Set initial position
    thumb.classList.add('translate-x-6');
  }
</script>
