---
import Icon from './icons/Icon.astro';
---

<section class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-secondary-bg/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Badge & Header -->
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 text-xs font-semibold uppercase tracking-wider border border-purple-500/20 font-mono">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>Universal Context ™ Engine</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        The unified intelligence layer for your revenue stack.
      </h2>

      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        Conversations, customer sentiment, product documentation, deal velocity, and payment events—automatically structured into continuous AI memory. No agent left guessing.
      </p>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-14">
      
      <!-- Card 1: Autonomous Ingestion -->
      <div class="enterprise-card p-6 rounded-2xl space-y-3 hover:border-brand-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-400 flex items-center justify-center border border-brand-500/20">
            <Icon name="inbox" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-foreground">Continuous Auto-Ingestion</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            WhatsApp voice notes, call recordings, live chats, and email exchanges are transcribed and indexed into CRM timelines with zero manual data entry.
          </p>
        </div>
        <div class="pt-2 border-t border-subtle-stroke text-[11px] font-mono text-brand-400">
          ✓ Zero Manual Entry
        </div>
      </div>

      <!-- Card 2: Bi-Directional Warehouse Sync -->
      <div class="enterprise-card p-6 rounded-2xl space-y-3 hover:border-purple-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center border border-purple-500/20">
            <Icon name="database" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-foreground">Data Lake & Warehouse Sync</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Bi-directional connectors for Snowflake, BigQuery, PostgreSQL, Stripe, and Salesforce converge into unified customer profiles with complete audit history.
          </p>
        </div>
        <div class="pt-2 border-t border-subtle-stroke text-[11px] font-mono text-purple-400">
          ✓ Sub-50ms Event Streaming
        </div>
      </div>

      <!-- Card 3: Deterministic Verification -->
      <div class="enterprise-card p-6 rounded-2xl space-y-3 hover:border-emerald-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center border border-emerald-500/20">
            <Icon name="shield" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-foreground">Zero-Hallucination Guardrails</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Captain AI references verified product PDFs and SLA rules before answering, ensuring accurate contract details and precise pricing every single time.
          </p>
        </div>
        <div class="pt-2 border-t border-subtle-stroke text-[11px] font-mono text-emerald-400">
          ✓ 99.6% Accuracy Standard
        </div>
      </div>

      <!-- Card 4: Enterprise Semantic Querying -->
      <div class="enterprise-card p-6 rounded-2xl space-y-3 hover:border-amber-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center border border-amber-500/20">
            <Icon name="star" class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-foreground">Natural Language Intel</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Search across 500k+ customer interactions using plain English. Query quarterly renewal risks, top customer objections, or rep win rates in seconds.
          </p>
        </div>
        <div class="pt-2 border-t border-subtle-stroke text-[11px] font-mono text-amber-400">
          ✓ Real-Time Intent Scoring
        </div>
      </div>

    </div>

  </div>
</section>
