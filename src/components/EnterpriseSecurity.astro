---
import Icon from './icons/Icon.astro';
---

<section id="security" class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-secondary-bg/30">
  <!-- Radial Background Accent -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[750px] h-[350px] bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider border border-emerald-500/20 font-mono">
        <Icon name="shield" class="w-3.5 h-3.5" />
        <span>Enterprise Governance & Trust</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        Institutional security. Zero compromise.
      </h2>

      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        Built for regulated global enterprises. New-Relay meets the world's most rigorous security standards so your compliance and security officers can approve with confidence.
      </p>
    </div>

    <!-- 4 High-Spec Security Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Card 1: Zero LLM Retention -->
      <div class="enterprise-card p-6 sm:p-7 rounded-2xl space-y-4 hover:border-emerald-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center">
            <Icon name="database" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Zero LLM Data Retention</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Your proprietary messages, PDFs, and customer transcripts are strictly isolated. No customer data is ever retained or used to train third-party foundation models.
          </p>
        </div>

        <div class="pt-3 border-t border-subtle-stroke text-[11px] font-mono text-emerald-400 flex items-center gap-1.5">
          <Icon name="check-circle" class="w-3.5 h-3.5" />
          <span>Strict Tenant Isolation</span>
        </div>
      </div>

      <!-- Card 2: Private VPC & BYOK -->
      <div class="enterprise-card p-6 sm:p-7 rounded-2xl space-y-4 hover:border-brand-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-400 border border-brand-500/20 flex items-center justify-center">
            <Icon name="server" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Private VPC & BYOK</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Deploy on dedicated single-tenant infrastructure within your AWS, GCP, or Azure perimeter with Bring-Your-Own-Key (BYOK) AES-256 encryption.
          </p>
        </div>

        <div class="pt-3 border-t border-subtle-stroke text-[11px] font-mono text-brand-400 flex items-center gap-1.5">
          <Icon name="check-circle" class="w-3.5 h-3.5" />
          <span>Single-Tenant Available</span>
        </div>
      </div>

      <!-- Card 3: Enterprise RBAC & SSO -->
      <div class="enterprise-card p-6 sm:p-7 rounded-2xl space-y-4 hover:border-purple-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center">
            <Icon name="key" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">SSO, SCIM & RBAC</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Enforce corporate security policies with native Okta, Azure AD, and Google Workspace SAML 2.0 SSO, automated SCIM provisioning, and role hierarchies.
          </p>
        </div>

        <div class="pt-3 border-t border-subtle-stroke text-[11px] font-mono text-purple-400 flex items-center gap-1.5">
          <Icon name="check-circle" class="w-3.5 h-3.5" />
          <span>Okta & Azure AD Native</span>
        </div>
      </div>

      <!-- Card 4: 99.99% Carrier SLA -->
      <div class="enterprise-card p-6 sm:p-7 rounded-2xl space-y-4 hover:border-amber-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center">
            <Icon name="activity" class="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">99.99% Carrier Uptime SLA</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Multi-carrier fallback network routing across Meta Direct WhatsApp API, Twilio, and global SMS telecommunication backbones to prevent message drops.
          </p>
        </div>

        <div class="pt-3 border-t border-subtle-stroke text-[11px] font-mono text-amber-400 flex items-center gap-1.5">
          <Icon name="check-circle" class="w-3.5 h-3.5" />
          <span>Financially Backed SLA</span>
        </div>
      </div>

    </div>

    <!-- Interactive Compliance Badges Bar -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl enterprise-card">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center text-center">
        
        <div class="space-y-1.5 p-3 rounded-xl bg-surface/50 border border-subtle-stroke">
          <div class="font-bold text-foreground text-sm font-mono flex items-center justify-center gap-1.5">
            <Icon name="shield" class="w-4 h-4 text-emerald-400" />
            <span>SOC 2 Type II</span>
          </div>
          <div class="text-[11px] text-secondary-fg">Independently Audited & Certified</div>
        </div>

        <div class="space-y-1.5 p-3 rounded-xl bg-surface/50 border border-subtle-stroke">
          <div class="font-bold text-foreground text-sm font-mono flex items-center justify-center gap-1.5">
            <Icon name="lock" class="w-4 h-4 text-emerald-400" />
            <span>HIPAA Ready</span>
          </div>
          <div class="text-[11px] text-secondary-fg">BAA Signed for Healthcare Orgs</div>
        </div>

        <div class="space-y-1.5 p-3 rounded-xl bg-surface/50 border border-subtle-stroke">
          <div class="font-bold text-foreground text-sm font-mono flex items-center justify-center gap-1.5">
            <Icon name="globe" class="w-4 h-4 text-emerald-400" />
            <span>GDPR & CCPA</span>
          </div>
          <div class="text-[11px] text-secondary-fg">EU Data Residency & Right to Erasure</div>
        </div>

        <div class="space-y-1.5 p-3 rounded-xl bg-surface/50 border border-subtle-stroke">
          <div class="font-bold text-foreground text-sm font-mono flex items-center justify-center gap-1.5">
            <Icon name="server" class="w-4 h-4 text-emerald-400" />
            <span>ISO 27001</span>
          </div>
          <div class="text-[11px] text-secondary-fg">Information Security Management</div>
        </div>

      </div>

      <div class="mt-6 pt-6 border-t border-subtle-stroke flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary-fg">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Continuous automated compliance monitoring powered by Vanta</span>
        </span>
        <a href="#demo" class="button-outline text-xs inline-flex items-center gap-1.5">
          <span>Request Security Whitepaper & SOC2 Report</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</section>
