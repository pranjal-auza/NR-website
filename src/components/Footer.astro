---
import Icon from './icons/Icon.astro';
---

<footer class="border-t border-subtle-stroke bg-secondary-bg/50 pt-16 pb-12 text-sm text-secondary-fg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Footer Columns -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 pb-12 border-b border-subtle-stroke">
      
      <!-- Brand & Summary -->
      <div class="col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5 font-display font-semibold text-lg text-foreground">
          <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center text-white shadow-attio-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight">New-Relay</span>
          <span class="text-[10px] font-mono font-semibold uppercase tracking-wider px-1.5 py-0.2 rounded bg-brand-500/10 text-brand-400 border border-brand-500/20">ENTERPRISE OS</span>
        </a>
        <p class="text-xs sm:text-sm text-caption-fg max-w-sm leading-relaxed">
          The intelligent revenue and customer communication operating system. Omnichannel inboxes, Captain AI agents, deal pipelines, and automated reputation.
        </p>

        <!-- System Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface border border-subtle-stroke text-[11px] font-mono text-caption-fg">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>All Systems Operational (99.99% Uptime SLA)</span>
        </div>
      </div>

      <!-- Column 1: Platform -->
      <div class="space-y-3">
        <div class="text-xs font-semibold uppercase tracking-wider text-foreground font-mono">Platform</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#inbox" class="hover:text-foreground transition-colors">Omnichannel Inbox</a></li>
          <li><a href="#relay-ai" class="hover:text-foreground transition-colors">Captain AI Agent</a></li>
          <li><a href="#pipelines" class="hover:text-foreground transition-colors">CRM & Deal Pipelines</a></li>
          <li><a href="#reputation" class="hover:text-foreground transition-colors">Reputation & Video</a></li>
          <li><a href="#workflows" class="hover:text-foreground transition-colors">Workflows & Triggers</a></li>
          <li><a href="/pricing" class="hover:text-foreground transition-colors">Enterprise Pricing</a></li>
        </ul>
      </div>

      <!-- Column 2: Governance & Security -->
      <div class="space-y-3">
        <div class="text-xs font-semibold uppercase tracking-wider text-foreground font-mono">Security & Trust</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#security" class="hover:text-foreground transition-colors">Trust Center & SOC 2</a></li>
          <li><a href="#security" class="hover:text-foreground transition-colors">HIPAA Compliance (BAA)</a></li>
          <li><a href="#security" class="hover:text-foreground transition-colors">GDPR & CCPA Data Rights</a></li>
          <li><a href="#security" class="hover:text-foreground transition-colors">Zero LLM Data Retention</a></li>
          <li><a href="#security" class="hover:text-foreground transition-colors">Private VPC Deployment</a></li>
          <li><a href="#comparison" class="hover:text-foreground transition-colors">Stack ROI Comparison</a></li>
        </ul>
      </div>

      <!-- Column 3: Developers & Ecosystem -->
      <div class="space-y-3">
        <div class="text-xs font-semibold uppercase tracking-wider text-foreground font-mono">Developers</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#developers" class="hover:text-foreground transition-colors">REST API Documentation</a></li>
          <li><a href="#developers" class="hover:text-foreground transition-colors">TypeScript & Python SDKs</a></li>
          <li><a href="#developers" class="hover:text-foreground transition-colors">Model Context Protocol (MCP)</a></li>
          <li><a href="#developers" class="hover:text-foreground transition-colors">Webhooks & Event Stream</a></li>
          <li><a href="/changelog" class="hover:text-foreground transition-colors">Weekly Changelog</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-caption-fg">
      <div class="font-mono">
        © 2026 New-Relay Technologies, Inc. All rights reserved. SOC 2 Type II Certified.
      </div>
      
      <div class="flex items-center gap-6">
        <a href="#privacy" class="hover:text-foreground transition-colors">Privacy Policy</a>
        <a href="#terms" class="hover:text-foreground transition-colors">Terms of Service</a>
        <a href="#security" class="hover:text-foreground transition-colors font-medium text-emerald-400">Security Center</a>
      </div>
    </div>

  </div>
</footer>
