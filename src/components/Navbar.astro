---
// Navbar Component — Sticky Pill Header on Scroll (30px border-radius)
---

<header id="site-header" class="sticky top-0 z-50 w-full transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 transition-all duration-300" id="header-outer-container">
    <div 
      id="navbar-pill" 
      class="navbar-pill-box w-full flex flex-col justify-center transition-all duration-300"
    >
      <div class="flex items-center justify-between w-full h-full">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center group py-1">
          <img src="/new-relay-logo.svg" alt="NewRelay" class="h-7 sm:h-8.5 w-auto object-contain transition-all duration-300" id="navbar-brand-logo" />
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden md:flex items-center gap-7 lg:gap-8">
          <!-- 1. Versions Dropdown (Home 1, Home 2, Home 3, Home 4) -->
          <div class="relative group">
            <button class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#17172A] bg-purple-50/80 hover:bg-purple-100/80 text-[#635BFF] px-3 py-1.5 rounded-full transition-all cursor-pointer border border-purple-200/80">
              <span class="w-1.5 h-1.5 rounded-full bg-[#635BFF] animate-pulse"></span>
              <span>Versions</span>
              <svg class="w-3.5 h-3.5 text-[#635BFF] group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            
            <!-- Dropdown Card -->
            <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50 pointer-events-none group-hover:pointer-events-auto">
              <div class="w-60 bg-white/98 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-[0_16px_40px_rgba(23,23,42,0.12)] p-2 flex flex-col gap-1">
                <div class="px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Select Version</div>
                <a href="/" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                  <span>Home 1 (Omnichannel)</span>
                  <span class="text-[10px] font-bold text-[#635BFF] bg-purple-100/80 px-2 py-0.5 rounded-full">v1</span>
                </a>
                <a href="/home-2" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                  <span>Home 2 (Reputation)</span>
                  <span class="text-[10px] font-bold text-amber-600 bg-amber-100/80 px-2 py-0.5 rounded-full">v2</span>
                </a>
                <a href="/home-3" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                  <span>Home 3 (Full Stack)</span>
                  <span class="text-[10px] font-bold text-indigo-600 bg-indigo-100/80 px-2 py-0.5 rounded-full">v3</span>
                </a>
                <a href="/home-4" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                  <span>Home 4 (Custom Canvas)</span>
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-full">v4</span>
                </a>
              </div>
            </div>
          </div>

          <!-- 2. Product -->
          <div class="relative group">
            <button class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#656579] hover:text-[#17172A] py-2 transition-colors">
              <span>Product</span>
              <svg class="w-3.5 h-3.5 text-[#9696A8] group-hover:text-[#17172A] transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
          </div>

          <!-- 3. Solutions -->
          <div class="relative group">
            <button class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#656579] hover:text-[#17172A] py-2 transition-colors">
              <span>Solutions</span>
              <svg class="w-3.5 h-3.5 text-[#9696A8] group-hover:text-[#17172A] transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
          </div>

          <!-- 4. Resources -->
          <div class="relative group">
            <button class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#656579] hover:text-[#17172A] py-2 transition-colors">
              <span>Resources</span>
              <svg class="w-3.5 h-3.5 text-[#9696A8] group-hover:text-[#17172A] transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
          </div>

          <!-- 5. Pricing -->
          <a href="#pricing" class="text-xs sm:text-sm font-semibold text-[#656579] hover:text-[#17172A] py-2 transition-colors">
            Pricing
          </a>
        </nav>

        <!-- Right CTAs -->
        <div class="flex items-center gap-4 sm:gap-5">
          <a href="#login" class="hidden sm:inline-flex text-xs sm:text-sm font-semibold text-[#656579] hover:text-[#17172A] transition-colors">
            Log in
          </a>
          
          <a href="#start" class="btn-dark group !h-9 !px-4 !text-xs !rounded-full sm:!h-10 sm:!px-5 sm:!text-sm sm:!rounded-xl transition-all">
            <span>Start for free</span>
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <!-- Mobile Menu Hamburger -->
          <button id="mobile-toggle-btn" class="md:hidden p-2 text-slate-600 hover:text-slate-900" aria-label="Open mobile menu">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>

      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-nav-menu" class="hidden md:hidden py-3 mt-2 border-t border-slate-100 flex flex-col gap-2">
        <div class="py-1">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider px-1 mb-1">More</div>
          <div class="flex flex-col gap-1 pl-2">
            <a href="/" class="text-sm font-medium text-slate-700 py-1 hover:text-purple-600">Home 1 (Omnichannel)</a>
            <a href="/home-2" class="text-sm font-medium text-slate-700 py-1 hover:text-purple-600">Home 2 (Reputation)</a>
            <a href="/home-3" class="text-sm font-medium text-slate-700 py-1 hover:text-purple-600">Home 3 (Full Stack)</a>
            <a href="/home-4" class="text-sm font-medium text-slate-700 py-1 hover:text-purple-600">Home 4</a>
          </div>
        </div>
        <a href="#product" class="text-sm font-medium text-slate-700 py-1.5 px-1 hover:text-purple-600">Product</a>
        <a href="#solutions" class="text-sm font-medium text-slate-700 py-1.5 px-1 hover:text-purple-600">Solutions</a>
        <a href="#resources" class="text-sm font-medium text-slate-700 py-1.5 px-1 hover:text-purple-600">Resources</a>
        <a href="#pricing" class="text-sm font-medium text-slate-700 py-1.5 px-1 hover:text-purple-600">Pricing</a>
        <div class="pt-2 flex flex-col gap-2 border-t border-slate-100">
          <a href="#login" class="text-sm font-semibold text-slate-700 py-1.5 text-center">Log in</a>
          <a href="#start" class="btn-dark w-full text-center !h-9 !text-xs !rounded-full">Start for free</a>
        </div>
      </div>

    </div>
  </div>
</header>

<style>
  /* Base (Unscrolled) Header State — Transparent so it seamlessly inherits the page background */
  #site-header {
    background-color: transparent;
    padding-top: 0px;
  }

  .navbar-pill-box {
    height: 4.75rem; /* 76px */
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid transparent;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    box-shadow: none;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Scrolled: Floating Pill Header with 30px Border Radius */
  #site-header.is-scrolled {
    padding-top: 0.85rem; /* 14px */
  }

  #site-header.is-scrolled #header-outer-container {
    max-width: 64rem; /* 1024px centered pill width */
    padding-left: 1rem;
    padding-right: 1rem;
  }

  #site-header.is-scrolled .navbar-pill-box {
    height: 3.85rem; /* 62px compact */
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(23, 23, 42, 0.09);
    border-radius: 30px; /* Exact 30px pill border radius requested */
    box-shadow: 0 14px 34px -6px rgba(23, 23, 42, 0.1), 0 4px 12px -2px rgba(23, 23, 42, 0.05);
  }

  @media (max-width: 640px) {
    .navbar-pill-box {
      height: 4.25rem;
    }
    #site-header.is-scrolled {
      padding-top: 0.5rem;
    }
    #site-header.is-scrolled #header-outer-container {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
    #site-header.is-scrolled .navbar-pill-box {
      height: 3.5rem;
      padding-left: 1rem;
      padding-right: 1rem;
      border-radius: 30px;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const menu = document.getElementById('mobile-nav-menu');

  const onScroll = () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  toggleBtn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
