                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              </div>
              <span class="text-xs font-bold text-[#17172A] mt-1.5 tracking-tight select-none whitespace-nowrap group-hover:text-[#0066FF] transition-colors">Email</span>
            </div>
          </div>

          <!-- 7. Floating Channel: Calls (Left - 180°) -> left: 0%, top: 50% [GREEN] -->
          <div class="absolute -translate-x-1/2 -translate-y-1/2 z-20" style="left: 0%; top: 50%;">
            <div class="flex flex-col items-center group cursor-pointer animate-float-node-7">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#00C853] shadow-[0_10px_25px_-5px_rgba(0,200,83,0.4),0_4px_10px_-2px_rgba(0,200,83,0.2)] flex items-center justify-center text-white group-hover:scale-115 group-hover:shadow-[0_16px_32px_-4px_rgba(0,200,83,0.55)] transition-all duration-300">
