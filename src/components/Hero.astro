              <span class="text-xs font-bold text-[#17172A] mt-1.5 tracking-tight select-none whitespace-nowrap group-hover:text-[#A824FF] transition-colors">Messenger</span>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<!-- Scoped Classy & Sleek Animations for the Hero Graphic -->
<style>
  /* 1. Central 3D Logo Levitation & Breathing */
  @keyframes logoLevitate {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(0, -9px, 0) scale(1.02);
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes shadowBreathe {
    0% {
      transform: scale(0.92);
      opacity: 0.18;
    }
    50% {
      transform: scale(1.12);
      opacity: 0.32;
    }
    100% {
      transform: scale(0.92);
      opacity: 0.18;
    }
  }

  .animate-logo-levitate {
    animation: logoLevitate 6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    will-change: transform;
  }

  .animate-shadow-breathe {
    animation: shadowBreathe 6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    will-change: transform, opacity;
  }

  /* 2. Concentric Ripple Layers & Celestial Rotation */
  @keyframes rippleBreathe {
    0%, 100% {
      transform: scale(0.985);
      opacity: 0.45;
    }
    50% {
      transform: scale(1.018);
      opacity: 0.75;
    }
  }

  @keyframes spinCelestial {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes haloPulse {
    0%, 100% {
      transform: scale(0.975);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.025);
      opacity: 0.85;
    }
  }

  @keyframes orbitGlow {
    0%, 100% {
      box-shadow: 0 0 25px -5px rgba(99, 91, 255, 0.08);
      border-color: rgba(196, 181, 253, 0.7);
    }
    50% {
      box-shadow: 0 0 40px 0px rgba(99, 91, 255, 0.16);
      border-color: rgba(167, 139, 250, 0.95);
    }
  }

  .animate-ripple-breathe {
    animation: rippleBreathe 9s ease-in-out infinite;
    will-change: transform, opacity;
  }

