---
// Hero Section: Side-by-Side Playful SaaS Composition (Copy on Left, Graphic on Right)
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-28 overflow-hidden bg-[#FCFCFA]">
  <!-- Subtle Atmospheric Pale Purple & Soft Glows -->
  <div class="absolute top-1/4 left-1/4 w-[650px] h-[400px] bg-purple-100/35 rounded-full blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute top-1/3 right-10 w-[600px] h-[450px] bg-purple-50/60 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 2-Column Grid: Text on Left (6 cols), Graphic on Right (6 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & Actions (lg:col-span-6) -->
      <div class="lg:col-span-6 space-y-6 text-left">
        
        <!-- 1. Eyebrow Pill with Playful Micro-Details -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-50/80 border border-purple-100 text-xs font-semibold tracking-wide text-[#635BFF] shadow-2xs">
          <span>✨</span>
          <span class="font-bold text-[#17172A]">All conversations.</span>
          <span class="text-purple-300">•</span>
          <span class="text-[#656579]">One intelligent workspace</span>
        </div>

        <!-- 2. Editorial Headline (2-3 lines) -->
        <h1 class="text-4xl sm:text-6xl lg:text-[68px] font-extrabold text-[#17172A] tracking-[-0.04em] leading-[0.98] font-['Plus_Jakarta_Sans']">
          Turn conversations <br />
          into <span class="text-[#635BFF]">growth.</span>
        </h1>

        <!-- 3. Softer Description -->
        <p class="text-base sm:text-lg text-[#656579] max-w-xl leading-relaxed font-normal">
          Bring WhatsApp, Instagram, email, calls, reviews and more into one connected workspace — so you can engage, automate and grow without switching tools.
        </p>

        <!-- 4. Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 pt-1">
          <a href="#start" class="btn-dark px-7 shadow-lg shadow-slate-900/10 group">
            <span>Start for free</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <a href="#demo" class="btn-white px-6">
            <span>Book a demo</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Visual Product Graphic with Multi-Layered Sleek & Classy Animations (lg:col-span-6) -->
      <div class="lg:col-span-6 relative flex items-center justify-center min-h-[540px] sm:min-h-[620px] w-full pt-6 select-none">
        
        <!-- EXTENDED OUTER PALE PURPLE RIPPLE LAYERS -->
        <!-- Extended Layer 3 (Outer Pale Lavender Atmosphere - 700px) with subtle breathing pulse -->
        <div class="w-[540px] h-[540px] sm:w-[700px] sm:h-[700px] rounded-full border border-purple-200/35 bg-purple-50/15 pointer-events-none absolute -z-30 animate-ripple-breathe"></div>

        <!-- Extended Layer 2 (Secondary Pale Purple Dashed Orbit - 570px) with ultra-slow calm celestial rotation -->
        <div class="w-[440px] h-[440px] sm:w-[570px] sm:h-[570px] rounded-full border border-dashed border-purple-200/60 bg-purple-50/25 pointer-events-none absolute -z-20 animate-spin-celestial"></div>

        <!-- Floating Playful Micro-Chip (Top-Left on Extended Orbit) -->
        <div class="absolute top-2 left-2 sm:-left-4 z-20 hidden md:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/95 backdrop-blur-md border border-purple-100/90 shadow-[0_8px_20px_-4px_rgba(99,91,255,0.12)] text-xs font-semibold text-[#17172A] animate-chip-drift-1 hover:scale-105 transition-transform duration-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Live sync: <span class="font-bold text-[#635BFF]">99.9% uptime</span></span>
        </div>

        <!-- Floating Playful Micro-Chip (Bottom-Right on Extended Orbit) -->
        <div class="absolute bottom-2 right-2 sm:-right-4 z-20 hidden md:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/95 backdrop-blur-md border border-purple-100/90 shadow-[0_8px_20px_-4px_rgba(99,91,255,0.12)] text-xs font-semibold text-[#17172A] animate-chip-drift-2 hover:scale-105 transition-transform duration-300">
          <span class="text-amber-500">⚡</span>
          <span>Auto-triaged in <span class="font-bold text-[#635BFF]">0.4s</span></span>
        </div>

        <!-- Decorative Playful Sparkles with Twinkle Animation -->
        <span class="absolute top-10 left-6 text-purple-400 font-bold text-base select-none hidden lg:block animate-twinkle-1">✦</span>
        <span class="absolute bottom-10 left-12 text-amber-400 font-bold text-sm select-none hidden lg:block animate-twinkle-2">✦</span>
        <span class="absolute bottom-16 right-8 text-purple-400 font-bold text-sm select-none hidden lg:block animate-twinkle-3">✦</span>

        <!-- MAIN ORBIT RING CONTAINER: The exact circular line where all 8 icons sit (440px) -->
        <div class="relative w-[360px] h-[360px] sm:w-[440px] sm:h-[440px] rounded-full bg-purple-50/40 border border-purple-300/80 flex items-center justify-center animate-orbit-glow">
          
          <!-- Inner Concentric Halo Ring (Pale Purple Core) -->
          <div class="w-[250px] h-[250px] sm:w-[310px] sm:h-[310px] rounded-full bg-purple-100/40 border border-purple-200/50 pointer-events-none absolute -z-0 animate-halo-pulse"></div>

          <!-- Central 3D Ribbon Graphic & Levitation Stage -->
          <div class="relative z-10 w-56 h-44 sm:w-72 sm:h-56 flex items-center justify-center pointer-events-none">
            <!-- Dynamic 3D Floating Ribbon Logo -->
            <div class="relative w-full h-full flex items-center justify-center animate-logo-levitate">
              <img 
                src="/relay-logo.svg" 
                alt="NewRelay Workspace" 
                class="relative z-10 w-full h-full object-contain filter drop-shadow-[0_16px_32px_rgba(99,91,255,0.22)]"
              />
            </div>
            <!-- Soft Dynamic Base Glow / Shadow expanding under the logo -->
            <div class="absolute -bottom-2 w-48 h-10 bg-purple-400/20 rounded-full blur-xl pointer-events-none animate-shadow-breathe -z-10"></div>
          </div>

          <!-- 1. Floating Channel: WhatsApp (Top - 90°) -> left: 50%, top: 0% [GREEN] -->
          <div class="absolute -translate-x-1/2 -translate-y-1/2 z-20" style="left: 50%; top: 0%;">
            <div class="flex flex-col items-center group cursor-pointer animate-float-node-1">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#25D366] shadow-[0_10px_25px_-5px_rgba(37,211,102,0.4),0_4px_10px_-2px_rgba(37,211,102,0.2)] flex items-center justify-center text-white group-hover:scale-115 group-hover:shadow-[0_16px_32px_-4px_rgba(37,211,102,0.55)] transition-all duration-300">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-white" viewBox="0 0 24 24">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.57 14.37C16.32 14.24 15.11 13.65 14.88 13.56C14.66 13.48 14.49 13.44 14.33 13.69C14.16 13.94 13.68 14.51 13.54 14.67C13.39 14.84 13.25 14.86 13 14.73C12.75 14.61 11.95 14.35 11 13.5C10.26 12.84 9.76 12.03 9.61 11.78C9.47 11.53 9.6 11.4 9.72 11.27C9.83 11.16 9.97 10.98 10.1 10.83C10.22 10.68 10.26 10.57 10.35 10.4C10.43 10.24 10.39 10.09 10.33 9.97C10.26 9.84 9.77 8.64 9.57 8.14C9.37 7.66 9.17 7.72 9.02 7.71C8.88 7.71 8.71 7.7 8.55 7.7C8.38 7.7 8.11 7.77 7.89 8.01C7.66 8.25 7.03 8.84 7.03 10.05C7.03 11.26 7.91 12.43 8.03 12.59C8.16 12.76 9.76 15.22 12.21 16.28C12.79 16.53 13.24 16.68 13.6 16.79C14.19 16.98 14.72 16.95 15.14 16.89C15.61 16.82 16.57 16.31 16.77 15.73C16.98 15.16 16.98 14.67 16.91 14.56C16.85 14.46 16.82 14.5 16.57 14.37Z"/>
                </svg>
              </div>
              <span class="text-xs font-bold text-[#17172A] mt-1.5 tracking-tight select-none whitespace-nowrap group-hover:text-[#25D366] transition-colors">WhatsApp</span>
            </div>
          </div>

          <!-- 2. Floating Channel: Meta (Top-Right - 45°) -> left: 85.36%, top: 14.64% [BLUE] -->
          <div class="absolute -translate-x-1/2 -translate-y-1/2 z-20" style="left: 85.36%; top: 14.64%;">
            <div class="flex flex-col items-center group cursor-pointer animate-float-node-2">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-tr from-[#0064e0] to-[#0081fb] shadow-[0_10px_25px_-5px_rgba(0,100,224,0.4),0_4px_10px_-2px_rgba(0,100,224,0.2)] flex items-center justify-center text-white group-hover:scale-115 group-hover:shadow-[0_16px_32px_-4px_rgba(0,100,224,0.55)] transition-all duration-300">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-white" viewBox="0 0 24 24">
                  <path d="M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z"/>
