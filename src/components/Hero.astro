            </div>
          </div>

          <!-- 5. Floating Channel: Instagram (Bottom - 270°) -> left: 50%, top: 100% [GRADIENT MULTI] -->
          <div class="absolute -translate-x-1/2 -translate-y-1/2 z-20" style="left: 50%; top: 100%;">
            <div class="flex flex-col items-center group cursor-pointer animate-float-node-5">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-tr from-[#FFDC80] via-[#FD1D1D] to-[#833AB4] shadow-[0_10px_25px_-5px_rgba(225,48,108,0.4),0_4px_10px_-2px_rgba(225,48,108,0.2)] flex items-center justify-center text-white group-hover:scale-115 group-hover:shadow-[0_16px_32px_-4px_rgba(225,48,108,0.55)] transition-all duration-300">
