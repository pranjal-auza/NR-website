---
import Icon from './icons/Icon.astro';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-attio-grid">
  <!-- Ambient Top Glow -->
  <div class="radial-glow-top"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Header & Value Prop -->
    <div class="text-center max-w-4xl mx-auto space-y-6">
      
      <!-- Enterprise Pill Badge -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full enterprise-card text-xs font-medium text-secondary-fg animate-fade-in">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-foreground font-semibold font-mono">ENTERPRISE REVENUE ENGINE</span>
        <span class="text-weak-stroke">|</span>
        <span class="text-brand-400 font-medium">Captain AI 2.0 Now Available</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-[66px] font-bold tracking-tight leading-[1.08] text-foreground">
        The AI-Native Revenue & <br class="hidden sm:inline" />
        <span class="text-gradient-brand">Omnichannel Engine</span> for Enterprises.
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-lg md:text-xl text-secondary-fg leading-relaxed max-w-2xl mx-auto font-normal">
        Unify WhatsApp, SMS, Live Chat, and Email into a single command center. Automate 70%+ of customer inquiries with autonomous Captain AI agents backed by enterprise SLAs and SOC 2 security.
      </p>

      <!-- Enterprise CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a href="#demo" class="button-primary text-base px-7 py-3.5 rounded-xl shadow-attio-4 w-full sm:w-auto font-medium">
          <span>Start Free Trial</span>
          <Icon name="arrow-right" class="w-4 h-4 ml-2" />
        </a>

        <a href="#demo" class="button-outline text-base px-7 py-3.5 rounded-xl w-full sm:w-auto font-medium flex items-center justify-center gap-2">
          <Icon name="play" class="w-3.5 h-3.5 text-brand-400" />
          <span>Book Enterprise Walkthrough</span>
        </a>
      </div>

      <!-- Institutional Trust Badges Ribbon -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs text-caption-fg">
        <div class="flex items-center gap-1.5 font-medium text-foreground">
          <Icon name="shield" class="w-4 h-4 text-emerald-400" />
          <span>SOC 2 Type II Certified</span>
        </div>
        <div class="flex items-center gap-1.5 font-medium text-foreground">
          <Icon name="lock" class="w-4 h-4 text-emerald-400" />
          <span>HIPAA & GDPR Compliant</span>
        </div>
        <div class="flex items-center gap-1.5 font-medium text-foreground">
          <Icon name="activity" class="w-4 h-4 text-emerald-400" />
          <span>99.99% Carrier Uptime SLA</span>
        </div>
        <div class="flex items-center gap-1.5 font-medium text-foreground">
          <Icon name="database" class="w-4 h-4 text-emerald-400" />
          <span>Zero LLM Data Retention</span>
        </div>
      </div>
    </div>

    <!-- High-Density Enterprise Command Center Mockup -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-2xl enterprise-card overflow-hidden shadow-attio-6 p-1.5 sm:p-2.5">
        
        <!-- App Window Header Bar -->
        <div class="flex items-center justify-between px-3.5 py-2.5 border-b border-subtle-stroke bg-secondary-bg/80 rounded-t-xl text-xs">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
            </div>
            <div class="hidden sm:flex items-center gap-2 pl-2 border-l border-subtle-stroke">
              <span class="px-2 py-0.5 rounded bg-surface font-mono text-[11px] text-foreground font-medium border border-subtle-stroke">
                Acme Global Corp (Enterprise Tier)
              </span>
              <span class="text-caption-fg font-mono text-[11px]">us-east-1 • latency 11ms</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[11px] font-medium border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Captain AI: Autonomous Mode (99.6% Precision)
            </span>
          </div>
        </div>

        <!-- App Workspace Simulated Body -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-0 bg-background/95 min-h-[490px] text-sm">
          
          <!-- Column 1: Omnichannel Left Feed (4 cols) -->
          <div class="md:col-span-4 border-r border-subtle-stroke p-3 space-y-2.5 bg-secondary-bg/30">
            <div class="flex items-center justify-between pb-2 border-b border-subtle-stroke text-xs font-semibold text-caption-fg">
              <span class="uppercase tracking-wider font-mono text-[11px]">Real-Time Priority Stream</span>
              <span class="px-2 py-0.5 rounded-full bg-brand-500/20 text-brand-400 text-[10px] font-mono">12 Ingested / min</span>
            </div>

            <!-- Thread 1: WhatsApp (Active / High Priority) -->
            <div class="p-3 rounded-xl bg-surface border border-brand-500/40 shadow-attio-2 cursor-pointer transition-all hover:border-brand-500 relative">
              <div class="absolute -top-1.5 right-2 px-1.5 py-0.2 rounded bg-brand-500 text-white font-mono text-[9px] font-bold">
                HIGH ACV ($75k)
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
                    WA
                  </div>
                  <div>
                    <div class="font-semibold text-foreground text-xs flex items-center gap-1">
                      <span>Sarah Jenkins</span>
                      <span class="text-emerald-400 text-[10px]">✓</span>
                    </div>
                    <div class="text-[10px] text-caption-fg">VP Technology @ CloudScale Bio</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-emerald-400">SLA: 42s</span>
              </div>
              <p class="text-xs text-secondary-fg mt-2 line-clamp-2">
                "Can Captain AI ingest our custom FHIR/HIPAA data lake before answering client questions?"
              </p>
              <div class="flex items-center gap-1.5 mt-2.5">
                <span class="px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-400 text-[10px] font-medium border border-purple-500/20">Auto-Triaged</span>
                <span class="px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 text-[10px] font-medium font-mono">Deal #9418 Created</span>
              </div>
            </div>

            <!-- Thread 2: SMS Enterprise Lead -->
            <div class="p-3 rounded-xl hover:bg-surface/60 border border-subtle-stroke/60 transition-all cursor-pointer">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-xs">
                    SMS
                  </div>
                  <div>
                    <div class="font-semibold text-foreground text-xs">Marcus Thorne</div>
                    <div class="text-[10px] text-caption-fg">Chief Revenue Officer @ FinTrack</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-caption-fg">2m ago</span>
              </div>
              <p class="text-xs text-secondary-fg mt-1.5 truncate">
                "Contract signed. Ready to provision 40 rep seats."
              </p>
            </div>

            <!-- Thread 3: Video Review Flow -->
            <div class="p-3 rounded-xl hover:bg-surface/60 border border-subtle-stroke/60 transition-all cursor-pointer">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-xs">
                    VID
                  </div>
                  <div>
                    <div class="font-semibold text-foreground text-xs">Elena Rostova</div>
                    <div class="text-[10px] text-caption-fg">VP Customer Success @ Railway</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-amber-400">5.0 ★</span>
              </div>
              <p class="text-xs text-secondary-fg mt-1.5 truncate">
                "Submitted 60s verified video testimonial widget."
              </p>
            </div>
          </div>

          <!-- Column 2: Active Chat / Captain AI Autonomous Resolver (5 cols) -->
          <div class="md:col-span-5 p-4 flex flex-col justify-between border-r border-subtle-stroke bg-background">
            
            <!-- Chat Header -->
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-subtle-stroke text-xs">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-foreground">Session #REL-88219</span>
                <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-medium">WhatsApp Direct API</span>
              </div>
              <span class="text-[10px] font-mono text-caption-fg">Security: 256-Bit Encrypted</span>
            </div>

            <!-- Chat Messages Flow -->
            <div class="space-y-3.5 flex-1">
              
              <!-- Customer Message -->
              <div class="flex items-start gap-2.5 max-w-[92%]">
                <div class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs shrink-0 font-bold">
                  SJ
                </div>
                <div class="p-3.5 rounded-2xl rounded-tl-none bg-surface border border-subtle-stroke text-xs text-foreground space-y-1 shadow-attio-1">
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-semibold text-emerald-400">Sarah Jenkins (via WhatsApp Business)</span>
                    <span class="text-[10px] text-caption-fg font-mono">02:14:08 AM</span>
                  </div>
                  <p class="text-secondary-fg leading-relaxed">
                    We manage 120 global reps across 4 regions. Does New-Relay support multi-tenant role permissions, custom RAG indexing on our internal medical documentation, and direct Salesforce bi-directional sync?
                  </p>
                </div>
              </div>

              <!-- Captain AI Autonomous Reply with Deterministic Guardrails -->
              <div class="flex items-start gap-2.5 max-w-[96%] ml-auto flex-row-reverse">
                <div class="w-7 h-7 rounded-full bg-brand-500 text-white flex items-center justify-center text-xs shrink-0 shadow-attio-2">
                  <Icon name="bot" class="w-4 h-4" />
                </div>
                <div class="p-3.5 rounded-2xl rounded-tr-none bg-brand-500/10 border border-brand-500/30 text-xs text-foreground space-y-2.5 shadow-attio-2">
                  <div class="flex items-center justify-between gap-4">
                    <span class="font-semibold text-brand-400 flex items-center gap-1.5">
                      <Icon name="sparkles" class="w-3.5 h-3.5" />
                      Captain AI Autonomous Reply
                    </span>
                    <span class="text-[10px] text-caption-fg font-mono">Deterministic Guardrail: PASS (99.6%)</span>
                  </div>
                  <p class="text-foreground leading-relaxed">
                    Hello Sarah! Yes, absolutely. New-Relay provides:
                  </p>
                  <ul class="space-y-1 text-secondary-fg pl-1">
                    <li>• <strong>Granular Multi-Tenant RBAC:</strong> Hierarchical regional roles for your 120 reps.</li>
                    <li>• <strong>Universal Context™ RAG:</strong> Secure vector indexing with Zero Data Retention.</li>
                    <li>• <strong>Bi-Directional CRM Sync:</strong> Sub-50ms sync with Salesforce & HubSpot.</li>
                  </ul>
                  
                  <div class="p-2.5 rounded-lg bg-surface/90 border border-subtle-stroke flex items-center justify-between text-[11px]">
                    <div class="flex items-center gap-1.5 text-caption-fg">
                      <Icon name="check-circle" class="w-3.5 h-3.5 text-emerald-400" />
                      <span>Pipeline Action:</span>
                    </div>
                    <span class="text-emerald-400 font-semibold font-mono">Created Opportunity: $75,000 ARR</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Command Composer Bar -->
            <div class="pt-3 mt-3 border-t border-subtle-stroke flex items-center gap-2">
              <div class="flex-1 px-3 py-2 rounded-lg bg-surface border border-subtle-stroke text-xs text-caption-fg flex items-center justify-between">
                <span class="font-mono text-[11px]">Captain AI monitoring in real-time (type '/' for macros)</span>
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-surface-subtle text-foreground border border-subtle-stroke">⌘K</span>
              </div>
              <button class="button-primary p-2 text-xs rounded-lg">
                <Icon name="zap" class="w-3.5 h-3.5" />
              </button>
            </div>
          </div>

          <!-- Column 3: Live CRM 360 & Security Intelligence (3 cols) -->
          <div class="md:col-span-3 p-3.5 bg-secondary-bg/30 space-y-3">
            <div class="text-xs font-semibold text-caption-fg uppercase tracking-wider font-mono text-[11px]">
              Customer 360 & Context™
            </div>

            <!-- Organization Card -->
            <div class="p-3 rounded-xl bg-surface border border-subtle-stroke space-y-2.5">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-brand-500/20 text-brand-400 flex items-center justify-center font-bold text-xs">
                  CS
                </div>
                <div>
                  <div class="text-xs font-bold text-foreground">CloudScale Bio</div>
                  <div class="text-[10px] text-caption-fg">Healthcare Tech • 340 Seats</div>
                </div>
              </div>

              <div class="pt-2 border-t border-subtle-stroke space-y-1.5 text-[11px]">
                <div class="flex justify-between">
                  <span class="text-caption-fg">Deal Pipeline:</span>
                  <span class="font-medium text-brand-400">Enterprise Pilot</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-caption-fg">Contract Value:</span>
                  <span class="font-bold text-foreground font-mono">$75,000 / yr</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-caption-fg">Security Review:</span>
                  <span class="text-emerald-400 font-medium font-mono">SOC 2 In Review ✓</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-caption-fg">AI Intent Score:</span>
                  <span class="text-emerald-400 font-bold font-mono">99.4 / 100 🟢</span>
                </div>
              </div>
            </div>

            <!-- Security Audit Stream -->
            <div class="p-3 rounded-xl bg-surface border border-subtle-stroke space-y-2">
              <div class="text-[10px] font-semibold text-caption-fg uppercase font-mono">Compliance & Audit Log</div>
              <div class="space-y-1 text-[10px] font-mono text-caption-fg">
                <div class="flex items-center justify-between">
                  <span>Zero-Retention Policy</span>
                  <span class="text-emerald-400">Enforced</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Carrier Fallback Route</span>
                  <span class="text-brand-400">Direct Meta API</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>SSO Authentication</span>
                  <span class="text-foreground">Okta / SAML</span>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>
    </div>

    <!-- Enterprise Customer Logos Bar -->
    <div class="mt-16 pt-8 border-t border-subtle-stroke/60 text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-caption-fg mb-6 font-mono">
        Trusted by high-growth revenue leaders, sales engineering teams, and global enterprises
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="font-display font-bold text-lg tracking-tight text-foreground">LINEAR</span>
        <span class="font-display font-bold text-lg tracking-tight text-foreground">MODAL</span>
        <span class="font-display font-bold text-lg tracking-tight text-foreground">GRANOLA</span>
        <span class="font-display font-bold text-lg tracking-tight text-foreground">RAILWAY</span>
        <span class="font-display font-bold text-lg tracking-tight text-foreground">TASKRABBIT</span>
        <span class="font-display font-bold text-lg tracking-tight text-foreground">STRIPE</span>
      </div>
    </div>

  </div>
</section>
