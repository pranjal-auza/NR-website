          <!-- 8. Floating Channel: Messenger (Top-Left - 135°) -> left: 14.64%, top: 14.64% [GRADIENT PURPLE/PINK] -->
          <div class="absolute -translate-x-1/2 -translate-y-1/2 z-20" style="left: 14.64%; top: 14.64%;">
            <div class="flex flex-col items-center group cursor-pointer animate-float-node-8">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-tr from-[#0084FF] via-[#A824FF] to-[#FF4E72] shadow-[0_10px_25px_-5px_rgba(0,132,255,0.4),0_4px_10px_-2px_rgba(0,132,255,0.2)] flex items-center justify-center text-white group-hover:scale-115 group-hover:shadow-[0_16px_32px_-4px_rgba(0,132,255,0.55)] transition-all duration-300">
                <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-white" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.03 2 11c0 2.87 1.48 5.43 3.79 7.08V22l3.63-1.99c.82.23 1.68.35 2.58.35 5.52 0 10-4.03 10-9s-4.48-9-10-9zm1.09 12.11l-2.61-2.78-5.1 2.78 5.61-5.95 2.67 2.78 5.04-2.78-5.61 5.95z"/>
