              </div>
              <span class="text-xs font-bold text-[#17172A] mt-1.5 tracking-tight select-none whitespace-nowrap group-hover:text-[#0064e0] transition-colors">Meta</span>
            </div>
          </div>

          <!-- 3. Floating Channel: Reviews (Right - 0°) -> left: 100%, top: 50% [GOLD] -->
          <div class="absolute -translate-x-1/2 -translate-y-1/2 z-20" style="left: 100%; top: 50%;">
            <div class="flex flex-col items-center group cursor-pointer animate-float-node-3">
