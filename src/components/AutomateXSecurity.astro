---
// AutomateX Security & Privacy Section
---

<section class="relative py-20 md:py-28 overflow-hidden bg-[#FAF8F5]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: 3 Security Cards Stack / Showcase (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        
        <!-- Card 1: Audit everything -->
        <div class="bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-7 shadow-[0_12px_30px_rgba(20,15,40,0.04)] hover:shadow-[0_18px_40px_rgba(99,91,255,0.08)] transition-all duration-300 flex items-start gap-4 sm:gap-5">
          <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200 text-[#5925DC] flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="space-y-1.5 text-left">
            <h3 class="text-lg sm:text-xl font-bold text-[#100F12] font-['Plus_Jakarta_Sans']">
              Audit everything
            </h3>
            <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed">
              Deep insight and auditing into what agents do, what context they use, and what triggers human escalations.
            </p>
          </div>
        </div>

        <!-- Card 2: Zero data retention & training -->
        <div class="bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-7 shadow-[0_12px_30px_rgba(20,15,40,0.04)] hover:shadow-[0_18px_40px_rgba(99,91,255,0.08)] transition-all duration-300 flex items-start gap-4 sm:gap-5">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div class="space-y-1.5 text-left">
            <h3 class="text-lg sm:text-xl font-bold text-[#100F12] font-['Plus_Jakarta_Sans']">
              Zero data retention & training
            </h3>
            <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed">
              Keep sensitive information out of model training and control retention policies strictly based on your compliance guidelines.
            </p>
          </div>
        </div>

        <!-- Card 3: Reflection loops -->
        <div class="bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-7 shadow-[0_12px_30px_rgba(20,15,40,0.04)] hover:shadow-[0_18px_40px_rgba(99,91,255,0.08)] transition-all duration-300 flex items-start gap-4 sm:gap-5">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
          </div>
          <div class="space-y-1.5 text-left">
            <h3 class="text-lg sm:text-xl font-bold text-[#100F12] font-['Plus_Jakarta_Sans']">
              Reflection loops
            </h3>
            <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed">
              Continuous reflection loops that help agents self-evaluate outputs before execution, guaranteeing consistent high quality.
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Heading, CTA & Trust Badges (5 cols) -->
      <div class="lg:col-span-5 space-y-6 text-left">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-purple-200 bg-purple-50/60 text-xs sm:text-sm font-semibold text-[#5B21B6]">
          <span>Enterprise Security</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#100F12] tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
          Built for control, privacy, and accountability
        </h2>

        <p class="text-sm sm:text-base text-[#5F5E6E] leading-relaxed">
          Agents are designed to operate strictly within your custom boundaries, backed by real-time audit logs and human-in-the-loop oversight.
        </p>

        <div class="pt-2">
          <a href="#pricing" class="btn-text-roll group inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[#100F12] text-white font-semibold text-xs sm:text-sm hover:bg-[#23222A] transition-all shadow-md">
            <div class="button-text-wrap">
              <span class="text-default">Get started now</span>
              <span class="text-hover">Get started now</span>
            </div>
          </a>
        </div>

        <!-- Security Certification / Badges -->
        <div class="pt-6 border-t border-slate-200/80 flex items-center gap-6 opacity-75 grayscale hover:grayscale-0 transition-all">
          <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d6ddc19379cf37d7ad8fb_6af8a9adf453bf9acc2e6db9bdc065a0_security%20icon1.svg" alt="Security 1" class="h-8 w-auto object-contain" />
          <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d6e24fc4dde5184a3a784_f71d5f8071d9fac0a10a7cf90145e443_security%20icon2.svg" alt="Security 2" class="h-8 w-auto object-contain" />
          <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d6ddceecd724a61d94ef5_security%20icon3.svg" alt="Security 3" class="h-8 w-auto object-contain" />
        </div>

      </div>

    </div>

  </div>
</section>
