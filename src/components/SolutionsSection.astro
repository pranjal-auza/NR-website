---
// Solutions Section — CENTERED + 4-COLUMN CARD GRID COMPOSITION
const solutions = [
  {
    title: 'E-commerce & D2C',
    badge: 'Retail',
    badgeColor: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    iconBg: 'bg-[#EEFAF5] text-emerald-600',
    headline: 'Recover carts & answer pre-purchase inquiries instantly.',
    features: ['Shopify live order sync', 'Automated abandoned cart WhatsApps', 'Instant return / refund triage'],
    metric: '+38% repeat purchases',
  },
  {
    title: 'Real Estate & Builders',
    badge: 'High Value',
    badgeColor: 'bg-purple-50 text-purple-700 border-purple-200',
    iconBg: 'bg-[#F2EEFF] text-[#635BFF]',
    headline: 'Qualify buyer intent & schedule site visits in real time.',
    features: ['Instant property brochure delivery', 'Lead qualification bots', 'Sales executive call routing'],
    metric: '3.4x faster site bookings',
  },
  {
    title: 'Healthcare & Clinics',
    badge: 'Care',
    badgeColor: 'bg-rose-50 text-rose-700 border-rose-200',
    iconBg: 'bg-[#FFF0F6] text-rose-600',
    headline: 'Deliver 24/7 patient appointments & prescription reminders.',
    features: ['Doctor schedule sync', 'Automated appointment reminders', 'Confidential chat security'],
    metric: '94% reduction in no-shows',
  },
  {
    title: 'Agencies & Consultancies',
    badge: 'Multi-Client',
    badgeColor: 'bg-amber-50 text-amber-700 border-amber-200',
    iconBg: 'bg-[#FFF9E8] text-amber-600',
    headline: 'Manage client accounts with segregated workspace permissions.',
    features: ['Multi-brand unified inboxes', 'Role-based agent access', 'Custom branded client analytics'],
    metric: '10+ brands in one seat',
  },
];
---

<section id="solutions" class="py-20 md:py-32 bg-[#FCFCFA] border-b border-[#E9E9EF]/60 relative overflow-hidden">
  <!-- Subtle Peach/Warm Atmospheric Glow -->
  <div class="absolute top-1/3 right-1/4 w-[750px] h-[400px] bg-[#FFF9E8]/60 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Centered Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-18">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFF9E8] border border-[#FFE8A3] text-xs font-bold tracking-wider text-amber-800 uppercase mb-4">
        <span>Tailored Workspaces</span>
      </div>

      <h2 class="text-4xl sm:text-6xl font-extrabold text-[#17172A] tracking-[-0.04em] leading-[1.02] font-['Plus_Jakarta_Sans']">
        Engineered for <br />
        <span class="text-[#17172A]">high-velocity teams.</span>
      </h2>

      <p class="text-base sm:text-lg text-[#656579] leading-relaxed mt-5 max-w-2xl mx-auto">
        Whether you are scaling direct-to-consumer retail, booking real estate site visits, or managing multi-brand agency portfolios, NewRelay adapts directly to your workflows.
      </p>
    </div>

    <!-- 2. 4-Column Responsive Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {solutions.map((item) => (
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[22px] flex flex-col justify-between hover:border-[#635BFF]/40 hover:shadow-lg transition-all duration-200 group">
          
          <div>
            <!-- Card Top: Icon & Badge -->
            <div class="flex items-center justify-between mb-5">
              <div class={`w-11 h-11 rounded-2xl ${item.iconBg} flex items-center justify-center font-bold text-lg`}>
                {item.title.startsWith('E-com') ? '🛍️' : item.title.startsWith('Real') ? '🏢' : item.title.startsWith('Health') ? '🩺' : '💼'}
              </div>
              <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${item.badgeColor}`}>
                {item.badge}
              </span>
            </div>

            <!-- Title & Pitch -->
            <h3 class="text-lg font-bold text-[#17172A] font-['Plus_Jakarta_Sans'] group-hover:text-[#635BFF] transition-colors">
              {item.title}
            </h3>
            
            <p class="text-xs text-[#656579] mt-2 leading-relaxed">
              {item.headline}
            </p>

            <!-- Feature Bullet points -->
            <div class="space-y-2 mt-5 pt-4 border-t border-[#E9E9EF]">
              {item.features.map((feat) => (
                <div class="flex items-center gap-2 text-xs text-[#17172A] font-medium">
                  <svg class="w-3.5 h-3.5 text-[#635BFF] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Stat Highlight -->
          <div class="mt-6 pt-4 border-t border-[#E9E9EF]/60 flex items-center justify-between">
            <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-100">
              {item.metric}
            </span>
            <span class="text-xs text-[#635BFF] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              <span>Learn more</span>
              <span>→</span>
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
