---
import Icon from './icons/Icon.astro';
---

<section id="comparison" class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold uppercase tracking-wider border border-blue-500/20 font-mono">
        <Icon name="zap" class="w-3.5 h-3.5" />
        <span>Stack Consolidation & ROI</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        Replace 5 fragmented tools. <br />
        <span class="text-gradient-brand">Accelerate revenue by 3x.</span>
      </h2>

      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        Stop duct-taping disconnected point solutions with brittle webhooks. New-Relay consolidates your entire revenue stack into a unified intelligent operating system.
      </p>
    </div>

    <!-- Comparison Matrix Table -->
    <div class="max-w-5xl mx-auto rounded-2xl enterprise-card overflow-hidden shadow-attio-5">
      
      <!-- Table Header -->
      <div class="grid grid-cols-12 p-4 sm:p-6 bg-secondary-bg/80 border-b border-subtle-stroke text-xs sm:text-sm font-semibold">
        <div class="col-span-4 text-caption-fg uppercase tracking-wider font-mono text-[11px]">
          Enterprise Capability
        </div>
        <div class="col-span-4 text-secondary-fg text-center">
          Legacy Fragmented Stack <br class="sm:hidden" />
          <span class="text-[10px] text-caption-fg font-normal font-mono">(Intercom + HubSpot + Zapier + Twilio)</span>
        </div>
        <div class="col-span-4 text-brand-400 text-center font-bold flex items-center justify-center gap-1.5">
          <div class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></div>
          <span>New-Relay Enterprise OS</span>
        </div>
      </div>

      <!-- Table Rows -->
      <div class="divide-y divide-subtle-stroke text-xs sm:text-sm">
        
        <!-- Row 1: Omnichannel Ingestion -->
        <div class="grid grid-cols-12 p-4 sm:p-5 items-center hover:bg-surface/40 transition-colors">
          <div class="col-span-4 font-semibold text-foreground space-y-0.5">
            <div>Omnichannel Ingestion</div>
            <div class="text-[11px] text-caption-fg hidden sm:block">WhatsApp, SMS, Email, Live Chat</div>
          </div>
          <div class="col-span-4 text-secondary-fg text-center text-xs space-y-1">
            <span class="inline-block px-2 py-0.5 rounded bg-red-500/10 text-red-400 font-mono text-[10px]">3 Disconnected Apps</span>
            <div class="hidden sm:block text-[11px] text-caption-fg">Manual context switching across tabs</div>
          </div>
          <div class="col-span-4 text-center font-medium text-foreground bg-brand-500/5 p-2 rounded-lg border border-brand-500/20">
            <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono text-[11px] font-semibold">Unified Stream</span>
            <div class="text-[11px] text-brand-400 mt-0.5 font-mono">Sub-50ms carrier delivery</div>
          </div>
        </div>

        <!-- Row 2: Autonomous Speed to Lead -->
        <div class="grid grid-cols-12 p-4 sm:p-5 items-center hover:bg-surface/40 transition-colors">
          <div class="col-span-4 font-semibold text-foreground space-y-0.5">
            <div>Speed to Lead & AI Resolution</div>
            <div class="text-[11px] text-caption-fg hidden sm:block">Lead triage & automated responses</div>
          </div>
          <div class="col-span-4 text-secondary-fg text-center text-xs space-y-1">
            <span class="inline-block px-2 py-0.5 rounded bg-red-500/10 text-red-400 font-mono text-[10px]">15–45 min Human Lag</span>
            <div class="hidden sm:block text-[11px] text-caption-fg">Simple keyword decision trees</div>
          </div>
          <div class="col-span-4 text-center font-medium text-foreground bg-brand-500/5 p-2 rounded-lg border border-brand-500/20">
            <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono text-[11px] font-semibold">&lt; 10s Captain AI Resolution</span>
            <div class="text-[11px] text-brand-400 mt-0.5 font-mono">99.6% Deterministic Accuracy</div>
          </div>
        </div>

        <!-- Row 3: CRM Synchronization -->
        <div class="grid grid-cols-12 p-4 sm:p-5 items-center hover:bg-surface/40 transition-colors">
          <div class="col-span-4 font-semibold text-foreground space-y-0.5">
            <div>CRM & Deal Pipeline Sync</div>
            <div class="text-[11px] text-caption-fg hidden sm:block">Deal creation & stage tracking</div>
          </div>
          <div class="col-span-4 text-secondary-fg text-center text-xs space-y-1">
            <span class="inline-block px-2 py-0.5 rounded bg-red-500/10 text-red-400 font-mono text-[10px]">Fragile Zapier Connectors</span>
            <div class="hidden sm:block text-[11px] text-caption-fg">Frequent API rate-limit drops</div>
          </div>
          <div class="col-span-4 text-center font-medium text-foreground bg-brand-500/5 p-2 rounded-lg border border-brand-500/20">
            <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono text-[11px] font-semibold">Native Bi-directional Engine</span>
            <div class="text-[11px] text-brand-400 mt-0.5 font-mono">Automatic ARR Attribution</div>
          </div>
        </div>

        <!-- Row 4: Video Social Proof & Reviews -->
        <div class="grid grid-cols-12 p-4 sm:p-5 items-center hover:bg-surface/40 transition-colors">
          <div class="col-span-4 font-semibold text-foreground space-y-0.5">
            <div>Reputation & Video Proof</div>
            <div class="text-[11px] text-caption-fg hidden sm:block">Customer video review gathering</div>
          </div>
          <div class="col-span-4 text-secondary-fg text-center text-xs space-y-1">
            <span class="inline-block px-2 py-0.5 rounded bg-red-500/10 text-red-400 font-mono text-[10px]">Add-on Tool ($400/mo)</span>
            <div class="hidden sm:block text-[11px] text-caption-fg">Separate login and disjointed data</div>
          </div>
          <div class="col-span-4 text-center font-medium text-foreground bg-brand-500/5 p-2 rounded-lg border border-brand-500/20">
            <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono text-[11px] font-semibold">Built-in 60s Video Engine</span>
            <div class="text-[11px] text-brand-400 mt-0.5 font-mono">SMS & WhatsApp auto-triggers</div>
          </div>
        </div>

        <!-- Row 5: Total Cost of Ownership -->
        <div class="grid grid-cols-12 p-4 sm:p-5 items-center bg-secondary-bg/60">
          <div class="col-span-4 font-bold text-foreground">
            Total Annual Cost
          </div>
          <div class="col-span-4 text-center">
            <span class="text-base sm:text-lg font-bold text-red-400 font-mono">~$42,000 / yr</span>
            <div class="text-[10px] text-caption-fg">5 SaaS vendor bills + maintenance</div>
          </div>
          <div class="col-span-4 text-center bg-brand-500/10 p-2.5 rounded-xl border border-brand-500/30">
            <span class="text-base sm:text-lg font-bold text-emerald-400 font-mono">~$14,400 / yr</span>
            <div class="text-[11px] text-emerald-400 font-bold font-mono">Save 65%+ ($27,600 / yr)</div>
          </div>
        </div>

      </div>

      <!-- Footer Callout -->
      <div class="p-6 bg-surface border-t border-subtle-stroke flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <div class="font-bold text-foreground text-sm">Ready to migrate your team in under 2 hours?</div>
          <div class="text-xs text-secondary-fg">We provide 1-click import scripts for Intercom, HubSpot, Zendesk, and Salesforce.</div>
        </div>
        <a href="#demo" class="button-primary text-xs sm:text-sm shadow-attio-2 shrink-0">
          <span>Start Free Migration</span>
          <Icon name="arrow-right" class="w-4 h-4 ml-1.5" />
        </a>
      </div>

    </div>

  </div>
</section>
