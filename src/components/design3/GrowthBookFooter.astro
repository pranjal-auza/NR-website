---
---

<footer class="bg-[#090812] text-white border-t border-white/10 pt-20 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    
    <!-- Bottom High-Impact CTA Block -->
    <div class="rounded-3xl bg-gradient-to-b from-[#151E3D] to-[#0D1326] border border-white/10 p-8 sm:p-14 text-center space-y-6 relative overflow-hidden shadow-2xl">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#6E56CF]/30 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#6E56CF]/20 text-[#A79BE6] font-mono text-xs font-semibold uppercase tracking-wider">
          Get Started in Minutes
        </span>

        <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
          Ready to build smarter and ship safely?
        </h2>

        <p class="text-sm sm:text-base text-neutral-300 max-w-xl mx-auto leading-relaxed">
          Join 3,000+ modern engineering and data science teams who scale testing without sending their data to third-party clouds.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a 
            href="#demo" 
            class="px-7 py-3.5 rounded-xl border border-white/20 bg-white/5 hover:bg-white/10 text-white font-semibold text-sm transition-all w-full sm:w-44"
          >
            Book a Demo
          </a>

          <a 
            href="https://app.growthbook.io" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-7 py-3.5 rounded-xl bg-[#6E56CF] hover:bg-[#5643B8] text-white font-semibold text-sm transition-all shadow-lg shadow-[#6E56CF]/25 w-full sm:w-48 flex items-center justify-center gap-2"
          >
            <span>Start for Free</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 5-Column Navigation Grid (Exact GrowthBook Sitemap) -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-xs text-neutral-400">
      
      <!-- Col 1: Brand Info -->
      <div class="col-span-2 md:col-span-1 space-y-4">
        <a href="/design-3" class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-[#6E56CF] flex items-center justify-center text-white">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
              <path d="M10 2v7.31M14 2v7.31M8.5 2h7M14 9.3a6.5 6.5 0 1 1-4 0"/>
            </svg>
          </div>
          <span class="font-bold text-base text-white">GrowthBook</span>
        </a>
        <p class="text-xs text-neutral-400 leading-relaxed">
          The open source, warehouse-native experimentation and feature flagging platform.
        </p>
        <div class="pt-2 font-mono text-[11px] text-neutral-500">
          SOC 2 Type II Certified ✓
        </div>
      </div>

      <!-- Col 2: Products -->
      <div class="space-y-3">
        <div class="font-bold font-mono text-white text-xs uppercase tracking-wider">Products</div>
        <ul class="space-y-2">
          <li><a href="#experimentation" class="hover:text-white transition-colors">Experimentation</a></li>
          <li><a href="#feature-flags" class="hover:text-white transition-colors">Feature Flags</a></li>
          <li><a href="#analytics" class="hover:text-white transition-colors">Product Analytics</a></li>
          <li><a href="#integrations" class="hover:text-white transition-colors">Warehouse Native</a></li>
          <li><a href="#integrations" class="hover:text-white transition-colors">Client SDKs</a></li>
          <li><a href="https://docs.growthbook.io/self-host" class="hover:text-white transition-colors">Self-Hosted Option</a></li>
        </ul>
      </div>

      <!-- Col 3: Solutions -->
      <div class="space-y-3">
        <div class="font-bold font-mono text-white text-xs uppercase tracking-wider">Solutions</div>
        <ul class="space-y-2">
          <li><a href="#persona-tabs" class="hover:text-white transition-colors">For Engineers</a></li>
          <li><a href="#persona-tabs" class="hover:text-white transition-colors">For Product Teams</a></li>
          <li><a href="#persona-tabs" class="hover:text-white transition-colors">For Data Teams</a></li>
          <li><a href="#persona-tabs" class="hover:text-white transition-colors">For Growth Teams</a></li>
          <li><a href="#case-studies" class="hover:text-white transition-colors">Fintech</a></li>
          <li><a href="#case-studies" class="hover:text-white transition-colors">Healthtech</a></li>
        </ul>
      </div>

      <!-- Col 4: Resources -->
      <div class="space-y-3">
        <div class="font-bold font-mono text-white text-xs uppercase tracking-wider">Resources</div>
        <ul class="space-y-2">
          <li><a href="#case-studies" class="hover:text-white transition-colors">Customer Stories</a></li>
          <li><a href="https://docs.growthbook.io/" target="_blank" class="hover:text-white transition-colors">Documentation</a></li>
          <li><a href="/pricing" class="hover:text-white transition-colors">ROI Calculator</a></li>
          <li><a href="https://github.com/growthbook/growthbook/releases" target="_blank" class="hover:text-white transition-colors">Product Releases</a></li>
          <li><a href="https://github.com/growthbook/growthbook" target="_blank" class="hover:text-white transition-colors">GitHub Repository</a></li>
          <li><a href="https://slack.growthbook.io/" target="_blank" class="hover:text-white transition-colors">Slack Community</a></li>
        </ul>
      </div>

      <!-- Col 5: Company & Legal -->
      <div class="space-y-3">
        <div class="font-bold font-mono text-white text-xs uppercase tracking-wider">Company</div>
        <ul class="space-y-2">
          <li><a href="#demo" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors">Careers (We're Hiring)</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors">Security &amp; Compliance</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors">Contact Support</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Socials -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 font-mono">
      <div>
        © {new Date().getFullYear()} GrowthBook, Inc. Replicated for Design 3. All rights reserved.
      </div>

      <div class="flex items-center gap-4">
        <a href="https://github.com/growthbook/growthbook" target="_blank" class="hover:text-white transition-colors">GitHub</a>
        <a href="https://twitter.com/growthbook" target="_blank" class="hover:text-white transition-colors">Twitter / X</a>
        <a href="https://linkedin.com/company/growthbook" target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
        <a href="https://slack.growthbook.io/" target="_blank" class="hover:text-white transition-colors">Slack</a>
      </div>
    </div>

  </div>
</footer>
