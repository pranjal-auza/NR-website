---
import Icon from '../icons/Icon.astro';
---

<section id="solutions" class="py-24 border-t border-subtle-stroke relative overflow-hidden bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl space-y-4 mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-surface border border-subtle-stroke text-xs font-mono font-medium text-foreground">
        <span>EXECUTIVE STAKEHOLDER SOLUTIONS</span>
      </div>

      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-foreground">
        Engineered for every enterprise leader.
      </h2>

      <p class="text-base sm:text-lg text-secondary-fg leading-relaxed">
        Whether you are optimizing pipeline velocity, support margins, or regulatory compliance, New-Relay delivers measurable ROI.
      </p>
    </div>

    <!-- 3 Executive Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- CRO Column -->
      <div class="p-8 rounded-2xl border border-subtle-stroke bg-secondary-bg/30 space-y-6 hover:border-brand-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-400 flex items-center justify-center font-mono font-bold text-sm border border-brand-500/20">
            CRO
          </div>
          <h3 class="font-serif text-2xl font-normal text-foreground">For Chief Revenue Officers</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Eliminate the 45-minute response lag that kills inbound conversion. Captain AI engages WhatsApp & SMS prospects at 2am, qualifies budget, and books meetings on your reps' calendars instantly.
          </p>

          <ul class="space-y-2 text-xs text-foreground pt-2 font-mono">
            <li class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>+142% Inbound Pipeline Conversion</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>Sub-10s Speed-to-Lead Response</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>Automatic ARR Attribution in CRM</span>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-subtle-stroke text-[11px] font-mono text-brand-400">
          Metric: $1.4B+ Pipeline Influenced
        </div>
      </div>

      <!-- VP Support Column -->
      <div class="p-8 rounded-2xl border border-subtle-stroke bg-secondary-bg/30 space-y-6 hover:border-purple-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-mono font-bold text-sm border border-purple-500/20">
            OPS
          </div>
          <h3 class="font-serif text-2xl font-normal text-foreground">For Support & Ops Leaders</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Resolve 70%+ of routine customer inquiries autonomously without burning out your team. Collaborative inbox with collision locking prevents embarrassing duplicate answers across channels.
          </p>

          <ul class="space-y-2 text-xs text-foreground pt-2 font-mono">
            <li class="flex items-center gap-2">
              <span class="text-purple-400">✓</span>
              <span>-68% Average Resolution Time</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-purple-400">✓</span>
              <span>Real-Time Collision Locking</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-purple-400">✓</span>
              <span>AI Copilot One-Click Draft Suggestions</span>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-subtle-stroke text-[11px] font-mono text-purple-400">
          Metric: 180M+ Monthly Conversations
        </div>
      </div>

      <!-- CISO Column -->
      <div class="p-8 rounded-2xl border border-subtle-stroke bg-secondary-bg/30 space-y-6 hover:border-emerald-500/40 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-mono font-bold text-sm border border-emerald-500/20">
            SEC
          </div>
          <h3 class="font-serif text-2xl font-normal text-foreground">For Security & Compliance Officers</h3>
          <p class="text-xs sm:text-sm text-secondary-fg leading-relaxed">
            Deploy AI with uncompromising data isolation. Zero customer data retention for model training, custom VPC hosting, HIPAA BAA agreements, and real-time audit logging to Datadog.
          </p>

          <ul class="space-y-2 text-xs text-foreground pt-2 font-mono">
            <li class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>SOC 2 Type II & HIPAA BAA Signed</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>Zero LLM Data Retention Guarantee</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>Private VPC & BYOK Encryption</span>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-subtle-stroke text-[11px] font-mono text-emerald-400">
          Metric: 99.99% Carrier SLA Guarantee
        </div>
      </div>

    </div>

  </div>
</section>
