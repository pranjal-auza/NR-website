---
---

<section class="py-20 md:py-28 bg-[#151E3D] text-white relative overflow-hidden transition-colors">
  
  <!-- Subtle Gradient Lighting -->
  <div class="absolute top-0 right-1/4 w-[600px] h-[300px] bg-[#6E56CF]/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-16">
    
    <!-- Top Stats Counter Strip (Exact GrowthBook Stats) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center pb-14 border-b border-white/10">
      
      <div class="space-y-1">
        <div class="text-4xl sm:text-5xl lg:text-6xl font-black font-mono text-[#A79BE6]">
          1T+
        </div>
        <div class="text-xs sm:text-sm font-mono text-neutral-400 uppercase tracking-wider">
          Feature flag lookups per day
        </div>
      </div>

      <div class="space-y-1">
        <div class="text-4xl sm:text-5xl lg:text-6xl font-black font-mono text-[#A79BE6]">
          5x
        </div>
        <div class="text-xs sm:text-sm font-mono text-neutral-400 uppercase tracking-wider">
          More experiments run
        </div>
      </div>

      <div class="space-y-1">
        <div class="text-4xl sm:text-5xl lg:text-6xl font-black font-mono text-emerald-400">
          1/2
        </div>
        <div class="text-xs sm:text-sm font-mono text-neutral-400 uppercase tracking-wider">
          The cost of legacy solutions
        </div>
      </div>

    </div>

    <!-- Dual Deployment Architecture Cards (Cloud vs Self-Hosted) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      
      <!-- Card 1: GrowthBook Cloud -->
      <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-[#6E56CF] transition-all space-y-6 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#6E56CF]/20 text-[#A79BE6] flex items-center justify-center text-xl font-bold">
            ☁
          </div>
          
          <h3 class="font-sans text-2xl sm:text-3xl font-bold text-white">
            GrowthBook Cloud
          </h3>

          <p class="text-sm text-neutral-300 leading-relaxed">
            Instant updates, automated backups, zero maintenance, and warehouse-native performance hosted on isolated SOC 2 Type II infrastructure.
          </p>

          <ul class="space-y-2 text-xs text-neutral-300 font-mono">
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">✓</span> 99.99% Global Uptime SLA</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">✓</span> Auto-scaling edge evaluations</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">✓</span> Free tier with generous limits</li>
          </ul>
        </div>

        <a 
          href="https://app.growthbook.io" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#6E56CF] hover:bg-[#5643B8] text-white text-xs sm:text-sm font-semibold transition-all shadow-md"
        >
          <span>Start for Free</span>
          <span>→</span>
        </a>
      </div>

      <!-- Card 2: Self-Hosted GrowthBook -->
      <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-[#6E56CF] transition-all space-y-6 flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl font-bold">
            ⚡
          </div>
          
          <h3 class="font-sans text-2xl sm:text-3xl font-bold text-white">
            Self-Hosted GrowthBook
          </h3>

          <p class="text-sm text-neutral-300 leading-relaxed">
            Same features, same enterprise capabilities, 100% running in your private VPC, Kubernetes cluster, or on-premises environment.
          </p>

          <ul class="space-y-2 text-xs text-neutral-300 font-mono">
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">✓</span> 100% Open source &amp; transparent</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">✓</span> Air-gapped &amp; HIPAA compliant</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400 font-bold">✓</span> Docker &amp; Helm chart deployment</li>
          </ul>
        </div>

        <a 
          href="https://docs.growthbook.io/self-host" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-white/20 bg-white/10 hover:bg-white/20 text-white text-xs sm:text-sm font-semibold transition-all"
        >
          <span>Download Now (GitHub)</span>
          <span>→</span>
        </a>
      </div>

    </div>

  </div>
</section>
