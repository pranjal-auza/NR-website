---
const cases = [
  {
    company: "DROPBOX",
    metric: "3 billion",
    label: "feature evaluations daily",
    headline: "Dropbox uses GrowthBook to safely drive AI product development",
    tag: "Enterprise Scale"
  },
  {
    company: "BREEZE AIRWAYS",
    metric: "$1MM+",
    label: "incremental monthly revenue",
    headline: "Breeze Airways scales testing, avoids mistakes, and unlocks millions",
    tag: "Revenue Impact"
  },
  {
    company: "TODAYTIX",
    metric: "24%",
    label: "page view lift",
    headline: "TodayTix scales poster experimentation and lifts show page views",
    tag: "Conversion Lift"
  },
  {
    company: "KHAN ACADEMY",
    metric: "+6.1%",
    label: "correctness lift",
    headline: "Khan Academy uses GrowthBook to improve AI tutoring algorithms",
    tag: "AI Optimization"
  },
  {
    company: "FYXER",
    metric: "5% to 35%",
    label: "paid conversion rate",
    headline: "How Fyxer used AI experimentation to grow from $1M to $35M ARR",
    tag: "ARR Growth"
  },
  {
    company: "LINGOKIDS",
    metric: "3.5M+",
    label: "customers benefiting from tests",
    headline: "Lingokids advances monetization experimentation across mobile",
    tag: "Mobile Scale"
  }
];
---

<section id="case-studies" class="py-20 md:py-28 bg-[#F6F2FD]/50 dark:bg-[#0C0B18] border-t border-[#EEEEF2] dark:border-[#1E2538] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div class="space-y-2">
        <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#6E56CF] dark:text-[#A79BE6]">
          Proven Impact
        </div>
        <h2 class="font-sans text-3xl sm:text-4xl font-extrabold tracking-tight text-[#151E3D] dark:text-white">
          Teams shipping today at the speed of AI
        </h2>
      </div>

      <a 
        href="#demo" 
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#6E56CF] dark:text-[#A79BE6] hover:underline"
      >
        <span>Read Customer Stories</span>
        <span>→</span>
      </a>
    </div>

    <!-- Case Studies Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cases.map((item) => (
        <div class="p-6 rounded-2xl bg-white dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] hover:border-[#6E56CF] dark:hover:border-[#6E56CF] shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between space-y-6 group cursor-pointer">
          
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-sans font-black tracking-tight text-sm text-[#151E3D] dark:text-white">
                {item.company}
              </span>
              <span class="px-2 py-0.5 rounded-full bg-[#6E56CF]/10 text-[#6E56CF] dark:text-[#A79BE6] font-mono text-[10px] font-bold">
                {item.tag}
              </span>
            </div>

            <p class="text-sm font-semibold text-[#151E3D] dark:text-neutral-200 leading-snug group-hover:text-[#6E56CF] dark:group-hover:text-[#A79BE6] transition-colors">
              "{item.headline}"
            </p>
          </div>

          <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800/80 flex items-baseline justify-between">
            <div>
              <div class="text-2xl font-black font-mono text-[#6E56CF] dark:text-[#A79BE6]">
                {item.metric}
              </div>
              <div class="text-[11px] text-neutral-500 font-mono">
                {item.label}
              </div>
            </div>

            <span class="text-xs text-neutral-400 group-hover:text-[#6E56CF] group-hover:translate-x-0.5 transition-all">
              →
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
