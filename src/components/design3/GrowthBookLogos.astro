---
const logos = [
  "DROPBOX", "MISTRAL AI", "SONY", "TYPEFORM", "DEEZER", 
  "CLICKUP", "WIKIPEDIA", "QUIZLET", "BREEZE AIRWAYS", 
  "KHAN ACADEMY", "PEPSI", "OPERA", "MASTERCLASS", "UPSTART", "LA TIMES"
];
---

<section class="py-14 border-t border-b border-[#EEEEF2] dark:border-[#1E2538] bg-white dark:bg-[#0C0B18] overflow-hidden transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-8">
    <h2 class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-[#62627A] dark:text-neutral-400 font-mono">
      Trusted by 3,000+ companies worldwide
    </h2>
  </div>

  <!-- Infinite Logo Marquee with Smooth CSS Mask -->
  <div class="relative w-full overflow-hidden" style="mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);">
    <div class="flex items-center gap-12 sm:gap-16 whitespace-nowrap animate-marquee">
      <!-- First set -->
      {logos.map(logo => (
        <div class="font-sans font-black tracking-tighter text-lg sm:text-xl text-[#151E3D]/50 dark:text-white/40 hover:text-[#6E56CF] dark:hover:text-white transition-colors duration-200 cursor-pointer select-none">
          {logo}
        </div>
      ))}
      <!-- Duplicate for infinite seamless loop -->
      {logos.map(logo => (
        <div class="font-sans font-black tracking-tighter text-lg sm:text-xl text-[#151E3D]/50 dark:text-white/40 hover:text-[#6E56CF] dark:hover:text-white transition-colors duration-200 cursor-pointer select-none">
          {logo}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  .animate-marquee {
    display: flex;
    width: max-content;
    animation: marquee 35s linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
