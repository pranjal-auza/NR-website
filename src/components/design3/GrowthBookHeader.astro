---
import Icon from '../icons/Icon.astro';
---

<header class="sticky top-0 z-40 w-full border-b border-[#EEEEF2] dark:border-[#1E2538] bg-white/90 dark:bg-[#0A0914]/90 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo & Left Links -->
    <div class="flex items-center gap-6 lg:gap-8">
      <!-- GrowthBook Brand Logo -->
      <a href="/design-3" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-[#6E56CF] flex items-center justify-center text-white shadow-sm transition-transform group-hover:scale-105">
          <!-- GrowthBook Geometric Monogram / Flask Mark -->
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2v7.31M14 2v7.31M8.5 2h7M14 9.3a6.5 6.5 0 1 1-4 0"/>
            <circle cx="12" cy="15" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-lg font-bold tracking-tight text-[#151E3D] dark:text-white font-sans">GrowthBook</span>
          <span class="text-[9px] font-mono font-semibold uppercase tracking-wider px-1.5 py-0.2 rounded bg-[#6E56CF]/10 text-[#6E56CF] dark:text-[#A79BE6]">V5.0</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-neutral-700 dark:text-neutral-300">
        
        <!-- Products Mega Menu Trigger -->
        <div class="relative group">
          <button class="inline-flex items-center gap-1 px-3 py-2 rounded-lg hover:text-[#6E56CF] dark:hover:text-[#A79BE6] hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">
            <span>Products</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>

          <!-- Dropdown -->
          <div class="absolute top-full left-0 mt-1 w-80 p-3 rounded-2xl bg-white dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] shadow-2xl opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 z-50">
            <div class="text-[10px] font-mono font-semibold text-neutral-400 uppercase tracking-wider px-2 py-1">Products</div>
            <a href="#experimentation" class="flex items-start gap-2.5 p-2.5 rounded-xl hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10 transition-colors group/item">
              <div class="w-7 h-7 rounded-lg bg-[#6E56CF]/10 text-[#6E56CF] flex items-center justify-center text-xs font-bold shrink-0">⚗</div>
              <div>
                <div class="text-xs font-bold text-neutral-900 dark:text-white group-hover/item:text-[#6E56CF]">Experimentation</div>
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400">Bayesian &amp; Frequentist A/B testing at scale</div>
              </div>
            </a>
            <a href="#feature-flags" class="flex items-start gap-2.5 p-2.5 rounded-xl hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10 transition-colors group/item">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xs font-bold shrink-0">⚑</div>
              <div>
                <div class="text-xs font-bold text-neutral-900 dark:text-white group-hover/item:text-[#6E56CF]">Feature Flags</div>
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400">Safe rollouts, kill switches &amp; guardrails</div>
              </div>
            </a>
            <a href="#analytics" class="flex items-start gap-2.5 p-2.5 rounded-xl hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10 transition-colors group/item">
              <div class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center text-xs font-bold shrink-0">📈</div>
              <div>
                <div class="text-xs font-bold text-neutral-900 dark:text-white group-hover/item:text-[#6E56CF]">Product Analytics</div>
                <div class="text-[11px] text-neutral-500 dark:text-neutral-400">Warehouse-native metrics &amp; AI insights</div>
              </div>
            </a>
            <div class="mt-1 pt-2 border-t border-[#EEEEF2] dark:border-[#222B42] text-[11px] px-2 flex justify-between text-neutral-400 font-mono">
              <span>Warehouse Native</span>
              <span class="text-[#6E56CF] font-bold">Zero Latency ✓</span>
            </div>
          </div>
        </div>

        <!-- Solutions Trigger -->
        <div class="relative group">
          <button class="inline-flex items-center gap-1 px-3 py-2 rounded-lg hover:text-[#6E56CF] dark:hover:text-[#A79BE6] hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">
            <span>Solutions</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-0 mt-1 w-64 p-3 rounded-2xl bg-white dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] shadow-2xl opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 z-50 space-y-1">
            <div class="text-[10px] font-mono font-semibold text-neutral-400 uppercase tracking-wider px-2 py-1">By Role</div>
            <a href="#persona-tabs" class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-neutral-800 dark:text-neutral-200 hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10">Engineering Teams</a>
            <a href="#persona-tabs" class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-neutral-800 dark:text-neutral-200 hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10">Data Science &amp; Analysts</a>
            <a href="#persona-tabs" class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-neutral-800 dark:text-neutral-200 hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10">Product Managers</a>
            <a href="#persona-tabs" class="block px-2.5 py-1.5 rounded-lg text-xs font-medium text-neutral-800 dark:text-neutral-200 hover:bg-[#F6F2FD] dark:hover:bg-[#6E56CF]/10">Growth &amp; Marketing</a>
          </div>
        </div>

        <a href="#integrations" class="px-3 py-2 rounded-lg hover:text-[#6E56CF] dark:hover:text-[#A79BE6] hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">Integrations</a>
        <a href="#case-studies" class="px-3 py-2 rounded-lg hover:text-[#6E56CF] dark:hover:text-[#A79BE6] hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">Customers</a>
        <a href="/pricing" class="px-3 py-2 rounded-lg hover:text-[#6E56CF] dark:hover:text-[#A79BE6] hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">Pricing</a>
        <a href="https://docs.growthbook.io/" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-lg hover:text-[#6E56CF] dark:hover:text-[#A79BE6] hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition-colors">Docs</a>

        <!-- Design Switcher Mega Pill -->
        <div class="relative group ml-2">
          <button class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#F6F2FD] dark:bg-[#1A1A32] border border-[#E2E0F8] dark:border-[#333360] text-xs font-medium text-[#6E56CF] dark:text-[#A79BE6]">
            <span class="w-2 h-2 rounded-full bg-[#6E56CF] animate-pulse"></span>
            <span class="font-bold">Design 3: GrowthBook</span>
            <svg class="w-3 h-3 text-[#6E56CF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          
          <div class="absolute top-full left-0 mt-1.5 w-64 p-2 rounded-xl bg-white dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] shadow-xl opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 z-50 space-y-1">
            <a href="/" class="block p-2 rounded-lg text-xs hover:bg-neutral-100 dark:hover:bg-neutral-800">
              <div class="font-bold text-neutral-900 dark:text-white">Design 1: Linear / Attio</div>
              <div class="text-[10px] text-neutral-500">Autonomous Revenue OS</div>
            </a>
            <a href="/design-2" class="block p-2 rounded-lg text-xs hover:bg-neutral-100 dark:hover:bg-neutral-800">
              <div class="font-bold text-neutral-900 dark:text-white">Design 2: Lamossa Studio</div>
              <div class="text-[10px] text-neutral-500">Coral-Red (#FF4D36) &amp; ROI</div>
            </a>
            <a href="/design-3" class="block p-2 rounded-lg text-xs bg-[#F6F2FD] dark:bg-[#6E56CF]/10 border border-[#6E56CF]/30">
              <div class="font-bold text-[#6E56CF]">Design 3: GrowthBook Replica</div>
              <div class="text-[10px] text-neutral-500">Warehouse-Native Platform</div>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- GitHub Stars Badge (GrowthBook signature) -->
      <a 
        href="https://github.com/growthbook/growthbook" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#EEEEF2] dark:border-[#222B42] bg-white dark:bg-[#101422] text-xs font-medium text-neutral-800 dark:text-neutral-200 hover:border-[#6E56CF] hover:text-[#6E56CF] transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="font-mono text-[11px]">★ 6.2k</span>
      </a>

      <!-- Theme Switcher -->
      <button id="gb-theme-toggle" aria-label="Toggle Theme" class="p-2 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
        <span class="dark:hidden"><Icon name="moon" class="w-4 h-4" /></span>
        <span class="hidden dark:inline"><Icon name="sun" class="w-4 h-4" /></span>
      </button>

      <!-- Book a Demo Button -->
      <a 
        href="#demo" 
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-lg border border-[#D2D2DB] dark:border-[#2A3459] bg-transparent hover:bg-neutral-50 dark:hover:bg-neutral-800/60 text-xs font-semibold text-[#151E3D] dark:text-white transition-all cursor-pointer"
      >
        Book a Demo
      </a>

      <!-- Start for Free (GrowthBook Purple #6E56CF) -->
      <a 
        href="https://app.growthbook.io" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2 rounded-lg bg-[#6E56CF] hover:bg-[#5643B8] text-white text-xs font-semibold shadow-sm transition-all transform hover:-translate-y-0.5 cursor-pointer"
      >
        <span>Start for Free</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button id="gb-mobile-menu-btn" aria-label="Open mobile menu" class="lg:hidden p-2 text-neutral-700 dark:text-neutral-300">
        <Icon name="menu" class="w-5 h-5" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="gb-mobile-menu" class="hidden lg:hidden border-t border-[#EEEEF2] dark:border-[#222B42] bg-white dark:bg-[#0A0914] px-4 py-4 space-y-2">
    <a href="#experimentation" class="block px-3 py-2 text-sm font-medium text-neutral-900 dark:text-white rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800">Experimentation</a>
    <a href="#feature-flags" class="block px-3 py-2 text-sm font-medium text-neutral-900 dark:text-white rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800">Feature Flags</a>
    <a href="#analytics" class="block px-3 py-2 text-sm font-medium text-neutral-900 dark:text-white rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800">Product Analytics</a>
    <a href="#integrations" class="block px-3 py-2 text-sm font-medium text-neutral-900 dark:text-white rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800">Integrations</a>
    <a href="/pricing" class="block px-3 py-2 text-sm font-medium text-neutral-900 dark:text-white rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800">Pricing</a>
    <div class="pt-2 border-t border-neutral-200 dark:border-neutral-800 flex flex-col gap-2">
      <a href="#demo" class="w-full py-2 text-center text-xs font-semibold rounded-lg border border-neutral-300 dark:border-neutral-700">Book a Demo</a>
      <a href="https://app.growthbook.io" class="w-full py-2 text-center text-xs font-semibold rounded-lg bg-[#6E56CF] text-white">Start for Free</a>
    </div>
  </div>
</header>

<script>
  // Theme toggle script
  const themeToggle = document.getElementById('gb-theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        localStorage.setItem('nr-theme', 'light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
        localStorage.setItem('nr-theme', 'dark');
      }
    });
  }

  // Mobile menu toggle
  const mobileBtn = document.getElementById('gb-mobile-menu-btn');
  const mobileMenu = document.getElementById('gb-mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
