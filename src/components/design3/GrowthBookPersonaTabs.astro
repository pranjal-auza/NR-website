---

<section id="persona-tabs" class="py-20 md:py-28 bg-white dark:bg-[#0C0B18] border-t border-[#EEEEF2] dark:border-[#1E2538] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#6E56CF] dark:text-[#A79BE6]">
        Purpose-Built for Every Role
      </div>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#151E3D] dark:text-white">
        Why product teams prefer GrowthBook
      </h2>
    </div>

    <!-- Persona Tabs Switcher -->
    <div class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
      <button id="p-tab-why" class="persona-tab active px-4 sm:px-6 py-2.5 rounded-xl border-2 border-[#6E56CF] bg-[#F6F2FD] dark:bg-[#1A1A32] text-[#6E56CF] dark:text-white text-xs sm:text-sm font-bold shadow-xs transition-all cursor-pointer">
        Why GrowthBook
      </button>

      <button id="p-tab-eng" class="persona-tab px-4 sm:px-6 py-2.5 rounded-xl border border-[#EEEEF2] dark:border-[#222B42] bg-white dark:bg-[#121624] text-[#62627A] dark:text-neutral-400 text-xs sm:text-sm font-medium hover:text-[#151E3D] dark:hover:text-white transition-all cursor-pointer">
        For Engineers
      </button>

      <button id="p-tab-data" class="persona-tab px-4 sm:px-6 py-2.5 rounded-xl border border-[#EEEEF2] dark:border-[#222B42] bg-white dark:bg-[#121624] text-[#62627A] dark:text-neutral-400 text-xs sm:text-sm font-medium hover:text-[#151E3D] dark:hover:text-white transition-all cursor-pointer">
        For Data Teams
      </button>

      <button id="p-tab-pm" class="persona-tab px-4 sm:px-6 py-2.5 rounded-xl border border-[#EEEEF2] dark:border-[#222B42] bg-white dark:bg-[#121624] text-[#62627A] dark:text-neutral-400 text-xs sm:text-sm font-medium hover:text-[#151E3D] dark:hover:text-white transition-all cursor-pointer">
        For Product Managers
      </button>
    </div>

    <!-- Tab 1 Panel: Why GrowthBook -->
    <div id="p-panel-why" class="persona-panel grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4 hover:border-[#6E56CF] transition-all">
        <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/30 text-[#6E56CF] flex items-center justify-center font-bold text-lg">🤖</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Built for AI-native development</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Agents can programmatically toggle features, query results, and autonomously remediate rollout incidents via MCP.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4 hover:border-[#6E56CF] transition-all">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 flex items-center justify-center font-bold text-lg">🏛</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Warehouse-native architecture</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">No data egress fees. No vendor lock-in. Keep all user event telemetry securely inside your own data cloud.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4 hover:border-[#6E56CF] transition-all">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center font-bold text-lg">📖</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Open source and transparent</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Inspect every single line of code, fork it, self-host it, or run on GrowthBook Cloud with zero black-box secrets.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4 hover:border-[#6E56CF] transition-all">
        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/30 text-amber-600 flex items-center justify-center font-bold text-lg">📊</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Powerful &amp; flexible stats</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Bayesian posterior distributions, frequentist p-values, CUPED variance reduction, and automated SRM detection.</p>
      </div>
    </div>

    <!-- Tab 2 Panel: For Engineers -->
    <div id="p-panel-eng" class="persona-panel hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 flex items-center justify-center font-bold text-lg">⚡</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Ultra lightweight SDKs</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Under 1KB in JavaScript. Zero external runtime dependencies for maximum app performance.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center font-bold text-lg">🛡</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Automatic kill switches</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Auto-rollback bad deployments within milliseconds when exception rates exceed threshold limits.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/30 text-[#6E56CF] flex items-center justify-center font-bold text-lg">🔌</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Built-in MCP Server</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Connect Claude, Cursor, or your autonomous coding agents directly to manage flags via Model Context Protocol.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 flex items-center justify-center font-bold text-lg">💻</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Local dev &amp; staging</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Mock flag states locally with DevTools extensions and CI/CD pipelines without hitting production servers.</p>
      </div>
    </div>

    <!-- Tab 3 Panel: For Data Teams -->
    <div id="p-panel-data" class="persona-panel hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 flex items-center justify-center font-bold text-lg">📝</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Transparent SQL metrics</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Inspect and customize the exact SQL queries generated by GrowthBook against your warehouse schema.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/30 text-[#6E56CF] flex items-center justify-center font-bold text-lg">📈</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">CUPED variance reduction</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Cut experiment sample size requirements by up to 50% using pre-experiment behavioral covariates.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 flex items-center justify-center font-bold text-lg">🔍</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Automated health checks</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Detect Sample Ratio Mismatches (SRM), outlier capping, and multiple testing corrections automatically.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/30 text-amber-600 flex items-center justify-center font-bold text-lg">📓</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Jupyter &amp; dbt sync</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Define metrics once in dbt models and automatically sync them directly into GrowthBook experiment queries.</p>
      </div>
    </div>

    <!-- Tab 4 Panel: For Product Managers -->
    <div id="p-panel-pm" class="persona-panel hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-rose-100 dark:bg-rose-900/30 text-rose-600 flex items-center justify-center font-bold text-lg">🎨</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">AI Visual Editor</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Make copy and visual changes on live web pages without waiting for engineering sprint deployments.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/30 text-[#6E56CF] flex items-center justify-center font-bold text-lg">📊</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Executive impact summaries</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Automated revenue impact calculations to report cumulative business value to leadership and board members.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 flex items-center justify-center font-bold text-lg">🔒</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">Role-based permissions</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Granular approval workflows, environment locks, and audit logging to safely scale testing across 500+ PMs.</p>
      </div>

      <div class="p-6 rounded-2xl bg-[#FAFAFA] dark:bg-[#121624] border border-[#EEEEF2] dark:border-[#222B42] space-y-4">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center font-bold text-lg">🚀</div>
        <h3 class="font-bold text-base text-[#151E3D] dark:text-white">100% Release confidence</h3>
        <p class="text-xs text-neutral-500 leading-relaxed">Ship only proven winners backed by rigorous statistical significance, eliminating rollout anxiety.</p>
      </div>
    </div>

  </div>
</section>

<script>
  // Persona Tab Switcher script
  const pTabWhy = document.getElementById('p-tab-why');
  const pTabEng = document.getElementById('p-tab-eng');
  const pTabData = document.getElementById('p-tab-data');
  const pTabPm = document.getElementById('p-tab-pm');

  const pPanelWhy = document.getElementById('p-panel-why');
  const pPanelEng = document.getElementById('p-panel-eng');
  const pPanelData = document.getElementById('p-panel-data');
  const pPanelPm = document.getElementById('p-panel-pm');

  const allPTabs = [pTabWhy, pTabEng, pTabData, pTabPm];
  const allPPanels = [pPanelWhy, pPanelEng, pPanelData, pPanelPm];

  function switchPersonaTab(tab: HTMLElement | null, panel: HTMLElement | null) {
    if (!tab || !panel) return;

    allPTabs.forEach(t => {
      t?.classList.remove('active', 'border-2', 'border-[#6E56CF]', 'bg-[#F6F2FD]', 'dark:bg-[#1A1A32]', 'text-[#6E56CF]', 'dark:text-white', 'font-bold');
      t?.classList.add('border', 'border-[#EEEEF2]', 'dark:border-[#222B42]', 'bg-white', 'dark:bg-[#121624]', 'text-[#62627A]', 'dark:text-neutral-400', 'font-medium');
    });

    tab.classList.add('active', 'border-2', 'border-[#6E56CF]', 'bg-[#F6F2FD]', 'dark:bg-[#1A1A32]', 'text-[#6E56CF]', 'dark:text-white', 'font-bold');
    tab.classList.remove('border-[#EEEEF2]', 'dark:border-[#222B42]', 'bg-white', 'dark:bg-[#121624]', 'text-[#62627A]', 'dark:text-neutral-400', 'font-medium');

    allPPanels.forEach(p => p?.classList.add('hidden'));
    panel.classList.remove('hidden');
  }

  if (pTabWhy && pTabEng && pTabData && pTabPm) {
    pTabWhy.addEventListener('click', () => switchPersonaTab(pTabWhy, pPanelWhy));
    pTabEng.addEventListener('click', () => switchPersonaTab(pTabEng, pPanelEng));
    pTabData.addEventListener('click', () => switchPersonaTab(pTabData, pPanelData));
    pTabPm.addEventListener('click', () => switchPersonaTab(pTabPm, pPanelPm));
  }
</script>
