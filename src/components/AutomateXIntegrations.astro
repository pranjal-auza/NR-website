---
// AutomateX Integrations Section: Double Marquee Ticker
---

<section class="relative py-20 md:py-28 overflow-hidden bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Header & CTA -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 md:mb-18">
      <div class="space-y-3.5 max-w-2xl text-left">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-purple-200 bg-purple-50/60 text-xs sm:text-sm font-semibold text-[#5B21B6]">
          <span>Works across your stack</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#100F12] tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
          Integrates where your team already works
        </h2>
      </div>

      <a 
        href="#integrations" 
        class="btn-text-roll group self-start md:self-end inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-[#100F12] hover:bg-[#23222A] text-white font-semibold text-xs sm:text-sm shadow-md transition-all shrink-0"
      >
        <div class="button-text-wrap">
          <span class="text-default">View all integrations</span>
          <span class="text-hover">View all integrations</span>
        </div>
      </a>
    </div>

    <!-- Tickers Container with Edge Fade Masks -->
