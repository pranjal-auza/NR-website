---
// Analytics Section — CENTERED + BENTO CARD GRID COMPOSITION
---

<section id="analytics" class="py-20 md:py-32 bg-[#FCFCFA] border-b border-[#E9E9EF]/60 relative overflow-hidden">
  <!-- Subtle Soft Lavender Atmospheric Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[#F2EEFF]/60 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- 1. Centered Editorial Statement -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-18">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F2EEFF] border border-[#E0D7FF] text-xs font-bold tracking-wider text-[#635BFF] uppercase mb-4">
        <span>Actionable Intelligence</span>
      </div>

      <h2 class="text-4xl sm:text-6xl font-extrabold text-[#17172A] tracking-[-0.04em] leading-[1.02] font-['Plus_Jakarta_Sans']">
        Know what's happening. <br />
        <span class="text-[#635BFF]">Before it matters.</span>
      </h2>

      <p class="text-base sm:text-lg text-[#656579] leading-relaxed mt-5 max-w-2xl mx-auto">
        Track cross-channel volume, monitor SLA deadlines, measure team velocity, and turn raw customer conversations into high-converting business intelligence.
      </p>
    </div>

    <!-- 2. BENTO CARD GRID -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
      
      <!-- Bento Card 1: Main Conversation Volume Chart (7 cols) -->
      <div class="md:col-span-7 saas-card p-6 sm:p-8 bg-white border border-[#E9E9EF] rounded-[24px] shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-[#E9E9EF]">
            <div>
              <div class="text-[11px] font-bold text-[#9696A8] uppercase tracking-wider">Conversation Volume</div>
              <div class="text-3xl sm:text-4xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans'] mt-1">48,920</div>
            </div>
            <div class="text-right">
              <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                <span>↑ 34.8%</span>
                <span class="text-[10px] text-[#656579] font-normal">vs last month</span>
              </span>
            </div>
          </div>

          <!-- Channel Filter Tags -->
          <div class="flex items-center gap-2 mt-4 text-xs font-medium">
            <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#17172A] text-white text-[11px] font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
              All Channels
            </span>
            <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FCFCFA] border border-[#E9E9EF] text-[#656579] text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
              WhatsApp (62%)
            </span>
            <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FCFCFA] border border-[#E9E9EF] text-[#656579] text-[11px]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FD1D1D]"></span>
              Instagram (24%)
            </span>
          </div>
        </div>

        <!-- Rich SVG Smooth Chart with Area Fill & Tooltip -->
        <div class="mt-8 relative pt-4">
          
          <!-- Tooltip on peak point -->
          <div class="absolute top-0 right-1/3 transform -translate-x-1/2 bg-[#17172A] text-white px-2.5 py-1 rounded-lg text-[10px] font-semibold shadow-md pointer-events-none flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#635BFF]"></span>
            <span>Peak: 4,120 msgs/hr</span>
          </div>

          <svg class="w-full h-36 sm:h-44 overflow-visible" viewBox="0 0 500 150" fill="none">
            <defs>
              <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#635BFF" stop-opacity="0.25"/>
                <stop offset="100%" stop-color="#635BFF" stop-opacity="0.0"/>
              </linearGradient>
            </defs>

            <!-- Area Fill -->
            <path d="M0 130 Q 80 110, 150 95 T 300 45 T 420 20 T 500 10 L 500 150 L 0 150 Z" fill="url(#chartGradient)"/>

            <!-- Stroke Line -->
            <path d="M0 130 Q 80 110, 150 95 T 300 45 T 420 20 T 500 10" stroke="#635BFF" stroke-width="3" stroke-linecap="round"/>

            <!-- Peak Circle Dot -->
            <circle cx="330" cy="40" r="5" fill="#FFFFFF" stroke="#635BFF" stroke-width="3"/>
          </svg>

          <!-- Timeline X-Axis Labels -->
          <div class="flex items-center justify-between text-[10px] text-[#9696A8] pt-2 border-t border-[#E9E9EF]/60 font-mono">
            <span>Mon</span>
            <span>Tue</span>
            <span>Wed</span>
            <span>Thu</span>
            <span>Fri</span>
            <span>Sat</span>
            <span>Sun</span>
          </div>
        </div>
      </div>

      <!-- Bento Card 2: CSAT Satisfaction & Sentiment (5 cols) -->
      <div class="md:col-span-5 saas-card p-6 sm:p-8 bg-white border border-[#E9E9EF] rounded-[24px] shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-[#E9E9EF]">
            <div>
              <div class="text-[11px] font-bold text-[#9696A8] uppercase tracking-wider">Customer Satisfaction</div>
              <div class="text-3xl sm:text-4xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans'] mt-1">98.4%</div>
            </div>
            <div class="w-10 h-10 rounded-2xl bg-[#F2EEFF] text-[#635BFF] flex items-center justify-center font-bold text-lg">
              ★
            </div>
          </div>

          <!-- Sentiment Breakdown Bars -->
          <div class="space-y-3 mt-5">
            <div>
              <div class="flex justify-between text-xs font-semibold text-[#17172A] mb-1">
                <span>Positive Sentiment</span>
                <span class="text-emerald-600">92%</span>
              </div>
              <div class="w-full h-2 bg-[#F0F0F4] rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" style="width: 92%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-[#17172A] mb-1">
                <span>Neutral / Informational</span>
                <span class="text-[#656579]">7%</span>
              </div>
              <div class="w-full h-2 bg-[#F0F0F4] rounded-full overflow-hidden">
                <div class="h-full bg-slate-400 rounded-full" style="width: 7%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-[#17172A] mb-1">
                <span>Negative / Escalations</span>
                <span class="text-rose-500">1%</span>
              </div>
              <div class="w-full h-2 bg-[#F0F0F4] rounded-full overflow-hidden">
                <div class="h-full bg-rose-400 rounded-full" style="width: 1%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Customer Feedback Quote -->
        <div class="mt-6 p-3.5 rounded-xl bg-[#FCFCFA] border border-[#E9E9EF] text-xs text-[#656579] italic leading-relaxed">
          "NewRelay enabled our support agents to resolve customer requests in seconds instead of hours."
          <div class="not-italic font-bold text-[#17172A] text-[10px] mt-1.5">
            — Rahul Verma, Operations Lead @ Snitch
          </div>
        </div>
      </div>

      <!-- Bento Card 3: Speed & SLA Velocity (Full-width 12 cols) -->
      <div class="md:col-span-12 saas-card p-6 sm:p-8 bg-[#F8F8FC] border border-[#E0D7FF] rounded-[24px] shadow-xs">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 items-center">
          
          <div class="sm:border-r border-[#E9E9EF] sm:pr-6">
            <div class="text-[11px] font-bold text-[#9696A8] uppercase tracking-wider">Median First Response Time</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#635BFF] font-['Plus_Jakarta_Sans'] mt-1">1m 12s</div>
            <div class="text-xs text-[#656579] mt-1">4.2x faster than standard email support</div>
          </div>

          <div class="sm:border-r border-[#E9E9EF] sm:pr-6">
            <div class="text-[11px] font-bold text-[#9696A8] uppercase tracking-wider">Automated Resolution Rate</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 font-['Plus_Jakarta_Sans'] mt-1">68.5%</div>
            <div class="text-xs text-[#656579] mt-1">Inquiries resolved instantly by AI agents</div>
          </div>

          <div>
            <div class="text-[11px] font-bold text-[#9696A8] uppercase tracking-wider">Lead-to-Deal Conversion Rate</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans'] mt-1">+40.2%</div>
            <div class="text-xs text-[#656579] mt-1">Attributed to instant multi-channel engagement</div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
