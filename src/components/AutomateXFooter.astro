---
// AutomateX Footer Component: Newsletter Subscription, Complete Sitemaps & Background Graphic
---

<footer class="relative pt-20 pb-12 overflow-hidden bg-[#FAF8F5] border-t border-[#EBE8E3]">
  
  <!-- Subtle Background Artworks -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none -z-10">
    <img 
      src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69b937a8eefae8b61de41d14_778d53cb3575cc1a6055e51ff30db667_Group%20156.png" 
      alt="BG Pattern" 
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-6xl opacity-30 mix-blend-multiply" 
    />
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Grid: Left (Brand + Newsletter) & Right (Links Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-slate-200/80">
      
      <!-- Left Column: Brand & Subscribe Form (5 cols) -->
      <div class="lg:col-span-5 space-y-6 text-left">
        
        <a href="/" class="inline-flex items-center group">
          <img 
            src="/new-relay-logo.svg" 
            alt="NewRelay" 
            class="h-8 w-auto object-contain" 
          />
        </a>

        <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed max-w-sm">
          The all-in-one platform to manage WhatsApp, Instagram, Google Reviews, and customer conversations in one unified command center.
        </p>

        <!-- Newsletter Subscription Form -->
        <div class="space-y-3 pt-2">
          <form class="flex items-center gap-2 max-w-md" onsubmit="event.preventDefault(); alert('Thank you for subscribing!');">
            <input 
              type="email" 
              placeholder="Enter your work email" 
              required 
              class="w-full px-4 py-3 rounded-full bg-white border border-slate-300 text-xs sm:text-sm text-[#100F12] placeholder-slate-400 focus:outline-none focus:border-[#635BFF] shadow-2xs" 
            />
            <button 
              type="submit" 
              class="px-5 py-3 rounded-full bg-[#100F12] hover:bg-[#242330] text-white font-bold text-xs sm:text-sm shrink-0 transition-all shadow-md cursor-pointer"
            >
              Subscribe
            </button>
          </form>

          <label class="flex items-center gap-2 text-[11px] text-[#5F5E6E] cursor-pointer">
            <input type="checkbox" required class="rounded text-[#635BFF] focus:ring-[#635BFF]" />
            <span>I consent to receive product updates and best practices.</span>
          </label>
        </div>

      </div>

      <!-- Right Column: Links Columns (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 text-left">
        
        <!-- Column 1: Product -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#100F12] font-['Plus_Jakarta_Sans']">
            Product
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-[#5F5E6E]">
            <li><a href="#inbox" class="hover:text-[#635BFF] transition-colors">Unified Team Inbox</a></li>
            <li><a href="#automation" class="hover:text-[#635BFF] transition-colors">Workflow Automation</a></li>
            <li><a href="#reviews" class="hover:text-[#635BFF] transition-colors">Review Growth Engine</a></li>
            <li><a href="#features" class="hover:text-[#635BFF] transition-colors">Features & Bento</a></li>
            <li><a href="#integrations" class="hover:text-[#635BFF] transition-colors">Integrations</a></li>
            <li><a href="#pricing" class="hover:text-[#635BFF] transition-colors">Pricing Plans</a></li>
          </ul>
        </div>

        <!-- Column 2: Solutions -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#100F12] font-['Plus_Jakarta_Sans']">
            Solutions
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-[#5F5E6E]">
            <li><a href="/home-2" class="hover:text-[#635BFF] transition-colors">Home 2 (Reputation)</a></li>
            <li><a href="/home-3" class="hover:text-[#635BFF] transition-colors">Home 3 (Full Stack)</a></li>
            <li><a href="#inbox" class="hover:text-[#635BFF] transition-colors">E-Commerce & DTC</a></li>
            <li><a href="#inbox" class="hover:text-[#635BFF] transition-colors">Real Estate & Clinics</a></li>
            <li><a href="#faqs" class="hover:text-[#635BFF] transition-colors">FAQs</a></li>
          </ul>
        </div>

        <!-- Column 3: Legal -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#100F12] font-['Plus_Jakarta_Sans']">
            Legal & Security
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-[#5F5E6E]">
            <li><a href="#privacy" class="hover:text-[#635BFF] transition-colors">Privacy Policy</a></li>
            <li><a href="#terms" class="hover:text-[#635BFF] transition-colors">Terms of Service</a></li>
            <li><a href="#security" class="hover:text-[#635BFF] transition-colors">SOC-2 Security</a></li>
            <li><a href="#gdpr" class="hover:text-[#635BFF] transition-colors">GDPR Compliance</a></li>
          </ul>
        </div>

      </div>

    </div>

    <!-- Bottom Bar: Copyright & Social Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#5F5E6E]">
      <p>© 2026 NewRelay, Inc. All rights reserved.</p>

      <div class="flex items-center gap-4 text-[#100F12]">
        <a href="https://x.com/" target="_blank" class="w-8 h-8 rounded-full bg-white border border-slate-200/80 flex items-center justify-center hover:text-[#5925DC] hover:border-purple-300 transition-all shadow-2xs">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://linkedin.com/" target="_blank" class="w-8 h-8 rounded-full bg-white border border-slate-200/80 flex items-center justify-center hover:text-[#5925DC] hover:border-purple-300 transition-all shadow-2xs">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a href="https://instagram.com/" target="_blank" class="w-8 h-8 rounded-full bg-white border border-slate-200/80 flex items-center justify-center hover:text-[#5925DC] hover:border-purple-300 transition-all shadow-2xs">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>
