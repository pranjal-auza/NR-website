---
// Home 4 Dark Mode Footer Component
---

<footer class="relative pt-20 pb-12 overflow-hidden bg-[#07080C] border-t border-white/10 text-white">
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Grid: Brand Column + Navigation Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-white/10">
      
      <!-- Brand & Newsletter (5 cols) -->
      <div class="lg:col-span-5 space-y-6 text-left">
        
        <a href="/home-4" class="inline-flex items-center gap-2">
          <img 
            src="/new-relay-logo.svg" 
            alt="NewRelay" 
            class="h-8 w-auto object-contain brightness-0 invert" 
          />
        </a>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          The high-velocity conversational platform for modern revenue teams. Unified WhatsApp, Instagram, Google Reviews, and team collaboration.
        </p>

        <!-- Newsletter Form -->
        <div class="space-y-3 pt-2">
          <form class="flex items-center gap-2 max-w-md" onsubmit="event.preventDefault(); alert('Subscribed to NewRelay updates!');">
            <input 
              type="email" 
              placeholder="Enter your work email" 
              required 
              class="w-full px-4 py-3 rounded-full bg-white/[0.05] border border-white/15 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 shadow-inner" 
            />
            <button 
              type="submit" 
              class="px-5 py-3 rounded-full bg-[#635BFF] hover:bg-[#5248E5] text-white font-bold text-xs sm:text-sm shrink-0 transition-all shadow-md cursor-pointer"
            >
              Subscribe
            </button>
          </form>

          <p class="text-[11px] text-slate-500">
            Join 8,500+ operators getting our weekly teardown on conversational sales.
          </p>
        </div>

      </div>

      <!-- Links Columns (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 text-left">
        
        <!-- Column 1: Product -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white font-mono">
            Platform
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
            <li><a href="#triage" class="hover:text-purple-400 transition-colors">Live Inbound Stream</a></li>
            <li><a href="#workflow" class="hover:text-purple-400 transition-colors">Event Automation</a></li>
            <li><a href="#infrastructure" class="hover:text-purple-400 transition-colors">Infrastructure</a></li>
            <li><a href="#roi" class="hover:text-purple-400 transition-colors">ROI Calculator</a></li>
            <li><a href="#pricing" class="hover:text-purple-400 transition-colors">Pricing Matrix</a></li>
          </ul>
        </div>

        <!-- Column 2: Versions -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white font-mono">
            Versions
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
            <li><a href="/" class="hover:text-purple-400 transition-colors">Home 1 (Omnichannel)</a></li>
            <li><a href="/home-2" class="hover:text-purple-400 transition-colors">Home 2 (Reputation)</a></li>
            <li><a href="/home-3" class="hover:text-purple-400 transition-colors">Home 3 (Full Stack)</a></li>
            <li><a href="/home-4" class="text-purple-400 font-semibold transition-colors">Home 4 (Dark Mode)</a></li>
          </ul>
        </div>

        <!-- Column 3: Security & Legal -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white font-mono">
            Security
          </h4>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
            <li><a href="#infrastructure" class="hover:text-purple-400 transition-colors">SOC-2 Type II</a></li>
            <li><a href="#infrastructure" class="hover:text-purple-400 transition-colors">GDPR & HIPAA</a></li>
            <li><a href="#infrastructure" class="hover:text-purple-400 transition-colors">Meta API Partner</a></li>
            <li><a href="#infrastructure" class="hover:text-purple-400 transition-colors">Terms of Service</a></li>
          </ul>
        </div>

      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-mono">
      <p>© 2026 NewRelay, Inc. All rights reserved.</p>
      <div class="flex items-center gap-4 text-slate-400">
        <a href="https://x.com/" target="_blank" class="hover:text-white transition-colors">Twitter (X)</a>
        <a href="https://linkedin.com/" target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
        <a href="https://github.com/" target="_blank" class="hover:text-white transition-colors">GitHub</a>
      </div>
    </div>

  </div>

</footer>
