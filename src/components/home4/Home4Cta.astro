---
// Home 4 Final High-Impact Dark Atmospheric CTA
---

<section class="py-20 md:py-28 bg-[#0A0B10] text-white relative overflow-hidden">
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Atmospheric Card Container -->
    <div class="relative bg-gradient-to-b from-[#141524] via-[#10111E] to-[#0D0E18] rounded-3xl sm:rounded-[36px] p-8 sm:p-14 lg:p-16 text-center border border-white/10 shadow-[0_30px_100px_rgba(0,0,0,0.8)] overflow-hidden">
      
      <!-- Glowing Orbs Inside Card -->
      <div class="absolute -top-28 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-purple-600/25 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute -bottom-20 right-10 w-[400px] h-[250px] bg-indigo-600/20 rounded-full blur-[90px] pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6 sm:space-y-8">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/[0.04] border border-white/15 text-xs sm:text-sm font-semibold text-purple-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Deploy in 5 Minutes</span>
        </div>

        <h2 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
          Ready to accelerate your conversational revenue?
        </h2>

        <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
          Join 1,200+ high-growth revenue leaders using NewRelay to unify messaging, route VIP leads in sub-seconds, and capture 5-star reviews on autopilot.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          
          <a 
            href="#pricing" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-to-r from-[#635BFF] via-[#7C3AED] to-[#9333EA] hover:from-[#5248E5] hover:to-[#7C3AED] text-white font-bold text-sm sm:text-base shadow-[0_0_35px_rgba(124,58,237,0.5)] hover:shadow-[0_0_45px_rgba(124,58,237,0.7)] transform hover:-translate-y-0.5 transition-all cursor-pointer"
          >
            <span>Start 14-day free trial</span>
            <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a 
            href="#triage" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white/[0.05] hover:bg-white/[0.1] text-white border border-white/15 font-bold text-sm sm:text-base backdrop-blur-md transform hover:-translate-y-0.5 transition-all cursor-pointer"
          >
            <span>View technical specs</span>
          </a>

        </div>

        <!-- Trust Badges -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-500 font-mono">
          <span>✓ 14-day free trial</span>
          <span>✓ Zero credit card required</span>
          <span>✓ Meta WhatsApp Cloud API</span>
          <span>✓ SOC-2 Type II Certified</span>
        </div>

      </div>

    </div>

  </div>

</section>
