---
// Home 4 Light Theme Header — Seamlessly integrated directly on page background
---

<header id="site-header" class="w-full bg-transparent z-50 pt-5 pb-3">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- Brand Logo (NewRelay) -->
    <a href="/home-4" class="flex items-center group py-1 shrink-0">
      <img 
        src="/new-relay-logo.svg" 
        alt="NewRelay" 
        class="h-7 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105" 
      />
    </a>

    <!-- Desktop Nav Menu (Products, Solutions, Pricing, Resource, Company) -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-9">
      
      <!-- Versions Switcher Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-700 hover:text-slate-950 px-3 py-1.5 rounded-full transition-all cursor-pointer bg-slate-100/80 hover:bg-slate-200/80 border border-slate-200/70">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Versions</span>
          <svg class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        
        <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50 pointer-events-none group-hover:pointer-events-auto">
          <div class="w-60 bg-white/98 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-[0_16px_40px_rgba(15,23,42,0.1)] p-2 flex flex-col gap-1">
            <div class="px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Select Version</div>
            <a href="/" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 transition-colors">
              <span>Home 1 (Omnichannel)</span>
              <span class="text-[10px] font-bold text-purple-700 bg-purple-100 px-2 py-0.5 rounded-full">v1</span>
            </a>
            <a href="/home-2" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 transition-colors">
              <span>Home 2 (Reputation)</span>
              <span class="text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full">v2</span>
            </a>
            <a href="/home-3" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 transition-colors">
              <span>Home 3 (Full Stack)</span>
              <span class="text-[10px] font-bold text-indigo-700 bg-indigo-100 px-2 py-0.5 rounded-full">v3</span>
            </a>
            <a href="/home-4" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-900 bg-slate-100 transition-colors">
              <span>Home 4 (Hero Reference)</span>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">v4</span>
            </a>
          </div>
        </div>
      </div>

      <a href="#products" class="text-xs sm:text-sm font-medium text-slate-700 hover:text-slate-950 transition-colors">
        Products
      </a>

      <a href="#solutions" class="text-xs sm:text-sm font-medium text-slate-700 hover:text-slate-950 transition-colors">
        Solutions
      </a>

      <a href="#pricing" class="text-xs sm:text-sm font-medium text-slate-700 hover:text-slate-950 transition-colors">
        Pricing
      </a>

      <a href="#resource" class="text-xs sm:text-sm font-medium text-slate-700 hover:text-slate-950 transition-colors">
        Resource
      </a>

      <a href="#company" class="text-xs sm:text-sm font-medium text-slate-700 hover:text-slate-950 transition-colors">
        Company
      </a>

    </nav>

    <!-- Right Action Buttons: Sign In & Book a Demo -> -->
    <div class="flex items-center gap-3 sm:gap-4 shrink-0">
      
      <a 
        href="#signin" 
        class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-full text-slate-700 hover:text-slate-950 font-semibold text-xs sm:text-sm transition-all border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm"
      >
        Sign In
      </a>

      <a 
        href="#demo" 
        class="inline-flex items-center justify-center px-5 sm:px-6 py-2.5 rounded-full bg-[#0F172A] hover:bg-black text-white font-semibold text-xs sm:text-sm shadow-sm transition-all transform hover:-translate-y-0.5 cursor-pointer group"
      >
        <span>Book a Demo</span>
        <svg class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-btn-4" class="md:hidden p-1.5 text-slate-700 hover:text-slate-950 focus:outline-none" aria-label="Toggle menu">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="mobile-menu-4" class="hidden md:hidden mt-3 bg-white/98 backdrop-blur-xl border border-slate-200 rounded-2xl p-4 shadow-xl flex flex-col gap-2.5 text-left text-slate-700">
      <div class="py-1">
        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Versions</div>
        <div class="flex flex-col gap-1 pl-2">
          <a href="/" class="text-xs font-semibold text-purple-700 py-1">Home 1 (Omnichannel)</a>
          <a href="/home-2" class="text-xs font-semibold text-amber-700 py-1">Home 2 (Reputation)</a>
          <a href="/home-3" class="text-xs font-semibold text-indigo-700 py-1">Home 3 (Full Stack)</a>
          <a href="/home-4" class="text-xs font-semibold text-emerald-700 py-1">Home 4 (Hero Reference)</a>
        </div>
      </div>
      <a href="#products" class="text-sm font-semibold py-1 hover:text-slate-950">Products</a>
      <a href="#solutions" class="text-sm font-semibold py-1 hover:text-slate-950">Solutions</a>
      <a href="#pricing" class="text-sm font-semibold py-1 hover:text-slate-950">Pricing</a>
      <a href="#resource" class="text-sm font-semibold py-1 hover:text-slate-950">Resource</a>
      <a href="#company" class="text-sm font-semibold py-1 hover:text-slate-950">Company</a>
      <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
        <a href="#signin" class="text-sm font-semibold text-slate-700 text-center py-1">Sign In</a>
        <a href="#demo" class="w-full text-center py-2.5 rounded-full bg-[#0F172A] text-white font-semibold text-xs">Book a Demo</a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileBtn4 = document.getElementById("mobile-menu-btn-4");
  const mobileMenu4 = document.getElementById("mobile-menu-4");

  mobileBtn4?.addEventListener("click", () => {
    mobileMenu4?.classList.toggle("hidden");
  });
</script>
