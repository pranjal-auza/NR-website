---
// Partner & Customer Trust Logos Ticker
---

<section class="py-10 bg-white border-b border-slate-100 overflow-hidden select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <p class="text-xs font-bold uppercase tracking-wider text-[#9494A8] mb-6">
      Powering conversations for 1,200+ fast-growing modern brands
    </p>

    <!-- Infinite Scrolling or Clean Logo Grid -->
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 opacity-70 grayscale hover:grayscale-0 transition-all duration-300">
      
      <div class="flex items-center gap-2 font-bold text-slate-800 text-lg tracking-tight">
        <span class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs">SR</span>
        <span>SwiftRetail</span>
      </div>

      <div class="flex items-center gap-2 font-bold text-slate-800 text-lg tracking-tight">
        <span class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs">CL</span>
        <span>Crestline Homes</span>
      </div>

      <div class="flex items-center gap-2 font-bold text-slate-800 text-lg tracking-tight">
        <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-xs">LH</span>
        <span>Lumina Health</span>
      </div>

      <div class="flex items-center gap-2 font-bold text-slate-800 text-lg tracking-tight">
        <span class="w-7 h-7 rounded-lg bg-amber-500 text-white flex items-center justify-center text-xs">OM</span>
        <span>Omnia DTC</span>
      </div>

      <div class="flex items-center gap-2 font-bold text-slate-800 text-lg tracking-tight">
        <span class="w-7 h-7 rounded-lg bg-purple-600 text-white flex items-center justify-center text-xs">PS</span>
        <span>PeakScale</span>
      </div>

      <div class="flex items-center gap-2 font-bold text-slate-800 text-lg tracking-tight">
        <span class="w-7 h-7 rounded-lg bg-rose-600 text-white flex items-center justify-center text-xs">NV</span>
        <span>Nova Dental</span>
      </div>

    </div>

  </div>
</section>
