---
// Final Call-To-Action Banner Component
---

<section class="py-20 md:py-28 bg-white relative overflow-hidden">
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Atmospheric Card Container -->
    <div class="relative bg-gradient-to-br from-[#100F12] via-[#1A1829] to-[#241C40] rounded-3xl sm:rounded-[36px] p-8 sm:p-14 lg:p-16 text-center text-white shadow-[0_30px_90px_rgba(23,23,42,0.2)] overflow-hidden">
      
      <!-- Radial Ambient Glowing Orbs Inside Card -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-[#635BFF]/30 rounded-full blur-[90px] pointer-events-none"></div>
      <div class="absolute -bottom-20 right-10 w-[400px] h-[250px] bg-purple-500/20 rounded-full blur-[80px] pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6 sm:space-y-8">
        
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-semibold text-purple-200">
          <span>🚀 Get Started in 5 Minutes</span>
        </div>

        <h2 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
          Ready to turn conversations into your biggest growth channel?
        </h2>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Join 1,200+ fast-growing modern businesses using NewRelay to unify their inbox, speed up response times, and capture 5-star reviews on autopilot.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          
          <a 
            href="#pricing" 
            class="btn-text-roll group inline-flex items-center justify-center px-8 py-4 rounded-full bg-[#635BFF] hover:bg-[#5248E5] text-white font-bold text-sm sm:text-base shadow-[0_12px_32px_rgba(99,91,255,0.45)] hover:shadow-[0_16px_38px_rgba(99,91,255,0.6)] transform hover:-translate-y-0.5 transition-all cursor-pointer"
          >
            <div class="button-text-wrap">
              <span class="text-default">Start 14-day free trial</span>
              <span class="text-hover">Start 14-day free trial</span>
            </div>
          </a>

          <a 
            href="#demo" 
            class="btn-text-roll group inline-flex items-center justify-center px-8 py-4 rounded-full bg-white/10 hover:bg-white/15 text-white border border-white/20 font-bold text-sm sm:text-base backdrop-blur-md transform hover:-translate-y-0.5 transition-all cursor-pointer"
          >
            <div class="button-text-wrap">
              <span class="text-default text-white">Book a live walkthrough</span>
              <span class="text-hover text-white">Book a live walkthrough</span>
            </div>
          </a>

        </div>

        <!-- Trust Features -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-400">
          <span>✓ 14-day free trial</span>
          <span>✓ No credit card required</span>
          <span>✓ Instant WhatsApp setup</span>
          <span>✓ Cancel anytime</span>
        </div>

      </div>

    </div>

  </div>

</section>
