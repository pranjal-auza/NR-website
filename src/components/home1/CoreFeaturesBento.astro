---
// Core Features Bento Grid — 4 Concrete Product Pillars
---

<section id="features" class="py-20 md:py-28 bg-white relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-18">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 border border-indigo-200 text-xs sm:text-sm font-bold text-indigo-700 mb-4">
        <span>Everything you need to grow</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#100F12] tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
        Built for teams that care about speed, <br class="hidden sm:inline" />
        reputation, and customer loyalty.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#5F5E6E] leading-relaxed">
        Everything your sales, support, and marketing teams need in one integrated workspace.
      </p>
    </div>

    <!-- Bento Grid (2x2 / 4 Pillars) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-7 max-w-5xl mx-auto">
      
      <!-- PILLAR 1: Team Inbox & Collaboration -->
      <div class="bg-[#FDFCFD] rounded-3xl border border-slate-200/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_40px_rgba(99,91,255,0.06)] hover:border-purple-200 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-purple-50 text-[#635BFF] flex items-center justify-center font-bold text-xl">
            💬
          </div>
          <h3 class="text-xl font-bold text-[#100F12]">Shared Team Inbox & Collaboration</h3>
          <p class="text-sm text-[#5F5E6E] leading-relaxed">
            Eliminate messy shared logins. Give your entire team dedicated access to WhatsApp, Instagram, Email, and Webchat with collision detection and private @mentions.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2 text-xs font-semibold text-[#100F12]">
          <span class="px-2.5 py-1 rounded-md bg-purple-50 text-[#635BFF]">Collision Prevention</span>
          <span class="px-2.5 py-1 rounded-md bg-purple-50 text-[#635BFF]">Private @Mentions</span>
          <span class="px-2.5 py-1 rounded-md bg-purple-50 text-[#635BFF]">Saved Snippets</span>
        </div>
      </div>

      <!-- PILLAR 2: Automated Review Collection -->
      <div class="bg-[#FDFCFD] rounded-3xl border border-slate-200/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_40px_rgba(245,158,11,0.08)] hover:border-amber-200 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center font-bold text-xl">
            ⭐
          </div>
          <h3 class="text-xl font-bold text-[#100F12]">Automated Review & Reputation Engine</h3>
          <p class="text-sm text-[#5F5E6E] leading-relaxed">
            Automatically turn happy customers into 5-star Google, Trustpilot, and Facebook reviews. Monitor sentiments, receive alerts, and reply to all reviews in seconds.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2 text-xs font-semibold text-[#100F12]">
          <span class="px-2.5 py-1 rounded-md bg-amber-50 text-amber-800">Google Business Sync</span>
          <span class="px-2.5 py-1 rounded-md bg-amber-50 text-amber-800">1-Click AI Replies</span>
          <span class="px-2.5 py-1 rounded-md bg-amber-50 text-amber-800">SMS & WhatsApp Invites</span>
        </div>
      </div>

      <!-- PILLAR 3: 24/7 Smart Auto-Responders -->
      <div class="bg-[#FDFCFD] rounded-3xl border border-slate-200/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_40px_rgba(16,185,129,0.08)] hover:border-emerald-200 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl">
            ⚡
          </div>
          <h3 class="text-xl font-bold text-[#100F12]">24/7 Intelligent Auto-Responders</h3>
          <p class="text-sm text-[#5F5E6E] leading-relaxed">
            Never leave a midnight lead waiting. Qualify prospective buyers, provide instant pricing or booking links, and handle FAQs with accurate context.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2 text-xs font-semibold text-[#100F12]">
          <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800">&lt; 15s First Response</span>
          <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800">Calendar Booking</span>
          <span class="px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800">FAQ Resolver</span>
        </div>
      </div>

      <!-- PILLAR 4: Analytics & CSAT -->
      <div class="bg-[#FDFCFD] rounded-3xl border border-slate-200/90 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_16px_40px_rgba(99,91,255,0.06)] hover:border-purple-200 transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl">
            📊
          </div>
          <h3 class="text-xl font-bold text-[#100F12]">Real-Time Analytics & CSAT Tracking</h3>
          <p class="text-sm text-[#5F5E6E] leading-relaxed">
            Track individual agent response times, resolution benchmarks, customer satisfaction scores, and revenue attributed to WhatsApp and social channels.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2 text-xs font-semibold text-[#100F12]">
          <span class="px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700">First Response SLA</span>
          <span class="px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700">CSAT Surveys</span>
          <span class="px-2.5 py-1 rounded-md bg-indigo-50 text-indigo-700">Channel ROI</span>
        </div>
      </div>

    </div>

  </div>

</section>
