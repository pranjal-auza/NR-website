---
// Integrations Ecosystem Component — WhatsApp, Instagram, Google, Shopify, HubSpot, Stripe
---

<section id="integrations" class="py-20 md:py-28 bg-[#FAF9FF]/60 border-t border-slate-100 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    
    <div class="max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-100/70 border border-purple-200 text-xs sm:text-sm font-bold text-[#635BFF] mb-4">
        <span>Connects In 1 Click</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#100F12] tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
        Plugs directly into your existing tech stack
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#5F5E6E] leading-relaxed">
        Sync contacts, order data, and tickets with the tools your team already uses daily.
      </p>
    </div>

    <!-- Integrations Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 max-w-4xl mx-auto">
      
      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-3">
          📱
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">WhatsApp Cloud API</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">Official Meta Business API</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center font-bold text-lg mb-3">
          📸
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">Instagram Direct</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">DMs, story mentions & ads</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center font-bold text-lg mb-3">
          ⭐
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">Google Business</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">Multi-location review sync</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg mb-3">
          🛍️
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">Shopify & WooCommerce</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">Live order & cart data sync</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center font-bold text-lg mb-3">
          🟧
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">HubSpot CRM</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">2-way contact & deal sync</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg mb-3">
          ☁️
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">Salesforce</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">Enterprise pipeline routing</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-lg mb-3">
          💳
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">Stripe</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">Payment links in chat</p>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-2xs hover:shadow-md hover:border-purple-300 transition-all text-left">
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-lg mb-3">
          ⚡
        </div>
        <h4 class="text-sm font-bold text-[#100F12]">Zapier & Webhooks</h4>
        <p class="text-xs text-[#5F5E6E] mt-1">Connect 5,000+ custom apps</p>
      </div>

    </div>

  </div>

</section>
