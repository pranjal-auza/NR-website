          </div>
        </div>

        <!-- Right Column: Visual Stage -->
        <div class="lg:col-span-5 relative flex items-center justify-center min-h-[260px] sm:min-h-[320px] bg-gradient-to-b from-[#EEF7FF]/80 to-[#E0EEFD]/40 rounded-2xl p-6 overflow-hidden border border-blue-100/80">
          <img 
            src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69997b9809fce849ce70bbf2_decoration-07.png" 
            alt="Slats Pattern" 
            class="absolute inset-0 w-full h-full object-cover opacity-60 pointer-events-none" 
          />
          <div class="relative z-10 flex -space-x-4 sm:-space-x-5 hover:scale-105 transition-transform duration-300">
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975cc05e55aa999c28ee7_952468d51aeebde9ee2be049a40f055a_avatar-21.jpg" alt="Avatar 1" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69a29cb0253f9fde4cf24dc9_bbdffbfbc5d6ab2e9e446930ae3857cc_avatar-26.jpg" alt="Avatar 2" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975ccfe08fc2b972448cb_27386279f857d2fb3abbed83c605fbda_avatar-20.png" alt="Avatar 3" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
          </div>
        </div>

      </div>

      <!-- Slide 3: Support Agent -->
      <div id="agent-slide-2" class="agent-slide hidden grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center transition-all duration-500">
        
        <!-- Left Column: Copy & Checklist -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="space-y-2.5">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[#100F12] font-['Plus_Jakarta_Sans']">
              Support agent template
            </h3>
            <p class="text-sm sm:text-base text-[#5F5E6E] leading-relaxed">
              Deflect common questions, draft replies, route edge cases, and keep internal notes clean.
            </p>
          </div>

          <!-- Feature List -->
          <div class="space-y-3.5 pt-2">
            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-50 border border-purple-200 text-[#5925DC] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="text-xs sm:text-sm font-medium text-[#100F12]">Pulls answers from docs and past tickets</p>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-50 border border-purple-200 text-[#5925DC] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
