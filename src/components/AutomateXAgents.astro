          <div class="relative z-10 flex -space-x-4 sm:-space-x-5 hover:scale-105 transition-transform duration-300">
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69a29cb0253f9fde4cf24dc9_bbdffbfbc5d6ab2e9e446930ae3857cc_avatar-26.jpg" alt="Avatar 1" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975ccfe08fc2b972448cb_27386279f857d2fb3abbed83c605fbda_avatar-20.png" alt="Avatar 2" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975cc05e55aa999c28ee7_952468d51aeebde9ee2be049a40f055a_avatar-21.jpg" alt="Avatar 3" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  function initAgentTabs() {
    const tabButtons = document.querySelectorAll(".agent-tab-btn");
    const slides = [
      document.getElementById("agent-slide-0"),
      document.getElementById("agent-slide-1"),
      document.getElementById("agent-slide-2")
    ];

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = parseInt(btn.getAttribute("data-index") || "0", 10);
        
        tabButtons.forEach((b, i) => {
          if (i === index) {
            b.className = "agent-tab-btn active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 bg-[#100F12] text-white shadow-sm";
          } else {
            b.className = "agent-tab-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 bg-white hover:bg-slate-50 text-[#5F5E6E] border border-slate-200/80";
          }
        });

        slides.forEach((slide, i) => {
          if (slide) {
            if (i === index) {
              slide.classList.remove("hidden");
              slide.classList.add("active");
            } else {
              slide.classList.add("hidden");
              slide.classList.remove("active");
            }
          }
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAgentTabs);
  } else {
    initAgentTabs();
  }
</script>
