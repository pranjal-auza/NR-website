          </div>
        </div>

        <!-- Right Column: Visual Stage -->
        <div class="lg:col-span-5 relative flex items-center justify-center min-h-[260px] sm:min-h-[320px] bg-gradient-to-b from-[#EFFFF6]/80 to-[#E0F9ED]/40 rounded-2xl p-6 overflow-hidden border border-emerald-100/80">
          <img 
            src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69997b9809fce849ce70bbf2_decoration-07.png" 
            alt="Slats Pattern" 
            class="absolute inset-0 w-full h-full object-cover opacity-60 pointer-events-none" 
