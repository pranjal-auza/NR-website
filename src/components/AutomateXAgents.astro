---
// AutomateX Agents Section: Ready-to-use agent templates
---

<section class="relative py-20 md:py-28 overflow-hidden bg-[#FAF8F5]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Title -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-14 md:mb-18">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-purple-200/90 bg-white/90 backdrop-blur-md text-xs sm:text-sm font-semibold text-[#5B21B6] shadow-2xs">
        <span>Ready-to-use agent templates</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#100F12] tracking-tight leading-[1.12] font-['Plus_Jakarta_Sans']">
        Start with an agent built for your work
      </h2>
    </div>

    <!-- Agent Tabs / Slider Controls -->
    <div class="flex items-center justify-center gap-2 mb-8 select-none">
      <button 
        id="tab-btn-0" 
        class="agent-tab-btn active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 bg-[#100F12] text-white shadow-sm"
        data-index="0"
      >
        PM Agent
      </button>
      <button 
        id="tab-btn-1" 
        class="agent-tab-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 bg-white hover:bg-slate-50 text-[#5F5E6E] border border-slate-200/80"
        data-index="1"
      >
        HR Agent
      </button>
      <button 
        id="tab-btn-2" 
        class="agent-tab-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 bg-white hover:bg-slate-50 text-[#5F5E6E] border border-slate-200/80"
        data-index="2"
      >
        Support Agent
      </button>
    </div>

    <!-- Slider Container -->
    <div class="relative bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-10 md:p-12 shadow-[0_20px_50px_rgba(20,15,40,0.06)] overflow-hidden">
      
      <!-- Slide 1: PM Agent -->
      <div id="agent-slide-0" class="agent-slide active grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center transition-all duration-500">
        
        <!-- Left Column: Copy & Checklist -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="space-y-2.5">
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[#100F12] font-['Plus_Jakarta_Sans']">
              PM agent template
            </h3>
            <p class="text-sm sm:text-base text-[#5F5E6E] leading-relaxed">
              Turn notes into PRDs, generate release notes, and keep Jira updates consistent across teams.
            </p>
          </div>

          <!-- Feature List -->
          <div class="space-y-3.5 pt-2">
            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-50 border border-purple-200 text-[#5925DC] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="text-xs sm:text-sm font-medium text-[#100F12]">PRD structure: problem, scope, UX, edge cases</p>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-50 border border-purple-200 text-[#5925DC] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <p class="text-xs sm:text-sm font-medium text-[#100F12]">Decision summaries with links back to sources</p>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-50 border border-purple-200 text-[#5925DC] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
