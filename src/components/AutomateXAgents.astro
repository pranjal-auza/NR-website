          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-4 pt-4">
            <a href="#pricing" class="btn-text-roll group inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#100F12] text-white font-semibold text-xs sm:text-sm hover:bg-[#23222A] transition-all shadow-md">
              <div class="button-text-wrap">
                <span class="text-default">Create agent</span>
                <span class="text-hover">Create agent</span>
              </div>
            </a>
            <a href="#pricing" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-[#5925DC] hover:text-[#4314A7] group">
