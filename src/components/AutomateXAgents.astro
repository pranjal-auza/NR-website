            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699975cc05e55aa999c28ee7_952468d51aeebde9ee2be049a40f055a_avatar-21.jpg" alt="Avatar 2" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
            <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/69a29cb0253f9fde4cf24dc9_bbdffbfbc5d6ab2e9e446930ae3857cc_avatar-26.jpg" alt="Avatar 3" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full border-3 border-white object-cover shadow-md" />
