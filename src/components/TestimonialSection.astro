---
// Testimonial & Social Proof Section — ASYMMETRIC TESTIMONIAL + METRICS COMPOSITION
---

<section class="py-20 md:py-32 bg-[#FCFCFA] border-b border-[#E9E9EF]/60 relative overflow-hidden">
  <!-- Subtle Atmospheric Gradient Glow -->
  <div class="absolute top-1/4 left-10 w-[700px] h-[400px] bg-[#F2EEFF]/60 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Eyebrow & Asymmetric Heading -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F2EEFF] border border-[#E0D7FF] text-xs font-bold tracking-wider text-[#635BFF] uppercase mb-4">
        <span>Proven Growth</span>
      </div>

      <h2 class="text-4xl sm:text-6xl font-extrabold text-[#17172A] tracking-[-0.04em] leading-[1.02] font-['Plus_Jakarta_Sans']">
        Real businesses. <br />
        <span class="text-[#635BFF]">Measurable momentum.</span>
      </h2>
    </div>

    <!-- Asymmetric Layout: Big Featured Quote (7 cols) + Metric Pillars (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Big Featured Quote Card (7 cols) -->
      <div class="lg:col-span-7 saas-card p-8 sm:p-10 bg-white border border-[#E9E9EF] rounded-[28px] shadow-[0_20px_60px_rgba(30,30,60,0.06)] relative overflow-hidden">
        
        <!-- Large Decorative Quote Mark -->
        <div class="text-[#635BFF]/15 text-7xl font-serif font-black leading-none absolute top-4 right-6 select-none pointer-events-none">
          “
        </div>

        <div class="space-y-6 relative z-10">
          <p class="text-lg sm:text-xl text-[#17172A] font-medium leading-relaxed">
            "Before NewRelay, our team was losing high-ticket buyers because Instagram DMs and WhatsApp inquiries were split across 4 different phones. Now, everything lands in one clean workspace. Our response time dropped from 4 hours to under 2 minutes."
          </p>

          <!-- Author Info Strip -->
          <div class="pt-4 border-t border-[#E9E9EF] flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-3.5">
              <div class="w-13 h-13 rounded-2xl overflow-hidden border-2 border-white shadow-sm flex-shrink-0">
                <img 
                  src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=200&auto=format&fit=crop&q=80" 
                  alt="Ananya Mehta" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div>
                <div class="font-bold text-sm sm:text-base text-[#17172A] font-['Plus_Jakarta_Sans']">Ananya Mehta</div>
                <div class="text-xs text-[#656579]">Co-Founder & CEO · GrowthKart</div>
              </div>
            </div>

            <!-- Verified Badge -->
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200">
              <span>✓ Verified Customer</span>
            </div>
          </div>
        </div>

      </div>

      <!-- 3 Impact Metric Pillars (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Metric 1 -->
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[20px] shadow-xs flex items-center justify-between">
          <div>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#635BFF] font-['Plus_Jakarta_Sans']">3.2x</div>
            <div class="text-xs font-bold text-[#17172A] mt-0.5">Faster First Response</div>
            <div class="text-[11px] text-[#656579]">Across WhatsApp, Instagram & Live Chat</div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-[#635BFF] flex items-center justify-center font-bold">
            ⚡
          </div>
        </div>

        <!-- Metric 2 -->
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[20px] shadow-xs flex items-center justify-between">
          <div>
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 font-['Plus_Jakarta_Sans']">+41%</div>
            <div class="text-xs font-bold text-[#17172A] mt-0.5">Inbound Conversion Rate</div>
            <div class="text-[11px] text-[#656579]">Zero missed leads during peak sales hours</div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
            📈
          </div>
        </div>

        <!-- Metric 3 -->
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[20px] shadow-xs flex items-center justify-between">
          <div>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans']">98.4%</div>
            <div class="text-xs font-bold text-[#17172A] mt-0.5">Positive CSAT Rating</div>
            <div class="text-[11px] text-[#656579]">Rated by over 1.2M end-customers</div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
            ★
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
