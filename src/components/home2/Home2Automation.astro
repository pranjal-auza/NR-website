---
// Home 2 Automation Section — "Let automation do the busy work."
---

<section class="w-full py-20 sm:py-24 lg:py-32 bg-gradient-to-b from-[#FCFCFA] via-[#F7F6FB] to-[#EEE9F7] relative overflow-hidden">
  
  <!-- Subtle, pale ambient glow towards the bottom -->
  <div class="absolute bottom-0 left-1/4 w-[700px] h-[350px] bg-purple-100/15 rounded-full blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute bottom-0 right-10 w-96 h-96 bg-indigo-100/10 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Editorial Copy + CTA Button (5 cols) -->
      <div class="lg:col-span-5 space-y-6 text-left">
        
        <!-- Eyebrow -->
        <div class="text-xs sm:text-[13px] font-bold uppercase tracking-[0.18em] text-[#64748B] font-['Plus_Jakarta_Sans']">
          AUTOMATE & SCALE
        </div>

        <!-- Main Heading -->
        <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-extrabold text-[#0F172A] tracking-[-0.035em] font-['Plus_Jakarta_Sans'] leading-[1.12]">
          Let automation <br class="hidden sm:block" />
          do the busy work<span class="text-[#635BFF]">.</span>
        </h2>

        <!-- Subtitle Description -->
        <p class="text-sm sm:text-[15px] text-[#64748B] font-normal leading-relaxed max-w-md">
          Create smart workflows, save time and keep your team in sync so you can focus on what really matters.
        </p>

        <!-- CTA Button -->
        <div class="pt-2">
          <a 
            href="#automation" 
            class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#0B0F19] hover:bg-[#1E293B] text-white text-xs sm:text-sm font-bold shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5 group cursor-pointer"
          >
            <span>See automation in action</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Visual Branching Workflow Diagram (7 cols) -->
      <div class="lg:col-span-7 relative flex items-center justify-center pt-8 sm:pt-12 lg:pt-0">
        
        <div class="w-full flex flex-col md:flex-row items-start justify-center gap-0 md:gap-3 lg:gap-4 relative">

          <!-- Left Trigger Stack (Positioned Higher at top) -->
          <div class="flex flex-col gap-4 w-full md:w-[280px] lg:w-[295px] relative z-10">
            
            <!-- Trigger 1: WhatsApp Message -->
            <div class="bg-white rounded-[20px] p-4 sm:p-4.5 border border-slate-100/90 shadow-[0_8px_24px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-all duration-300 flex items-center gap-3.5 group">
              <div class="w-10 h-10 rounded-xl bg-[#25D366] flex items-center justify-center text-white flex-shrink-0 shadow-sm shadow-[#25D366]/20">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.15c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.13.82.84-3.05-.2-.31a8.163 8.163 0 01-1.26-4.38c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.2-8.2 8.2zm4.49-6.14c-.25-.12-1.46-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.53.07-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.12.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.47-.29z"/>
                </svg>
              </div>
              <div class="text-left min-w-0 flex-1">
                <div class="text-[13px] sm:text-[14px] font-bold text-[#0F172A] whitespace-nowrap">When a new message arrives</div>
                <div class="text-[11px] text-[#64748B] font-medium mt-0.5">WhatsApp</div>
              </div>
            </div>

            <!-- Trigger 2: Contact Added (Solid Purple A: Logo Badge) -->
            <div class="bg-white rounded-[20px] p-4 sm:p-4.5 border border-slate-100/90 shadow-[0_8px_24px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-all duration-300 flex items-center gap-3.5 group relative">
              <div class="w-10 h-10 rounded-xl bg-[#635BFF] text-white flex items-center justify-center flex-shrink-0 shadow-sm shadow-[#635BFF]/25">
                <!-- Auza / NewRelay 'A:' Logo Glyph in White -->
                <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                  <path d="M4.5 19.5 L10.5 3.5 L14 3.5 L8 19.5 Z" />
                  <path d="M10 12.5 L15 12.5 L13.8 15.5 L8.8 15.5 Z" />
                  <circle cx="18.5" cy="11" r="1.6" />
                  <circle cx="18.5" cy="16.5" r="1.6" />
                </svg>
              </div>
              <div class="text-left min-w-0 flex-1">
                <div class="text-[13px] sm:text-[14px] font-bold text-[#0F172A] whitespace-nowrap">A contact is added</div>
                <div class="text-[11px] text-[#64748B] font-medium mt-0.5">NewRelay (All channels)</div>
              </div>
            </div>

            <!-- Trigger 3: Deal Created (Solid Orange Avatar Icon) -->
            <div class="bg-white rounded-[20px] p-4 sm:p-4.5 border border-slate-100/90 shadow-[0_8px_24px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-all duration-300 flex items-center gap-3.5 group">
              <div class="w-10 h-10 rounded-xl bg-[#F97316] text-white flex items-center justify-center flex-shrink-0 shadow-sm shadow-[#F97316]/25">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="4"/>
                  <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
                </svg>
              </div>
              <div class="text-left min-w-0 flex-1">
                <div class="text-[13px] sm:text-[14px] font-bold text-[#0F172A] whitespace-nowrap">A deal is created</div>
                <div class="text-[11px] text-[#64748B] font-medium mt-0.5">CRM</div>
              </div>
            </div>

          </div>

          <!-- Central Connecting Purple Branch Lines (Calculated with Horizontal Arrow Arrivals) -->
          <div class="hidden md:flex items-center justify-center w-20 lg:w-24 relative h-[320px] pointer-events-none flex-shrink-0">
            
            <!-- SVG Branch Paths matching exact diagonal offset coordinates with horizontal right arrows -->
            <svg class="w-full h-full" viewBox="0 0 80 320" fill="none">
              
              <!-- Main connecting stem from Trigger 2 center (y=124) -->
              <path d="M 0 124 L 25 124" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" />
              
              <!-- Top branch: Curves UPWARDS, then finishes HORIZONTALLY into Action 1 (y=92) -->
              <path d="M 25 124 C 45 124, 52 92, 76 92" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" />
              <path d="M 70 87 L 76 92 L 70 97" fill="none" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

              <!-- Middle branch: Curves DOWNWARDS, then finishes HORIZONTALLY into Action 2 (y=180) -->
              <path d="M 25 124 C 45 124, 50 180, 76 180" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" />
              <path d="M 70 175 L 76 180 L 70 185" fill="none" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

              <!-- Bottom branch: Curves further DOWNWARDS, then finishes HORIZONTALLY into Action 3 (y=268) -->
              <path d="M 25 124 C 45 124, 50 268, 76 268" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" />
              <path d="M 70 263 L 76 268 L 70 273" fill="none" stroke="#818CF8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />

              <!-- Central Pivot Circle Node -->
              <circle cx="25" cy="124" r="4.5" fill="white" stroke="#635BFF" stroke-width="2.5" />
            </svg>

          </div>

          <!-- Right Action Stack (Shifted Down Diagonally) -->
          <div class="flex flex-col gap-4 w-full md:w-[280px] lg:w-[295px] relative z-10 mt-6 md:mt-14">

            <!-- Action 1: Send Welcome Message (Clean diagonal paper plane icon) -->
            <div class="bg-white rounded-[20px] p-4 sm:p-4.5 border border-slate-100/90 shadow-[0_8px_24px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-all duration-300 flex items-center gap-3.5 group">
              <div class="w-10 h-10 rounded-xl bg-[#F4F1FE] text-[#635BFF] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#635BFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
              </div>
              <div class="text-left min-w-0 flex-1">
                <div class="text-[13px] sm:text-[14px] font-bold text-[#0F172A] whitespace-nowrap">Send welcome message</div>
                <div class="text-[11px] text-[#64748B] font-medium mt-0.5">Auto-reply</div>
              </div>
            </div>

            <!-- Action 2: Create Deal in CRM -->
            <div class="bg-white rounded-[20px] p-4 sm:p-4.5 border border-slate-100/90 shadow-[0_8px_24px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-all duration-300 flex items-center gap-3.5 group">
              <div class="w-10 h-10 rounded-xl bg-[#F4F1FE] text-[#635BFF] flex items-center justify-center flex-shrink-0">
                <!-- Link Icon -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
              </div>
              <div class="text-left min-w-0 flex-1">
                <div class="text-[13px] sm:text-[14px] font-bold text-[#0F172A] whitespace-nowrap">Create deal in CRM</div>
                <div class="text-[11px] text-[#64748B] font-medium mt-0.5">Add to pipeline</div>
              </div>
            </div>

            <!-- Action 3: Notify Team -->
            <div class="bg-white rounded-[20px] p-4 sm:p-4.5 border border-slate-100/90 shadow-[0_8px_24px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-all duration-300 flex items-center gap-3.5 group">
              <div class="w-10 h-10 rounded-xl bg-[#F4F1FE] text-[#635BFF] flex items-center justify-center flex-shrink-0">
                <!-- Team / Users Icon -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div class="text-left min-w-0 flex-1">
                <div class="text-[13px] sm:text-[14px] font-bold text-[#0F172A] whitespace-nowrap">Notify team</div>
                <div class="text-[11px] text-[#64748B] font-medium mt-0.5">Slack / Email</div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </div>
</section>
