---
// Home 2 Problem Section — "Your customers are everywhere. Conversations get lost."
---

<section class="py-20 lg:py-28 bg-[#FCFCFA] relative overflow-hidden">
  
  <!-- Subtle Background Atmospheric Glows -->
  <div class="absolute top-12 left-10 w-72 h-72 bg-pink-100/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-20 right-10 w-80 h-80 bg-indigo-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-1/3 w-96 h-96 bg-purple-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. Header Area: Pill Badge + Heading + Subtitle -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-[#EDE9FE] text-[#5E5CE6] text-xs font-bold uppercase tracking-wider mb-4 shadow-sm">
        THE PROBLEM
      </div>

      <!-- Headline -->
      <h2 class="text-3xl sm:text-5xl lg:text-[50px] font-extrabold text-[#0F172A] tracking-[-0.03em] font-['Plus_Jakarta_Sans'] leading-[1.15]">
        Your customers are everywhere. <br />
        Conversations <span class="text-[#5E5CE6]">get lost.</span>
      </h2>

      <!-- Subtitle -->
      <p class="text-sm sm:text-base text-[#64748B] max-w-xl mx-auto mt-4 font-normal leading-relaxed">
        Your customers message you on different channels. Your team juggles multiple tools. Important conversations slip through the cracks.
      </p>
    </div>

    <!-- 2. Interactive Graphic & Chaos Map -->
    <div class="relative max-w-6xl mx-auto pt-6 sm:pt-10">
      
      <!-- Desktop Visual Layout (Grid with Left Column, Center Visual, Right Column) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-4 items-center relative">
        
        <!-- Left Column: 4 Notification Cards + "Different channels." Doodle -->
        <div class="lg:col-span-4 flex flex-col gap-3.5 relative z-10 pt-6 sm:pt-4">
          
          <!-- Handwritten Annotation: Different channels (Positioned above & left of cards) -->
          <div class="absolute -top-14 -left-4 sm:-left-8 lg:-left-12 z-20 flex flex-col items-start pointer-events-none hidden sm:flex select-none">
            <span class="font-['Caveat'] text-2xl sm:text-[28px] font-bold text-[#1E293B] -rotate-6 tracking-wide leading-tight">
              Different<br/>channels.
            </span>
            <svg class="w-10 h-10 text-[#334155] -mt-1 ml-4" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M10 6 C 16 18, 20 26, 30 30 M 20 30 L 30 30 L 30 20" />
            </svg>
          </div>

          <!-- Card 1: WhatsApp -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-full bg-[#25D366] flex items-center justify-center text-white flex-shrink-0 shadow-sm">
              <!-- WhatsApp Icon SVG -->
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.15c-1.5 0-2.97-.4-4.25-1.16l-.3-.18-3.13.82.84-3.05-.2-.31a8.163 8.163 0 01-1.26-4.38c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.4 3.61 2.4 5.8 0 4.52-3.68 8.2-8.2 8.2zm4.49-6.14c-.25-.12-1.46-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.53.07-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.08s.89 2.41 1.01 2.58c.12.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.47-.29z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">Priya Sharma</span>
                <span class="text-[10px] text-slate-400 font-medium">10:24 AM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Hi! Do you have this in stock?</p>
            </div>
          </div>

          <!-- Card 2: Instagram -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#F58529] via-[#DD2A7B] to-[#8134AF] flex items-center justify-center text-white flex-shrink-0 shadow-sm">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">Aarav Mehta</span>
                <span class="text-[10px] text-slate-400 font-medium">11:03 AM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Can you share the pricing?</p>
            </div>
          </div>

          <!-- Card 3: Gmail -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center flex-shrink-0 shadow-sm">
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.5 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-3v-9.25L12 14.5 6 10.75V20H3a1.5 1.5 0 0 1-1.5-1.5v-13a1.5 1.5 0 0 1 2.37-1.22L12 9.5l8.13-5.22A1.5 1.5 0 0 1 22.5 5.5z"/>
                <path fill="#EA4335" d="M22.5 5.5L12 12.5 1.5 5.5"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">Neha Kapoor</span>
                <span class="text-[10px] text-slate-400 font-medium">12:17 PM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Here's the document you...</p>
            </div>
          </div>

          <!-- Card 4: Phone / Missed Call -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-full bg-[#10B981] flex items-center justify-center text-white flex-shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.44-5.15-3.75-6.59-6.59l1.97-1.57c.28-.28.36-.67.25-1.02A11.36 11.36 0 018.57 3.99c0-.55-.45-1-1-1H4.11c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.48c0-.55-.45-1-1-.13z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">+91 98765 43210</span>
                <span class="text-[10px] text-slate-400 font-medium">01:02 PM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Missed call (2 mins)</p>
            </div>
          </div>

        </div>

        <!-- Center Column: Central Stressed Character + Laptop + Doodle Notes -->
        <div class="lg:col-span-4 relative flex items-center justify-center my-6 lg:my-0">
          
          <div class="relative w-full max-w-[360px] sm:max-w-[400px] mx-auto flex items-center justify-center">
            
            <!-- Handwritten Annotation: Too many tools. Too much chaos. (Positioned cleanly above character) -->
            <div class="absolute -top-14 right-2 sm:right-6 z-20 flex flex-col items-start pointer-events-none hidden sm:flex select-none">
              <span class="font-['Caveat'] text-xl sm:text-2xl font-bold text-[#1E293B] rotate-2 leading-tight">
                Too many tools.<br/>Too much chaos.
              </span>
              <svg class="w-8 h-8 text-[#334155] ml-6 mt-1" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M18 4 C 18 14, 16 22, 6 26 M 12 26 L 6 26 L 7 20" />
              </svg>
            </div>

            <!-- Soft Lavender Backdrop Organic Blob -->
            <div class="absolute inset-0 bg-[#EDE9FE]/70 rounded-[48px] transform scale-95 opacity-90 -z-10 shadow-xs"></div>

            <!-- Central Graphic Image -->
            <div class="relative z-10 w-full p-2 flex items-center justify-center">
              <img 
                src="/graphic.webp" 
                alt="Stressed employee overwhelmed by disconnected tools" 
                class="w-full h-auto object-contain mx-auto select-none transform hover:scale-[1.03] transition-transform duration-300 drop-shadow-xs"
              />
            </div>

          </div>

        </div>

        <!-- Right Column: 4 Notification Cards + "Valuable conversations slip away." Doodle -->
        <div class="lg:col-span-4 flex flex-col gap-3.5 relative z-10 pt-6 sm:pt-4">
          
          <!-- Card 1: Messenger -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#00C6FF] via-[#0078FF] to-[#A824FF] flex items-center justify-center text-white flex-shrink-0 shadow-sm">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.91 1.455 5.517 3.735 7.18V22l3.417-1.874c.905.251 1.862.387 2.848.387 5.523 0 10-4.145 10-9.255C22 6.145 17.523 2 12 2zm1.002 12.441l-2.55-2.723-4.977 2.723 5.474-5.811 2.613 2.723 4.914-2.723-5.474 5.811z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">Rohan Verma</span>
                <span class="text-[10px] text-slate-400 font-medium">02:14 PM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Is delivery available in my area?</p>
            </div>
          </div>

          <!-- Card 2: Support Chat / Sneha Iyer -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-xl bg-[#3B82F6] flex items-center justify-center text-white flex-shrink-0 shadow-sm">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 10H6v-2h12v2zm0-3H6V7h12v2z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">Sneha Iyer</span>
                <span class="text-[10px] text-slate-400 font-medium">03:21 PM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Can you confirm my order?</p>
            </div>
          </div>

          <!-- Card 3: Google Review -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center flex-shrink-0 shadow-sm">
              <!-- Google "G" Icon -->
              <svg class="w-5 h-5" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <!-- 5 Stars -->
                <div class="flex items-center gap-0.5 text-amber-400 text-xs">
                  <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                </div>
                <span class="text-[10px] text-slate-400 font-medium">2 hours ago</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Great service! But I have a question...</p>
            </div>
          </div>

          <!-- Card 4: Website Live Chat -->
          <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-100 shadow-[0_8px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_35px_rgba(0,0,0,0.08)] transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-3.5 group">
            <div class="w-10 h-10 rounded-xl bg-[#6366F1] flex items-center justify-center text-white flex-shrink-0 shadow-sm">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z M8 11h2v2H8v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <div class="flex items-center justify-between">
                <span class="text-xs sm:text-sm font-bold text-[#0F172A]">Website Visitor</span>
                <span class="text-[10px] text-slate-400 font-medium">04:05 PM</span>
              </div>
              <p class="text-xs text-slate-600 font-normal truncate mt-0.5">Hi! I need help with integration.</p>
            </div>
          </div>

          <!-- Handwritten Annotation: Valuable conversations slip away (Positioned on the outer right flank) -->
          <div class="absolute top-[52%] -right-8 lg:-right-36 xl:-right-40 -translate-y-1/2 z-20 hidden lg:flex flex-col items-start pointer-events-none select-none">
            <span class="font-['Caveat'] text-xl sm:text-2xl font-bold text-[#1E293B] -rotate-3 leading-tight whitespace-nowrap">
              Valuable<br/>conversations<br/>slip away.
            </span>
            <svg class="w-10 h-10 text-[#334155] mt-1 ml-4 transform -rotate-12" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M26 6 C 22 18, 16 26, 6 30 M 14 30 L 6 30 L 8 22" />
            </svg>
          </div>

        </div>

      </div>

    </div>

    <!-- 3. Bottom Metrics Grid: 4 Modern Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-16 sm:mt-24 max-w-6xl mx-auto">
      
      <!-- Metric 1: 73% -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_25px_rgba(0,0,0,0.06)] transition-all duration-300 flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-xl bg-[#FEE2E2]/70 text-[#EF4444] flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-[#0F172A] font-['Plus_Jakarta_Sans'] leading-tight">73%</div>
          <p class="text-xs text-[#64748B] font-medium leading-tight mt-1">of customer messages go unanswered</p>
        </div>
      </div>

      <!-- Metric 2: 2.5x -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_25px_rgba(0,0,0,0.06)] transition-all duration-300 flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-xl bg-[#FEF3C7]/80 text-[#F59E0B] flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-[#0F172A] font-['Plus_Jakarta_Sans'] leading-tight">2.5x</div>
          <p class="text-xs text-[#64748B] font-medium leading-tight mt-1">more tools to manage conversations</p>
        </div>
      </div>

      <!-- Metric 3: 60% -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_25px_rgba(0,0,0,0.06)] transition-all duration-300 flex items-center gap-4 group">
        <div class="w-12 h-12 rounded-xl bg-[#EDE9FE]/80 text-[#6366F1] flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
