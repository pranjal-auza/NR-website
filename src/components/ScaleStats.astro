---
import Icon from './icons/Icon.astro';
---

<section class="py-20 border-t border-subtle-stroke relative overflow-hidden bg-secondary-bg/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface border border-subtle-stroke text-[11px] font-mono font-medium text-caption-fg">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>GLOBAL INFRASTRUCTURE TELEMETRY</span>
      </div>
      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-foreground">
        Engineered for mission-critical enterprise scale.
      </h2>
      <p class="text-sm sm:text-base text-secondary-fg">
        Production-grade reliability for global revenue operations, 24/7 sales desks, and autonomous AI agents.
      </p>
    </div>

    <!-- 4 Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="p-6 sm:p-7 rounded-2xl enterprise-card text-center space-y-2">
        <div class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight font-mono">
          180M+
        </div>
        <div class="text-xs sm:text-sm font-semibold text-brand-400">Messages & Events / mo</div>
        <div class="text-[11px] text-caption-fg">WhatsApp, SMS, Live Chat & Email</div>
      </div>

      <div class="p-6 sm:p-7 rounded-2xl enterprise-card text-center space-y-2">
        <div class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight font-mono">
          $1.4B+
        </div>
        <div class="text-xs sm:text-sm font-semibold text-emerald-400">Pipeline Value Influenced</div>
        <div class="text-[11px] text-caption-fg">Directly attributed in New-Relay CRM</div>
      </div>

      <div class="p-6 sm:p-7 rounded-2xl enterprise-card text-center space-y-2">
        <div class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight font-mono">
          &lt; 10s
        </div>
        <div class="text-xs sm:text-sm font-semibold text-purple-400">Average Speed to Lead</div>
        <div class="text-[11px] text-caption-fg">Instant autonomous Captain AI triage</div>
      </div>

      <div class="p-6 sm:p-7 rounded-2xl enterprise-card text-center space-y-2">
        <div class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight font-mono">
          99.99%
        </div>
        <div class="text-xs sm:text-sm font-semibold text-amber-400">Enterprise SLA Guarantee</div>
        <div class="text-[11px] text-caption-fg">Multi-region carrier failover routing</div>
      </div>

    </div>

  </div>
</section>
