---
// AutomateX Core Features Section: 5-Card Bento Grid with Visuals
---

<section class="relative py-20 md:py-28 overflow-hidden bg-[#FAF8F5]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Title Block -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end mb-14 md:mb-18">
      <div class="lg:col-span-8 space-y-3.5 text-left">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-purple-200 bg-purple-50/60 text-xs sm:text-sm font-semibold text-[#5B21B6]">
          <span>Core features</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#100F12] tracking-tight font-['Plus_Jakarta_Sans'] leading-[1.12]">
          Built to turn decisions into reliable actions
        </h2>
      </div>
      <div class="lg:col-span-4 text-left lg:text-right">
        <p class="text-sm sm:text-base text-[#5F5E6E] leading-relaxed">
          Generate agents that behave consistently, stay within boundaries, and give teams complete visibility.
        </p>
      </div>
    </div>

    <!-- Bento Grid (2 Columns Top, 1 Full-Width Bottom) -->
    <div class="space-y-6">
      
      <!-- Top Row 2-Column Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left Column (6 cols): 2 Stacked Cards -->
        <div class="lg:col-span-6 space-y-6 flex flex-col justify-between">
          
          <!-- Card 1: Workflow Actions with Guardrails -->
          <div class="bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-8 shadow-[0_16px_40px_rgba(20,15,40,0.04)] hover:shadow-[0_20px_50px_rgba(99,91,255,0.08)] transition-all duration-300 flex flex-col justify-between overflow-hidden">
            <div class="space-y-2 mb-6">
              <h3 class="text-xl sm:text-2xl font-bold text-[#100F12] font-['Plus_Jakarta_Sans']">
                Workflow actions with guardrails
              </h3>
              <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed">
                Agents draft summaries, create tasks, and route work. You decide what runs automatically and what needs human approval.
              </p>
            </div>
            <div class="relative rounded-2xl bg-gradient-to-b from-[#F7F4FE] to-[#ECE5FD] p-4 flex items-center justify-center border border-purple-100/60">
              <img 
                src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699c2d869d7ef1bef6a6a19a_e5aaf410332778fbe552269d6a4e827f_vector-13.png" 
                alt="Guardrails Feature" 
                class="w-full h-auto object-contain max-h-[180px]" 
                loading="lazy"
              />
            </div>
          </div>

          <!-- Card 2: Source Boundaries & Context -->
          <div class="bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-8 shadow-[0_16px_40px_rgba(20,15,40,0.04)] hover:shadow-[0_20px_50px_rgba(99,91,255,0.08)] transition-all duration-300 flex flex-col justify-between overflow-hidden">
            <div class="space-y-2 mb-6">
              <h3 class="text-xl sm:text-2xl font-bold text-[#100F12] font-['Plus_Jakarta_Sans']">
                Source boundaries & context
              </h3>
              <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed">
                Limit what agents can access by defining approved sources like docs, help centers, or internal pages.
              </p>
            </div>
            
            <!-- Source Badges Cluster -->
            <div class="relative rounded-2xl bg-[#FAF9FC] border border-slate-200/80 p-5 flex flex-wrap gap-2.5 items-center justify-center">
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-purple-200 text-xs font-semibold text-[#100F12] shadow-2xs">
                <span class="text-purple-600">📚</span>
                <span>Help Center</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-red-200 text-xs font-semibold text-[#100F12] shadow-2xs">
                <span class="text-red-500">📄</span>
                <span>Document.pdf</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-blue-200 text-xs font-semibold text-[#100F12] shadow-2xs">
                <span class="text-blue-500">🌐</span>
                <span>https://example.com</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-amber-200 text-xs font-semibold text-[#100F12] shadow-2xs">
                <span class="text-amber-500">📝</span>
                <span>Company Wiki</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column (6 cols): 2 Feature Cards -->
        <div class="lg:col-span-6 space-y-6 flex flex-col justify-between">
          
          <!-- Card 3: Ready-Made Templates & Customization (Dark/Vibrant Card) -->
          <div class="bg-[#100F18] border border-slate-800 text-white rounded-3xl p-6 sm:p-8 shadow-xl flex flex-col justify-between overflow-hidden relative group">
            
            <div class="space-y-2 mb-6 relative z-10">
              <h3 class="text-xl sm:text-2xl font-bold text-white font-['Plus_Jakarta_Sans']">
                Template workflows with rules
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Create agents with ready-made templates or custom rules. Customize behavior without starting from scratch.
              </p>
            </div>

            <!-- Graphic and Action -->
            <div class="relative rounded-2xl bg-slate-900/90 border border-slate-800 p-5 flex flex-col items-center justify-center space-y-4">
              <img 
                src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d1adfa907c3b3094b2d47_3d2607c6e16f7533a465178c37054270_vector-14.png" 
                alt="Template Vector" 
                class="w-full h-auto object-contain max-h-[160px]" 
                loading="lazy"
              />
              <a href="#agents" class="btn-text-roll inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-white text-[#100F12] hover:bg-slate-100 text-xs font-bold shadow-md transition-all">
                <div class="button-text-wrap">
                  <span class="text-default">View all agents</span>
                  <span class="text-hover">View all agents</span>
                </div>
              </a>
            </div>

          </div>

          <!-- Card 4: Visibility & Audit Trails -->
          <div class="bg-white border border-[#EBE8E3] rounded-3xl p-6 sm:p-8 shadow-[0_16px_40px_rgba(20,15,40,0.04)] hover:shadow-[0_20px_50px_rgba(99,91,255,0.08)] transition-all duration-300 flex flex-col justify-between overflow-hidden">
            <div class="space-y-2 mb-6">
              <h3 class="text-xl sm:text-2xl font-bold text-[#100F12] font-['Plus_Jakarta_Sans']">
                Visibility & audit trails
              </h3>
              <p class="text-xs sm:text-sm text-[#5F5E6E] leading-relaxed">
                Every agent action is logged and traceable, so teams can understand what happened and why.
              </p>
            </div>

            <!-- Stacked Avatars with Trust Badges -->
            <div class="rounded-2xl bg-[#FAF9FC] border border-slate-200/80 p-5 flex items-center justify-center">
              <div class="flex items-center -space-x-3">
                <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d21f40954a36bd5129a46_avatar-01.jpg" alt="User 1" class="w-11 h-11 rounded-full border-2 border-white object-cover shadow-sm" />
                <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d21f4626b0dea9e9207e7_avatar-02.jpg" alt="User 2" class="w-13 h-13 rounded-full border-2 border-white object-cover shadow-md z-10 transform scale-110" />
                <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d21f42af6f87823342f80_avatar-03.jpg" alt="User 3" class="w-11 h-11 rounded-full border-2 border-white object-cover shadow-sm" />
                <img src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d21f45fa8481718f181f0_avatar-04.jpg" alt="User 4" class="w-11 h-11 rounded-full border-2 border-white object-cover shadow-sm" />
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- Bottom Full-Width Card: Analytics & Improvement (Dark Atmospheric Card) -->
      <div class="bg-[#12111A] border border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl overflow-hidden relative text-white">
        
        <!-- Subtle Purple Radial Halo in background -->
        <div class="absolute -top-24 -right-24 w-[400px] h-[400px] bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
          
          <div class="lg:col-span-6 space-y-6 text-left">
            <div class="space-y-3">
              <h3 class="text-2xl sm:text-4xl font-extrabold text-white font-['Plus_Jakarta_Sans'] leading-tight">
                Analytics & improvement
              </h3>
              <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-lg">
                Track adoption, common topics, deflection, and escalation reasons. Fix gaps by improving sources and rules seamlessly.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a href="#pricing" class="btn-text-roll group inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-gradient-to-r from-[#5925DC] via-[#7C3AED] to-[#C026D3] text-white font-semibold text-xs sm:text-sm shadow-[0_10px_25px_rgba(124,58,237,0.4)] hover:shadow-[0_14px_30px_rgba(124,58,237,0.5)] transition-all">
                <div class="button-text-wrap">
                  <span class="text-default">Start free trial</span>
                  <span class="text-hover">Start free trial</span>
                </div>
              </a>
              <a href="#agents" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white hover:text-purple-300 transition-colors group">
                <span>View all agents</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-6 flex items-center justify-center">
            <img 
              src="https://cdn.prod.website-files.com/69982176124aec6884c510af/699d2d5583ded3bc4064f90d_a51219de210c8fbe349b0dd09373d2f4_vector-18.png" 
              alt="Analytics Graphic" 
              class="w-full max-w-md h-auto object-contain drop-shadow-xl" 
              loading="lazy"
            />
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
