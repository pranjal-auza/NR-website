---
// Automation Section — ASYMMETRIC WORKFLOW BUILDER COMPOSITION
---

<section id="automation" class="py-20 md:py-32 bg-[#FCFCFA] border-b border-[#E9E9EF]/60 relative overflow-hidden">
  <!-- Subtle Mint Pastel Atmospheric Background Glow -->
  <div class="absolute top-1/4 right-10 w-[700px] h-[450px] bg-[#EEFAF5] rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Asymmetric Top Header: Offset Left & Floating Pill -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-12 sm:mb-16">
      
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EEFAF5] border border-[#C6F0DF] text-xs font-bold tracking-wider text-emerald-700 uppercase">
          <span>Visual Workflow Engine</span>
        </div>

        <h2 class="text-4xl sm:text-6xl font-extrabold text-[#17172A] tracking-[-0.04em] leading-[1.02] font-['Plus_Jakarta_Sans']">
          Let automation <br />
          <span class="text-emerald-600">handle the busywork.</span>
        </h2>
      </div>

      <div class="lg:col-span-5 space-y-4">
        <p class="text-base sm:text-lg text-[#656579] leading-relaxed">
          Build multi-branch conversational flows, auto-qualify inbound leads, route tickets based on intent, and trigger external webhooks — with zero code required.
        </p>
        
        <div class="flex items-center gap-4 pt-1">
          <a href="#demo" class="btn-dark">
            <span>Explore workflow builder</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Asymmetric Main Canvas: Node Tree Visual Builder + Floating Real-time Stats -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Main Visual Node Tree (8 cols) -->
      <div class="lg:col-span-8">
        <div class="product-surface p-6 sm:p-8 bg-white border border-[#E9E9EF] rounded-[24px] shadow-[0_20px_60px_rgba(30,30,60,0.06)] relative overflow-hidden">

          <!-- Builder Header Bar -->
          <div class="flex items-center justify-between pb-6 border-b border-[#E9E9EF]">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-[#EEFAF5] border border-[#C6F0DF] flex items-center justify-center text-emerald-600 font-bold">
                ⚡
              </div>
              <div>
                <div class="font-bold text-sm text-[#17172A]">VIP Lead Qualification & Auto-Routing</div>
                <div class="text-[11px] text-[#656579]">Active · Executed 2,840 times today</div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Live</span>
              </span>
            </div>
          </div>

          <!-- Interactive Node Tree -->
          <div class="pt-8 space-y-6 max-w-xl mx-auto">
            
            <!-- NODE 1: Trigger -->
            <div class="saas-card p-4 border border-[#E9E9EF] bg-white rounded-2xl shadow-xs relative">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-xs shadow-sm">
                    1
                  </div>
                  <div>
                    <div class="text-[10px] font-bold text-[#9696A8] uppercase tracking-wider">Trigger</div>
                    <div class="font-bold text-xs sm:text-sm text-[#17172A]">New Inbound Message Arrives</div>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 text-[10px] font-bold">WhatsApp</span>
                  <span class="px-2 py-0.5 rounded bg-rose-50 text-rose-800 text-[10px] font-bold">Instagram</span>
                </div>
              </div>
            </div>

            <!-- Connector Line Down -->
            <div class="flex justify-center -my-2">
              <div class="w-0.5 h-6 bg-emerald-300"></div>
            </div>

            <!-- NODE 2: AI Intent & Condition -->
            <div class="saas-card p-4 border border-purple-200 bg-[#F4F0FF]/50 rounded-2xl shadow-xs relative">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl bg-[#635BFF] text-white flex items-center justify-center font-bold text-xs shadow-sm shadow-[#635BFF]/30">
                    2
                  </div>
                  <div>
                    <div class="text-[10px] font-bold text-[#635BFF] uppercase tracking-wider">AI Intent Classifier</div>
                    <div class="font-bold text-xs sm:text-sm text-[#17172A]">Evaluate Sentiment & Purchase Intent</div>
                  </div>
                </div>
                <span class="text-[10px] bg-purple-100 text-purple-800 font-bold px-2 py-0.5 rounded">GPT-4o Vision</span>
              </div>
            </div>

            <!-- Branch Fork Lines -->
            <div class="grid grid-cols-2 gap-4 -my-2 px-12">
              <div class="border-l-2 border-emerald-400 h-6"></div>
              <div class="border-r-2 border-slate-300 h-6 ml-auto"></div>
            </div>

            <!-- NODE 3 & 4: Asymmetric Branch Actions -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              
              <!-- Branch A: High Intent VIP -->
              <div class="p-4 rounded-2xl bg-[#EEFAF5] border border-emerald-200/80 shadow-xs space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider">Branch A · High Intent</span>
                  <span class="text-[9px] bg-emerald-600 text-white font-bold px-1.5 py-0.2 rounded">Matched (74%)</span>
                </div>
                
                <div class="space-y-2 text-xs">
                  <div class="p-2.5 bg-white rounded-xl border border-emerald-100 shadow-2xs flex items-center gap-2">
                    <span class="text-emerald-600 font-bold">⚡</span>
                    <span class="text-[#17172A] font-semibold">Assign to Senior Closer</span>
                  </div>

                  <div class="p-2.5 bg-white rounded-xl border border-emerald-100 shadow-2xs flex items-center gap-2">
                    <span class="text-emerald-600 font-bold">📦</span>
                    <span class="text-[#17172A] font-semibold">Sync Deal to CRM / HubSpot</span>
                  </div>
                </div>
              </div>

              <!-- Branch B: General FAQ / After-Hours -->
              <div class="p-4 rounded-2xl bg-white border border-[#E9E9EF] shadow-xs space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold text-[#656579] uppercase tracking-wider">Branch B · General FAQ</span>
                  <span class="text-[9px] bg-[#F4F4F6] text-[#656579] font-bold px-1.5 py-0.2 rounded">Matched (26%)</span>
                </div>

                <div class="space-y-2 text-xs">
                  <div class="p-2.5 bg-[#FCFCFA] rounded-xl border border-[#E9E9EF] shadow-2xs flex items-center gap-2">
                    <span class="text-blue-600 font-bold">🤖</span>
                    <span class="text-[#17172A] font-semibold">Trigger Instant AI Assistant</span>
                  </div>

                  <div class="p-2.5 bg-[#FCFCFA] rounded-xl border border-[#E9E9EF] shadow-2xs flex items-center gap-2">
                    <span class="text-amber-500 font-bold">📋</span>
                    <span class="text-[#17172A] font-semibold">Share PDF Catalog & Pricing</span>
                  </div>
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>

      <!-- Asymmetric Supporting Side Cards (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        
        <!-- Metric Card 1 -->
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[20px] shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-[#EEFAF5] text-emerald-600 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <div class="text-3xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans']">85%</div>
          <div class="text-sm font-bold text-[#17172A] mt-1">Zero-Touch Resolution</div>
          <p class="text-xs text-[#656579] mt-1 leading-relaxed">
            Resolve frequent questions, delivery lookups, and appointment scheduling automatically 24/7.
          </p>
        </div>

        <!-- Metric Card 2 -->
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[20px] shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-[#635BFF] flex items-center justify-center mb-3">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="text-3xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans']">&lt; 15s</div>
          <div class="text-sm font-bold text-[#17172A] mt-1">First Response Latency</div>
          <p class="text-xs text-[#656579] mt-1 leading-relaxed">
            Never let high-intent leads wait. Engage prospects within seconds of their first message.
          </p>
        </div>

        <!-- Metric Card 3 -->
        <div class="saas-card p-6 bg-white border border-[#E9E9EF] rounded-[20px] shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="text-3xl font-extrabold text-[#17172A] font-['Plus_Jakarta_Sans']">100%</div>
          <div class="text-sm font-bold text-[#17172A] mt-1">Context Preservation</div>
          <p class="text-xs text-[#656579] mt-1 leading-relaxed">
            When a human agent steps in, all past conversation branches and customer data are right there.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
