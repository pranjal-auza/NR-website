---
// Bottom Call to Action Section — CENTERED ATMOSPHERIC CONTAINER COMPOSITION
---

<section class="py-20 md:py-32 bg-[#FCFCFA] relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Centered Atmospheric Card Container -->
    <div class="relative rounded-[28px] sm:rounded-[36px] p-8 sm:p-16 lg:p-20 border border-[#E0D7FF] bg-gradient-to-b from-[#F2EEFF] via-[#EEF5FF] to-white shadow-[0_20px_70px_rgba(99,91,255,0.08)] overflow-hidden text-center">
      
      <!-- Subtle Background Glows -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-purple-200/40 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 border border-purple-200 text-xs font-bold tracking-wider text-[#635BFF] uppercase shadow-xs">
          <span>Ready to Scale?</span>
        </div>

        <!-- Headline (2-3 intentional lines) -->
        <h2 class="text-4xl sm:text-6xl font-extrabold text-[#17172A] tracking-[-0.04em] leading-[1.02] font-['Plus_Jakarta_Sans']">
          Turn conversations <br />
          into <span class="text-[#635BFF]">revenue today.</span>
        </h2>

        <!-- Softer Supporting Text -->
        <p class="text-base sm:text-lg text-[#656579] leading-relaxed max-w-xl mx-auto font-normal">
          Join thousands of high-growth teams using NewRelay to unify WhatsApp, Instagram, Email, and SMS into one intelligent workspace.
        </p>

        <!-- Compact Buttons -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a href="#start" class="btn-dark px-8 shadow-lg shadow-slate-900/10 group">
            <span>Start for free</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <a href="#demo" class="btn-white px-7">
            <span>Book a demo</span>
          </a>
        </div>

        <!-- Trust Badges Strip -->
        <div class="pt-6 flex flex-wrap items-center justify-center gap-6 text-xs text-[#656579] font-medium">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#635BFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="16 9 10 15 8 13"/>
            </svg>
            <span>No credit card required</span>
          </div>

          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#635BFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="16 9 10 15 8 13"/>
            </svg>
            <span>14-day full feature trial</span>
          </div>

          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#635BFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="16 9 10 15 8 13"/>
            </svg>
            <span>2-minute guided setup</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
