---
import Icon from './icons/Icon.astro';
---

<section id="demo" class="py-28 border-t border-subtle-stroke relative overflow-hidden bg-background">
  <!-- Radial Glow Behind Banner -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[400px] bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-8">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full enterprise-card text-xs font-semibold text-secondary-fg shadow-attio-1 font-mono">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>SOC 2 Type II Certified • 99.99% Carrier SLA</span>
    </div>

    <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground leading-[1.1]">
      Autonomous revenue & conversations <br class="hidden sm:inline" />
      run on <span class="text-gradient-brand">New-Relay</span>.
    </h2>

    <p class="text-base sm:text-xl text-secondary-fg max-w-2xl mx-auto leading-relaxed">
      Connect your WhatsApp, SMS, and Email in minutes. Deploy Captain AI and start closing high-intent deals around the clock.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a href="#pricing" class="button-primary text-base px-8 py-3.5 rounded-xl shadow-attio-4 w-full sm:w-auto font-medium">
        <span>Start 14-Day Free Trial</span>
        <Icon name="arrow-right" class="w-4 h-4 ml-2" />
      </a>

      <a href="#demo" class="button-outline text-base px-8 py-3.5 rounded-xl w-full sm:w-auto font-medium flex items-center justify-center gap-2">
        <Icon name="play" class="w-4 h-4 text-brand-400" />
        <span>Book an Enterprise Walkthrough</span>
      </a>
    </div>

    <!-- Trust signals -->
    <div class="pt-6 text-xs text-caption-fg flex flex-wrap justify-center items-center gap-6 font-mono">
      <span class="flex items-center gap-1">✓ No credit card required</span>
      <span class="flex items-center gap-1">✓ 1-click migration from Intercom & HubSpot</span>
      <span class="flex items-center gap-1">✓ Dedicated Onboarding Engineer</span>
    </div>

  </div>
</section>
