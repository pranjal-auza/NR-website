---
// NewRelay Hero Section — Human-Centric, Grounded Customer Conversation & Reputation SaaS Hero
---

<section class="relative pt-10 pb-20 md:pt-16 md:pb-28 overflow-hidden bg-white">
  
  <!-- Subtle ambient background warmth & depth -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden select-none">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[1000px] h-[550px] bg-gradient-to-b from-purple-100/40 via-indigo-50/30 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-purple-200/20 rounded-full blur-[90px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Top Block: Trust Eyebrow, Main Headline, Subtitle, CTAs, Trust Guarantees -->
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center space-y-6 sm:space-y-7">
      
      <!-- Social Proof Eyebrow Pill -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white border border-slate-200/90 shadow-[0_2px_10px_rgba(0,0,0,0.04)] hover:border-purple-300 transition-colors">
        <div class="flex -space-x-2">
          <img 
            src="https://cdn.prod.website-files.com/673442f44c948080a43e913b/673592bcb033b09ad5f3ed3f_user-1.png" 
            alt="Customer 1" 
            class="w-6 h-6 rounded-full border-2 border-white object-cover" 
          />
          <img 
            src="https://cdn.prod.website-files.com/673442f44c948080a43e913b/673592bcafb16ca7bb760d97_user-2.png" 
            alt="Customer 2" 
            class="w-6 h-6 rounded-full border-2 border-white object-cover" 
          />
          <img 
            src="https://cdn.prod.website-files.com/673442f44c948080a43e913b/673592bc40140078962527b6_user-3.png" 
            alt="Customer 3" 
            class="w-6 h-6 rounded-full border-2 border-white object-cover" 
          />
        </div>
        <p class="text-xs sm:text-sm font-semibold text-[#100F12] tracking-tight">
          Loved by 1,200+ growing teams • <span class="text-amber-500">★★★★★</span> 4.9/5 on G2 & Capterra
        </p>
      </div>

      <!-- Main Display Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-[66px] font-extrabold text-[#100F12] tracking-[-0.035em] leading-[1.08] font-['Plus_Jakarta_Sans']">
        Turn every customer conversation <br class="hidden sm:inline" />
        into <span class="text-[#635BFF]">lasting business growth</span>
      </h1>

      <!-- Grounded Subtitle Description -->
      <p class="text-base sm:text-lg md:text-xl text-[#5F5E6E] max-w-2xl mx-auto leading-relaxed font-normal">
        Bring WhatsApp, Instagram DMs, Google Reviews, Email, and SMS into one unified workspace. Automate routine replies, coordinate your team, and close deals without switching tools.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3.5 sm:gap-4 pt-1 sm:pt-2">
        
        <!-- Primary Action Button -->
        <a 
          href="#pricing" 
          class="btn-text-roll group relative inline-flex items-center justify-center px-8 py-4 rounded-full text-white font-semibold text-sm sm:text-base bg-[#635BFF] hover:bg-[#5248E5] shadow-[0_10px_28px_rgba(99,91,255,0.35)] hover:shadow-[0_14px_34px_rgba(99,91,255,0.48)] transform hover:-translate-y-0.5 transition-all duration-300"
        >
          <div class="button-text-wrap">
            <span class="text-default">Start 14-day free trial</span>
            <span class="text-hover">Start 14-day free trial</span>
          </div>
        </a>

        <!-- Secondary Action Button -->
        <a 
          href="#demo" 
          class="btn-text-roll group relative inline-flex items-center justify-center px-7 py-4 rounded-full text-[#100F12] font-semibold text-sm sm:text-base bg-white hover:bg-slate-50 border border-slate-200 shadow-[0_4px_16px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.08)] transform hover:-translate-y-0.5 transition-all duration-300"
        >
          <div class="button-text-wrap">
            <span class="text-default text-[#100F12]">Book a 15-min demo</span>
            <span class="text-hover text-[#100F12]">Book a 15-min demo</span>
          </div>
        </a>

      </div>

      <!-- Trust Badges Strip -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-[#5F5E6E] pt-2">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>No credit card required</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Setup in under 5 minutes</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Official Meta WhatsApp Partner</span>
        </div>
      </div>

    </div>

    <!-- Centerpiece Dashboard Showcase with Contextual Live Badges -->
    <div class="relative mt-14 sm:mt-18 md:mt-20 max-w-5xl mx-auto select-none">
      
      <!-- Ambient Purple/Indigo Backlight Glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] sm:w-[850px] h-[350px] sm:h-[450px] bg-purple-400/15 rounded-full blur-[110px] pointer-events-none -z-10"></div>

      <!-- Floating Live Context Badge 1 (Top Left: WhatsApp Lead) -->
      <div class="hidden lg:flex items-center gap-2.5 absolute -top-5 -left-6 z-20 bg-white/95 backdrop-blur-md border border-slate-200/90 rounded-2xl px-4 py-2.5 shadow-[0_12px_32px_rgba(23,23,42,0.08)] transform -rotate-1 hover:rotate-0 transition-transform">
        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs font-bold text-[#100F12]">WhatsApp Lead Answered</p>
          <p class="text-[11px] text-[#5F5E6E]">18s response time • <span class="font-semibold text-emerald-600">Won $2,400 deal</span></p>
        </div>
      </div>

      <!-- Floating Live Context Badge 2 (Top Right: Google Review) -->
      <div class="hidden lg:flex items-center gap-2.5 absolute -top-5 -right-6 z-20 bg-white/95 backdrop-blur-md border border-slate-200/90 rounded-2xl px-4 py-2.5 shadow-[0_12px_32px_rgba(23,23,42,0.08)] transform rotate-1 hover:rotate-0 transition-transform">
        <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center shrink-0">
          <span class="text-sm">⭐</span>
        </div>
        <div class="text-left">
          <p class="text-xs font-bold text-[#100F12]">New 5-Star Review Captured</p>
          <p class="text-[11px] text-[#5F5E6E]">Automated Google invite • <span class="font-semibold text-[#635BFF]">Posted live</span></p>
        </div>
      </div>

      <!-- Elevated Dashboard Showcase Frame -->
      <div class="relative rounded-2xl sm:rounded-3xl border border-slate-200/90 bg-white p-2 sm:p-3.5 shadow-[0_28px_80px_rgba(23,23,42,0.1),0_10px_26px_rgba(23,23,42,0.05)] overflow-hidden">
        <img 
          src="/hero-image.png" 
          alt="NewRelay Workspace & Reputation Dashboard" 
          class="w-full h-auto rounded-xl sm:rounded-2xl object-cover select-none" 
        />
      </div>

    </div>

  </div>

</section>
