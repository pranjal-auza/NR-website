---
// AutomateX Floating Pill Navbar
---

<header id="site-header" class="sticky top-0 z-50 w-full transition-all duration-300 pt-3 md:pt-4">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 transition-all duration-300">
    
    <!-- Floating Pill Container -->
    <div 
      id="navbar-pill" 
      class="w-full bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-full px-5 sm:px-6 py-2.5 sm:py-3 shadow-[0_10px_30px_rgba(0,0,0,0.04)] flex items-center justify-between"
    >
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center group py-1">
        <img 
          src="/new-relay-logo.svg" 
          alt="NewRelay" 
          class="h-7 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105" 
        />
      </a>

      <!-- Desktop Nav Menu -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8">
        
        <a href="#inbox" class="text-xs sm:text-sm font-semibold text-[#5F5E6E] hover:text-[#100F12] transition-colors">
          Inbox
        </a>

        <a href="#automation" class="text-xs sm:text-sm font-semibold text-[#5F5E6E] hover:text-[#100F12] transition-colors">
          Automation
        </a>

        <a href="#reviews" class="text-xs sm:text-sm font-semibold text-[#5F5E6E] hover:text-[#100F12] transition-colors">
          Reviews
        </a>

        <a href="#features" class="text-xs sm:text-sm font-semibold text-[#5F5E6E] hover:text-[#100F12] transition-colors">
          Features
        </a>

        <a href="#pricing" class="text-xs sm:text-sm font-semibold text-[#5F5E6E] hover:text-[#100F12] transition-colors">
          Pricing
        </a>

        <!-- Versions Dropdown (Home 1, Home 2, Home 3, Home 4) -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#17172A] bg-purple-50/80 hover:bg-purple-100/80 text-[#635BFF] px-3 py-1.5 rounded-full transition-all cursor-pointer border border-purple-200/80">
            <span class="w-1.5 h-1.5 rounded-full bg-[#635BFF] animate-pulse"></span>
            <span>Versions</span>
            <svg class="w-3.5 h-3.5 text-[#635BFF] group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          
          <div class="absolute top-full right-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50 pointer-events-none group-hover:pointer-events-auto">
            <div class="w-60 bg-white/98 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-[0_16px_40px_rgba(23,23,42,0.12)] p-2 flex flex-col gap-1">
              <div class="px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Select Version</div>
              <a href="/" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                <span>Home 1 (Omnichannel)</span>
                <span class="text-[10px] font-bold text-[#635BFF] bg-purple-100/80 px-2 py-0.5 rounded-full">v1</span>
              </a>
              <a href="/home-2" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                <span>Home 2 (Reputation)</span>
                <span class="text-[10px] font-bold text-amber-600 bg-amber-100/80 px-2 py-0.5 rounded-full">v2</span>
              </a>
              <a href="/home-3" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                <span>Home 3 (Full Stack)</span>
                <span class="text-[10px] font-bold text-indigo-600 bg-indigo-100/80 px-2 py-0.5 rounded-full">v3</span>
              </a>
              <a href="/home-4" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#17172A] hover:bg-purple-50 hover:text-[#635BFF] transition-colors">
                <span>Home 4 (Custom Canvas)</span>
                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-full">v4</span>
              </a>
            </div>
          </div>
        </div>

      </nav>

      <!-- Right Action Buttons & Mobile Hamburger -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        
        <a 
          href="#demo" 
          class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-full text-[#100F12] hover:bg-slate-100 font-semibold text-xs sm:text-sm transition-all"
        >
          Book demo
        </a>

        <a 
          href="#pricing" 
          class="btn-text-roll group inline-flex items-center justify-center px-5 py-2 sm:px-5.5 sm:py-2.5 rounded-full bg-[#635BFF] hover:bg-[#5248E5] text-white font-semibold text-xs sm:text-sm shadow-[0_4px_14px_rgba(99,91,255,0.3)] transition-all"
        >
          <div class="button-text-wrap">
            <span class="text-default">Start free trial</span>
            <span class="text-hover">Start free trial</span>
          </div>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="md:hidden p-1.5 text-slate-700 hover:text-[#100F12] focus:outline-none" aria-label="Toggle menu">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

      </div>

    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden md:hidden mt-2 bg-white/98 backdrop-blur-xl border border-slate-200 rounded-2xl p-4 shadow-xl flex flex-col gap-2.5 text-left">
      <a href="#inbox" class="text-sm font-semibold text-[#5F5E6E] py-1 hover:text-[#100F12]">Inbox</a>
      <a href="#automation" class="text-sm font-semibold text-[#5F5E6E] py-1 hover:text-[#100F12]">Automation</a>
      <a href="#reviews" class="text-sm font-semibold text-[#5F5E6E] py-1 hover:text-[#100F12]">Reviews</a>
      <a href="#features" class="text-sm font-semibold text-[#5F5E6E] py-1 hover:text-[#100F12]">Features</a>
      <a href="#pricing" class="text-sm font-semibold text-[#5F5E6E] py-1 hover:text-[#100F12]">Pricing</a>
      <div class="pt-2 border-t border-slate-100 flex flex-col gap-1.5">
        <a href="/home-2" class="text-xs font-semibold text-slate-700 py-1">Switch to Home 2 (Reputation)</a>
        <a href="/home-3" class="text-xs font-semibold text-slate-700 py-1">Switch to Home 3 (Full Stack)</a>
        <a href="/home-4" class="text-xs font-semibold text-slate-700 py-1">Switch to Home 4</a>
      </div>
    </div>

  </div>
</header>

<script>
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  mobileBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });
</script>
