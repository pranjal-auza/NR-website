---
import Icon from '../icons/Icon.astro';
---

<section class="relative pt-8 pb-16 md:pt-14 md:pb-24 overflow-hidden bg-[#FAFAFC] dark:bg-[#07090D] transition-colors duration-300 bg-attio-grid">
  
  <!-- Ambient Top Glow -->
  <div class="radial-glow-top"></div>

  <!-- Secondary Backdrop Canvas Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[900px] h-[450px] bg-gradient-to-b from-blue-500/10 via-indigo-500/5 to-transparent dark:from-blue-600/20 dark:via-indigo-600/10 dark:to-transparent rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Header Text Block -->
    <div class="text-center max-w-4xl mx-auto space-y-4 sm:space-y-5">
      
      <!-- Linear / Attio Glass Pill Badge -->
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full glass-badge text-xs font-medium text-neutral-800 dark:text-neutral-200 transition-all hover:border-blue-500/30 dark:hover:border-blue-500/40 cursor-pointer shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600 dark:bg-blue-400"></span>
        </span>
        <span class="font-semibold text-neutral-900 dark:text-white font-mono text-[11px] tracking-tight">CAPTAIN AI 2.0</span>
        <span class="text-neutral-300 dark:text-neutral-700">|</span>
        <span class="text-blue-600 dark:text-blue-400 font-medium">Autonomous Omnichannel Revenue Engine</span>
        <span class="text-neutral-400 group-hover:translate-x-0.5 transition-transform text-xs">→</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-[64px] font-bold tracking-[-0.035em] leading-[1.08] text-neutral-950 dark:text-white max-w-4xl mx-auto">
        The intelligent revenue OS <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-500 dark:from-blue-400 dark:via-indigo-300 dark:to-blue-400 bg-clip-text text-transparent">that never sleeps.</span>
      </h1>

      <!-- Balanced Subtitle -->
      <p class="text-sm sm:text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl mx-auto font-normal">
        Unify WhatsApp Business API, 2-way SMS, Live Chat, and CRM pipelines. Captain AI qualifies budgets, answers technical objections at 2 AM, and routes high-intent deals in seconds.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-1.5">
        <a 
          href="#demo" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-neutral-950 hover:bg-neutral-800 dark:bg-white dark:hover:bg-neutral-100 text-white dark:text-neutral-950 font-medium text-sm shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer w-full sm:w-auto"
        >
          <span>Start free trial</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>

        <a 
          href="#interactive-canvas" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white dark:bg-[#12161F] hover:bg-neutral-50 dark:hover:bg-[#1B212E] text-neutral-800 dark:text-white border border-neutral-200 dark:border-[#222938] font-medium text-sm shadow-sm transition-all cursor-pointer w-full sm:w-auto group"
        >
          <div class="w-5 h-5 rounded-full bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-[10px] group-hover:scale-110 transition-transform">
            ▶
          </div>
          <span>Explore Live Canvas</span>
        </a>
      </div>

      <!-- Institutional Trust Indicators -->
      <div class="flex flex-wrap items-center justify-center gap-5 sm:gap-7 text-xs text-neutral-500 dark:text-neutral-400 pt-1 font-mono">
        <span class="flex items-center gap-1.5"><span class="text-blue-600 dark:text-blue-400 font-bold">✓</span> No credit card required</span>
        <span class="flex items-center gap-1.5"><span class="text-blue-600 dark:text-blue-400 font-bold">✓</span> 2-min instant carrier sync</span>
        <span class="flex items-center gap-1.5"><span class="text-blue-600 dark:text-blue-400 font-bold">✓</span> SOC 2 Type II &amp; HIPAA compliant</span>
      </div>
    </div>

    <!-- Above-The-Fold Command Center Canvas Showcase -->
    <div id="interactive-canvas" class="mt-8 sm:mt-10 max-w-6xl mx-auto relative">
      
      <!-- Floating Telemetry Card 1: Top Left -->
      <div class="hidden xl:flex absolute -top-5 -left-8 z-30 items-center gap-3 px-3.5 py-2.5 rounded-xl bg-white/95 dark:bg-[#0F141F]/95 backdrop-blur-md border border-neutral-200 dark:border-[#222B3D] shadow-xl text-xs">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-mono font-bold text-xs">
          99.6%
        </div>
        <div>
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 font-mono uppercase">Guardrail Precision</div>
          <div class="font-bold text-neutral-900 dark:text-white">Zero Hallucinations</div>
        </div>
      </div>

      <!-- Floating Telemetry Card 2: Bottom Right -->
      <div class="hidden xl:flex absolute -bottom-5 -right-8 z-30 items-center gap-3 px-3.5 py-2.5 rounded-xl bg-white/95 dark:bg-[#0F141F]/95 backdrop-blur-md border border-neutral-200 dark:border-[#222B3D] shadow-xl text-xs">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-mono font-bold text-xs">
          ⚡
        </div>
        <div>
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 font-mono uppercase">Inbound Triage</div>
          <div class="font-bold text-neutral-900 dark:text-white">Sub-10s Auto-Response</div>
        </div>
      </div>

      <!-- Main Browser Window Canvas -->
      <div class="rounded-2xl sm:rounded-3xl linear-canvas overflow-hidden transition-all">
        
        <!-- Canvas Top Bar -->
        <div class="flex items-center justify-between px-3.5 sm:px-5 py-3 bg-[#F8F9FA] dark:bg-[#121722] border-b border-neutral-200 dark:border-[#1E2636] text-xs">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-[#FF5F56]/90"></span>
              <span class="w-3 h-3 rounded-full bg-[#FFBD2E]/90"></span>
              <span class="w-3 h-3 rounded-full bg-[#27C93F]/90"></span>
            </div>
            <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-white dark:bg-[#0A0D12] border border-neutral-200 dark:border-[#1E2636] text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
              <span class="text-emerald-500">https://</span>
              <span>relay.ai/revenue-os/live</span>
            </div>
          </div>

          <!-- Interactive View Tabs Inside Canvas -->
          <div class="flex items-center gap-1 bg-neutral-200/60 dark:bg-[#1A2232] p-1 rounded-lg">
            <button 
              id="hero-tab-stream" 
              class="hero-view-tab active px-2.5 py-1 rounded-md text-[11px] font-medium bg-white dark:bg-[#0A0D12] text-neutral-900 dark:text-white shadow-xs transition-all cursor-pointer"
            >
              Omnichannel Stream
            </button>
            <button 
              id="hero-tab-ai" 
              class="hero-view-tab px-2.5 py-1 rounded-md text-[11px] font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer"
            >
              Captain AI Resolver
            </button>
            <button 
              id="hero-tab-pipeline" 
              class="hero-view-tab px-2.5 py-1 rounded-md text-[11px] font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer"
            >
              Pipeline Matrix
            </button>
          </div>
        </div>

        <!-- Canvas Body (Responsive Grid) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[440px] text-xs">
          
          <!-- Column 1: Multi-Channel Inbox List (4 cols) -->
          <div class="lg:col-span-4 border-r border-neutral-200 dark:border-[#1E2636] p-3 space-y-2 bg-[#FAFBFC] dark:bg-[#0A0D12]">
            <div class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-[#1E2636] text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
              <span>ACTIVE INBOUND CHANNELS</span>
              <span class="px-1.5 py-0.5 rounded bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold">3 LIVE</span>
            </div>

            <!-- Thread 1: WhatsApp (Active) -->
            <div class="p-3 rounded-xl bg-white dark:bg-[#131926] border-2 border-blue-500 dark:border-blue-400 shadow-sm cursor-pointer space-y-1.5 transition-all">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
                    WA
                  </div>
                  <div>
                    <div class="font-bold text-neutral-950 dark:text-white flex items-center gap-1">
                      <span>Sarah Jenkins</span>
                      <span class="text-emerald-500 text-[10px]">✓</span>
                    </div>
                    <div class="text-[10px] text-neutral-500">VP Ops @ CloudScale Bio</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold">02:14 AM</span>
              </div>
              <p class="text-neutral-600 dark:text-neutral-300 line-clamp-2 text-[11px]">
                "We have 120 global reps. Can New-Relay auto-enrich leads, answer pricing FAQs, and create deals in our pipeline?"
              </p>
              <div class="flex items-center gap-1.5 pt-0.5">
                <span class="px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400 text-[10px] font-mono font-medium">Captain AI Triaged</span>
                <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono font-bold">$75,000 ARR</span>
              </div>
            </div>

            <!-- Thread 2: SMS Enterprise Lead -->
            <div class="p-3 rounded-xl bg-white/70 dark:bg-[#10141E]/70 hover:bg-white dark:hover:bg-[#131926] border border-neutral-200/80 dark:border-[#1E2636] transition-all cursor-pointer space-y-1">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-lg bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-xs">
                    SMS
                  </div>
                  <div>
                    <div class="font-bold text-neutral-900 dark:text-white">Marcus Thorne</div>
                    <div class="text-[10px] text-neutral-500">CRO @ FinTrack Systems</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-neutral-400">3m ago</span>
              </div>
              <p class="text-neutral-500 dark:text-neutral-400 truncate text-[11px]">
                "Contract approved by legal. Please provision 40 user seats."
              </p>
              <div class="flex items-center gap-1 text-[10px] text-neutral-400 font-mono">
                <span class="text-blue-500">→</span> Automated Sign-off Ingested
              </div>
            </div>

            <!-- Thread 3: Video Review Flow -->
            <div class="p-3 rounded-xl bg-white/70 dark:bg-[#10141E]/70 hover:bg-white dark:hover:bg-[#131926] border border-neutral-200/80 dark:border-[#1E2636] transition-all cursor-pointer space-y-1">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
                    VID
                  </div>
                  <div>
                    <div class="font-bold text-neutral-900 dark:text-white">Elena Rostova</div>
                    <div class="text-[10px] text-neutral-500">Head of Growth @ Railway</div>
                  </div>
                </div>
                <span class="text-[10px] font-mono text-amber-500 font-bold">5.0 ★</span>
              </div>
              <p class="text-neutral-500 dark:text-neutral-400 truncate text-[11px]">
                "Submitted 60-second verified review via WhatsApp link."
              </p>
            </div>
          </div>

          <!-- Column 2: Live Conversation & AI Autonomous Action (5 cols) -->
          <div class="lg:col-span-5 p-4 flex flex-col justify-between border-r border-neutral-200 dark:border-[#1E2636] bg-white dark:bg-[#0D1117]">
            <div class="space-y-3">
              
              <!-- Session Header -->
              <div class="flex items-center justify-between pb-2.5 border-b border-neutral-100 dark:border-[#1A2232] text-xs">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="font-bold text-neutral-900 dark:text-white">Live Session #REL-9481</span>
                  <span class="px-1.5 py-0.2 rounded bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono">WhatsApp 2-Way</span>
                </div>
                <span class="text-[10px] font-mono text-neutral-400">SOC 2 Enforced</span>
              </div>

              <!-- Message 1: Inbound Lead -->
              <div class="flex items-start gap-2.5 max-w-[94%]">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] shrink-0 font-bold">
                  SJ
                </div>
                <div class="p-3 rounded-2xl rounded-tl-none bg-[#F4F5F7] dark:bg-[#141A26] border border-neutral-200 dark:border-[#1E2636] text-[11px] text-neutral-900 dark:text-white space-y-1">
                  <div class="flex items-center justify-between gap-4 text-[10px]">
                    <span class="font-bold text-emerald-600 dark:text-emerald-400">Sarah Jenkins (WhatsApp)</span>
                    <span class="text-neutral-400 font-mono">02:14:02 AM</span>
                  </div>
                  <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed">
                    We manage 120 global reps across 4 regions. Does New-Relay support multi-tenant role permissions, custom RAG indexing on internal healthcare documentation, and direct Salesforce bi-directional sync?
                  </p>
                </div>
              </div>

              <!-- Message 2: Captain AI Autonomous Execution -->
              <div class="flex items-start gap-2.5 max-w-[96%] ml-auto flex-row-reverse">
                <div class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] shrink-0 shadow-sm">
                  ⚡
                </div>
                <div class="p-3.5 rounded-2xl rounded-tr-none bg-blue-50/60 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-500/30 text-[11px] text-neutral-900 dark:text-white space-y-2">
                  <div class="flex items-center justify-between gap-4 text-[10px]">
                    <span class="font-bold text-blue-600 dark:text-blue-400 flex items-center gap-1">
                      <span>Captain AI Autonomous Response</span>
                    </span>
                    <span class="text-neutral-500 dark:text-neutral-400 font-mono">Confidence: 99.6%</span>
                  </div>
                  <p class="text-neutral-800 dark:text-neutral-200 leading-relaxed">
                    Hello Sarah! Yes, absolutely. New-Relay is architected for this:
                  </p>
                  <ul class="space-y-1 text-neutral-600 dark:text-neutral-300 pl-1 text-[10px]">
                    <li>• <strong>Hierarchical RBAC:</strong> Partition 120 reps into regional sales pods.</li>
                    <li>• <strong>Universal Context™:</strong> In-memory RAG with strict Zero Data Retention.</li>
                    <li>• <strong>Bi-Directional CRM Sync:</strong> Sub-50ms sync with Salesforce &amp; HubSpot.</li>
                  </ul>
                  
                  <div class="p-2 rounded-lg bg-white dark:bg-[#0D1117] border border-blue-200 dark:border-blue-500/20 flex items-center justify-between text-[10px] font-mono">
                    <span class="text-neutral-500">Automated Pipeline Action:</span>
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓ Created Deal: $75,000 ARR</span>
                  </div>
                </div>
              </div>

            </div>

            <!-- Composer / Quick Command Bar -->
            <div class="pt-3 mt-3 border-t border-neutral-100 dark:border-[#1E2636] flex items-center gap-2">
              <div class="flex-1 px-3 py-1.5 rounded-lg bg-[#F8F9FA] dark:bg-[#121722] border border-neutral-200 dark:border-[#1E2636] text-[11px] text-neutral-400 flex items-center justify-between">
                <span>Captain AI monitoring live stream (press '/' for macros)</span>
                <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-white dark:bg-[#1B2232] text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">⌘K</span>
              </div>
              <button class="p-1.5 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-bold hover:scale-105 transition-transform">
                <Icon name="zap" class="w-3.5 h-3.5" />
              </button>
            </div>
          </div>

          <!-- Column 3: Live Customer 360 & Telemetry (3 cols) -->
          <div class="lg:col-span-3 p-3.5 bg-[#FAFBFC] dark:bg-[#0A0D12] space-y-3">
            <div class="text-[10px] font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider font-mono">
              Live Customer 360 &amp; Context™
            </div>

            <!-- Organization Card -->
            <div class="p-3 rounded-xl bg-white dark:bg-[#12161F] border border-neutral-200 dark:border-[#1E2636] space-y-2 shadow-xs">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-xs">
                  CS
                </div>
                <div>
                  <div class="font-bold text-neutral-950 dark:text-white text-xs">CloudScale Bio</div>
                  <div class="text-[10px] text-neutral-400 font-mono">cloudscale.bio</div>
                </div>
              </div>

              <div class="pt-2 border-t border-neutral-100 dark:border-[#1E2636] space-y-1.5 text-[10px]">
                <div class="flex justify-between">
                  <span class="text-neutral-500">Pipeline Stage:</span>
                  <span class="font-bold text-blue-600 dark:text-blue-400">Demo Scheduled</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-neutral-500">Contract Value:</span>
                  <span class="font-bold text-neutral-900 dark:text-white font-mono">$75,000 / yr</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-neutral-500">ICP Fit Score:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono">99.4% (Tier 1)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-neutral-500">Assigned Rep:</span>
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">Sarah M.</span>
                </div>
              </div>
            </div>

            <!-- Action Triggers -->
            <div class="p-3 rounded-xl bg-white dark:bg-[#12161F] border border-neutral-200 dark:border-[#1E2636] space-y-1.5 shadow-xs">
              <div class="text-[10px] font-semibold text-neutral-500 dark:text-neutral-400 uppercase font-mono">One-Click Workflows</div>
              <button class="w-full text-left px-2.5 py-1.5 rounded-lg bg-[#F8F9FA] dark:bg-[#161D2B] hover:bg-blue-50 dark:hover:bg-blue-500/10 text-[10px] font-medium text-neutral-700 dark:text-neutral-300 transition-colors flex items-center justify-between">
                <span>Trigger 60s Video Review</span>
                <span class="text-blue-600 dark:text-blue-400">→</span>
              </button>
              <button class="w-full text-left px-2.5 py-1.5 rounded-lg bg-[#F8F9FA] dark:bg-[#161D2B] hover:bg-blue-50 dark:hover:bg-blue-500/10 text-[10px] font-medium text-neutral-700 dark:text-neutral-300 transition-colors flex items-center justify-between">
                <span>Sync Deal to Salesforce</span>
                <span class="text-emerald-600 dark:text-emerald-400">✓</span>
              </button>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Enterprise Customer Logos Bar -->
    <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-[#1E2636] text-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-5 font-mono">
        Trusted by high-growth revenue leaders, modern sales teams, and global enterprises
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
        <span class="font-display font-bold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-white">LINEAR</span>
        <span class="font-display font-bold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-white">MODAL</span>
        <span class="font-display font-bold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-white">GRANOLA</span>
        <span class="font-display font-bold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-white">RAILWAY</span>
        <span class="font-display font-bold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-white">TASKRABBIT</span>
        <span class="font-display font-bold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-white">STRIPE</span>
      </div>
    </div>

  </div>
</section>

<script>
  // Interactive View Tabs logic inside the Hero Canvas
  const tabStream = document.getElementById('hero-tab-stream');
  const tabAi = document.getElementById('hero-tab-ai');
  const tabPipeline = document.getElementById('hero-tab-pipeline');
  const allTabs = document.querySelectorAll('.hero-view-tab');

  const setTabActive = (activeEl: HTMLElement) => {
    allTabs.forEach(tab => {
      tab.classList.remove('active', 'bg-white', 'dark:bg-[#0A0D12]', 'text-neutral-900', 'dark:text-white', 'shadow-xs');
      tab.classList.add('text-neutral-600', 'dark:text-neutral-400');
    });
    activeEl.classList.add('active', 'bg-white', 'dark:bg-[#0A0D12]', 'text-neutral-900', 'dark:text-white', 'shadow-xs');
    activeEl.classList.remove('text-neutral-600', 'dark:text-neutral-400');
  };

  if (tabStream && tabAi && tabPipeline) {
    tabStream.addEventListener('click', () => setTabActive(tabStream));
    tabAi.addEventListener('click', () => setTabActive(tabAi));
    tabPipeline.addEventListener('click', () => setTabActive(tabPipeline));
  }
</script>
