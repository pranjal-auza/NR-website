---
import Icon from '../icons/Icon.astro';
---

<section id="features" class="py-20 md:py-28 border-t border-neutral-200 dark:border-[#1E2636] bg-[#FAFAFC] dark:bg-[#07090D] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header in Attio Two-Tone Style -->
    <div class="max-w-3xl mb-16 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-semibold uppercase tracking-wider font-mono">
        <span>The Revenue Operating System</span>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-neutral-950 dark:text-white">
        Built to run your entire revenue engine. <br />
        <span class="text-neutral-400 dark:text-neutral-500 font-normal">From first WhatsApp ping to multi-year enterprise expansion.</span>
      </h2>
    </div>

    <!-- Attio Vertical Motion Tabs Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Vertical Tab List (5 cols) -->
      <div class="lg:col-span-5 space-y-3">
        
        <!-- Tab 1 -->
        <div class="attio-tab active p-5 rounded-2xl bg-white dark:bg-[#12161F] border-l-4 border-blue-600 dark:border-blue-500 border-t border-r border-b border-[#E5E7EB] dark:border-[#222938] shadow-sm cursor-pointer transition-all space-y-1" data-tab="1">
          <div class="flex items-center justify-between">
            <span class="text-base font-bold text-neutral-950 dark:text-white">1. Omnichannel Team Inbox</span>
            <span class="text-xs font-mono text-blue-600 dark:text-blue-400 font-semibold">01</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            WhatsApp Business API, 2-way SMS, Live Chat, and Email flow into a single unified stream with collision locking.
          </p>
        </div>

        <!-- Tab 2 -->
        <div class="attio-tab p-5 rounded-2xl bg-transparent hover:bg-white/60 dark:hover:bg-[#12161F]/60 border-l-4 border-transparent border-t border-r border-b border-transparent shadow-none cursor-pointer transition-all space-y-1" data-tab="2">
          <div class="flex items-center justify-between">
            <span class="text-base font-bold text-neutral-950 dark:text-white">2. Captain AI Autonomous Resolver</span>
            <span class="text-xs font-mono text-neutral-400">02</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            24/7 lead triage grounded on your company product docs. Zero hallucinations with strict deterministic guardrails.
          </p>
        </div>

        <!-- Tab 3 -->
        <div class="attio-tab p-5 rounded-2xl bg-transparent hover:bg-white/60 dark:hover:bg-[#12161F]/60 border-l-4 border-transparent border-t border-r border-b border-transparent shadow-none cursor-pointer transition-all space-y-1" data-tab="3">
          <div class="flex items-center justify-between">
            <span class="text-base font-bold text-neutral-950 dark:text-white">3. CRM & Deal Pipelines</span>
            <span class="text-xs font-mono text-neutral-400">03</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Drag-and-drop visual Kanban velocity. Automatic deal creation upon high-intent prospect message with ARR tracking.
          </p>
        </div>

        <!-- Tab 4 -->
        <div class="attio-tab p-5 rounded-2xl bg-transparent hover:bg-white/60 dark:hover:bg-[#12161F]/60 border-l-4 border-transparent border-t border-r border-b border-transparent shadow-none cursor-pointer transition-all space-y-1" data-tab="4">
          <div class="flex items-center justify-between">
            <span class="text-base font-bold text-neutral-950 dark:text-white">4. 60s Video Social Proof Engine</span>
            <span class="text-xs font-mono text-neutral-400">04</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Frictionless browser-based video recording widget. Trigger SMS & WhatsApp review requests post-purchase.
          </p>
        </div>

        <!-- Tab 5 -->
        <div class="attio-tab p-5 rounded-2xl bg-transparent hover:bg-white/60 dark:hover:bg-[#12161F]/60 border-l-4 border-transparent border-t border-r border-b border-transparent shadow-none cursor-pointer transition-all space-y-1" data-tab="5">
          <div class="flex items-center justify-between">
            <span class="text-base font-bold text-neutral-950 dark:text-white">5. Security & Isolation Enclave</span>
            <span class="text-xs font-mono text-neutral-400">05</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Zero LLM Data Retention guarantee, Private VPC on AWS/GCP, SOC 2 Type II, and signed HIPAA BAA agreements.
          </p>
        </div>

      </div>

      <!-- Right Column: Interactive Mockup Display (7 cols) -->
      <div class="lg:col-span-7 rounded-3xl bg-white dark:bg-[#0D1117] border border-[#E5E7EB] dark:border-[#1E2636] shadow-xl p-6 min-h-[460px] flex flex-col justify-between">
        
        <!-- Mockup Top Bar -->
        <div class="flex items-center justify-between pb-4 border-b border-[#E5E7EB] dark:border-[#1E2636] text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
            <span id="tab-mockup-title" class="font-bold text-neutral-950 dark:text-white font-mono">
              FEATURE VIEW: 01 // Omnichannel Team Inbox
            </span>
          </div>
          <span class="text-emerald-600 dark:text-emerald-400 font-mono text-[11px]">System Status: ACTIVE ✓</span>
        </div>

        <!-- Dynamic Mockup Content Container -->
        <div id="tab-mockup-content" class="py-6 space-y-4 font-sans">
          
          <div class="p-4 rounded-2xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-neutral-900 dark:text-white flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Inbound WhatsApp Lead: CloudScale Bio ($75,000 ARR)
              </span>
              <span class="text-neutral-400 font-mono text-[11px]">02:14 AM</span>
            </div>
            <p class="text-xs text-neutral-700 dark:text-neutral-300">
              "We have 120 global reps. Can New-Relay auto-enrich leads, answer pricing FAQs, and create deals in our pipeline without human lag?"
            </p>
            <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 text-xs text-blue-900 dark:text-blue-200 space-y-1">
              <div class="font-bold flex items-center gap-1.5">
                <Icon name="bot" class="w-3.5 h-3.5" />
                <span>Captain AI Deterministic Action:</span>
              </div>
              <div>✓ Enriched Domain &amp; Verified Budget ($75k)</div>
              <div>✓ Created Pipeline Opportunity in Salesforce &amp; Alerted Rep Sarah</div>
            </div>
          </div>

        </div>

        <!-- Mockup Footer -->
        <div class="pt-4 border-t border-[#E5E7EB] dark:border-[#1E2636] flex items-center justify-between text-xs font-mono text-neutral-500">
          <span>Telemetry: 12ms Latency • Zero LLM Retention</span>
          <a href="#demo" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
            Test this workflow in sandbox →
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.attio-tab');
  const titleEl = document.getElementById('tab-mockup-title');
  const contentEl = document.getElementById('tab-mockup-content');

  const tabData: Record<string, { title: string; html: string }> = {
    "1": {
      title: "FEATURE VIEW: 01 // Omnichannel Team Inbox",
      html: `
        <div class="p-4 rounded-2xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-neutral-900 dark:text-white flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Inbound WhatsApp Lead: CloudScale Bio ($75,000 ARR)
            </span>
            <span class="text-neutral-400 font-mono text-[11px]">02:14 AM</span>
          </div>
          <p class="text-xs text-neutral-700 dark:text-neutral-300">
            "We have 120 global reps. Can New-Relay auto-enrich leads, answer pricing FAQs, and create deals in our pipeline without human lag?"
          </p>
          <div class="p-3 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 text-xs text-blue-900 dark:text-blue-200 space-y-1">
            <div class="font-bold flex items-center gap-1.5">
              <span>⚡ Captain AI Deterministic Action:</span>
            </div>
            <div>✓ Enriched Domain &amp; Verified Budget ($75k)</div>
            <div>✓ Created Pipeline Opportunity in Salesforce &amp; Alerted Rep Sarah</div>
          </div>
        </div>
      `
    },
    "2": {
      title: "FEATURE VIEW: 02 // Captain AI Autonomous Resolver",
      html: `
        <div class="p-4 rounded-2xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between text-neutral-400">
            <span>RAG Context Search: SLA Terms &amp; Pricing PDF</span>
            <span class="text-emerald-500 font-bold">Confidence: 99.6%</span>
          </div>
          <div class="p-3 rounded-xl bg-white dark:bg-[#0D1117] border border-[#E5E7EB] dark:border-[#222938] space-y-1 font-sans">
            <div class="font-bold text-neutral-900 dark:text-white">Deterministic Guardrail Check: PASS ✓</div>
            <p class="text-xs text-neutral-600 dark:text-neutral-300">
              "Captain AI delivered exact quote breakdown for 120 seats with 99.99% carrier SLA without hallucinating unapproved discounts."
            </p>
          </div>
        </div>
      `
    },
    "3": {
      title: "FEATURE VIEW: 03 // CRM & Real-Time Deal Pipelines",
      html: `
        <div class="grid grid-cols-3 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-2">
            <div class="font-bold text-neutral-400 font-mono text-[10px]">QUALIFIED (3)</div>
            <div class="p-2.5 rounded-lg bg-white dark:bg-[#0D1117] border border-neutral-200 dark:border-neutral-800 space-y-1">
              <div class="font-bold text-neutral-900 dark:text-white">CloudScale Bio</div>
              <div class="text-emerald-600 font-mono text-[10px]">$75k ARR</div>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-2">
            <div class="font-bold text-blue-500 font-mono text-[10px]">DEMO HELD (2)</div>
            <div class="p-2.5 rounded-lg bg-white dark:bg-[#0D1117] border border-neutral-200 dark:border-neutral-800 space-y-1">
              <div class="font-bold text-neutral-900 dark:text-white">Nexus Labs AI</div>
              <div class="text-blue-500 font-mono text-[10px]">$48k ARR</div>
            </div>
          </div>
          <div class="p-3 rounded-xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-2">
            <div class="font-bold text-emerald-500 font-mono text-[10px]">CLOSED WON (6)</div>
            <div class="p-2.5 rounded-lg bg-white dark:bg-[#0D1117] border border-neutral-200 dark:border-neutral-800 space-y-1">
              <div class="font-bold text-neutral-900 dark:text-white">Hyperion Fintech</div>
              <div class="text-emerald-500 font-mono text-[10px]">$120k ARR</div>
            </div>
          </div>
        </div>
      `
    },
    "4": {
      title: "FEATURE VIEW: 04 // 60s Video Social Proof Engine",
      html: `
        <div class="p-4 rounded-2xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-3 text-xs">
          <div class="flex items-center justify-between">
            <span class="font-bold text-neutral-900 dark:text-white">Automated Review Trigger: Paid Invoice</span>
            <span class="text-amber-500 font-mono font-bold">5.0 ★ Rating</span>
          </div>
          <div class="p-3 rounded-xl bg-white dark:bg-[#0D1117] border border-[#E5E7EB] dark:border-[#222938] flex items-center justify-between">
            <div>
              <div class="font-bold text-neutral-900 dark:text-white">Elena Rostova (CMO @ FinPulse)</div>
              <div class="text-neutral-400 text-[11px]">Submitted 60s video testimonial via WhatsApp link</div>
            </div>
            <span class="px-2 py-1 rounded bg-amber-50 dark:bg-amber-500/10 text-amber-600 font-mono font-bold text-[10px]">VIDEO CAPTURED</span>
          </div>
        </div>
      `
    },
    "5": {
      title: "FEATURE VIEW: 05 // Security & Isolation Enclave",
      html: `
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-1">
            <div class="font-bold text-neutral-900 dark:text-white">Zero Data Retention</div>
            <div class="text-neutral-500 text-[11px]">Customer transcripts never stored or trained on LLMs.</div>
          </div>
          <div class="p-3 rounded-xl bg-[#F8F9FA] dark:bg-[#141A26] border border-[#E5E7EB] dark:border-[#1E2636] space-y-1">
            <div class="font-bold text-neutral-900 dark:text-white">Private VPC &amp; BYOK</div>
            <div class="text-neutral-500 text-[11px]">AES-256 encryption with customer-managed keys.</div>
          </div>
        </div>
      `
    }
  };

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.className = 'attio-tab p-5 rounded-2xl bg-transparent hover:bg-white/60 dark:hover:bg-[#12161F]/60 border-l-4 border-transparent border-t border-r border-b border-transparent shadow-none cursor-pointer transition-all space-y-1';
      });
      tab.className = 'attio-tab active p-5 rounded-2xl bg-white dark:bg-[#12161F] border-l-4 border-blue-600 dark:border-blue-500 border-t border-r border-b border-[#E5E7EB] dark:border-[#222938] shadow-sm cursor-pointer transition-all space-y-1';

      const key = tab.getAttribute('data-tab') || '1';
      const data = tabData[key];
      if (titleEl && contentEl && data) {
        titleEl.textContent = data.title;
        contentEl.innerHTML = data.html;
      }
    });
  });
</script>
