---
import Icon from '../icons/Icon.astro';
---

<section class="py-28 bg-[#0A0D12] text-white relative overflow-hidden border-t border-[#1E2636]">
  
  <!-- Glowing Horizon & Splines Background -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[500px] bg-gradient-to-b from-blue-600/15 via-indigo-600/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Giant Attio Display Typography Header -->
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-mono font-semibold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        <span>Deterministic Intelligence Enclave</span>
      </div>

      <h2 class="font-display text-5xl sm:text-7xl lg:text-[88px] font-semibold tracking-[-0.04em] leading-[0.98] text-white">
        Universal Context™
      </h2>

      <p class="text-base sm:text-lg md:text-xl text-neutral-400 max-w-2xl mx-auto leading-relaxed font-normal">
        A single, self-healing memory engine that unifies customer conversations, internal documentation, and pipeline telemetry into real-time autonomous revenue.
      </p>
    </div>

    <!-- Visual Architecture Diagram Grid (Attio Style) -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      
      <!-- Box 1: Multi-Channel Ingestion -->
      <div class="p-7 rounded-3xl bg-[#0D1117] border border-[#222B3D] space-y-4 shadow-2xl hover:border-blue-500/50 transition-all">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold text-sm font-mono border border-blue-500/20">
          01
        </div>
        <h3 class="text-xl font-bold text-white">Carrier Telemetry Ingest</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Direct carrier peering with Meta WhatsApp Cloud API and global SMS backbones with &lt;10ms packet routing.
        </p>
        <div class="pt-2 text-[11px] font-mono text-emerald-400">
          ✓ Sub-10ms Stream Ingested
        </div>
      </div>

      <!-- Box 2: Zero-Retention Vector Index -->
      <div class="p-7 rounded-3xl bg-[#0D1117] border border-[#222B3D] space-y-4 shadow-2xl hover:border-blue-500/50 transition-all">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-sm font-mono border border-purple-500/20">
          02
        </div>
        <h3 class="text-xl font-bold text-white">Zero-Retention Vector RAG</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Embed customer SLA contracts, product matrices, and pricing tiers into isolated in-memory vector indexes.
        </p>
        <div class="pt-2 text-[11px] font-mono text-purple-400">
          ✓ 99.6% Precision Threshold
        </div>
      </div>

      <!-- Box 3: Automated CRM Actions -->
      <div class="p-7 rounded-3xl bg-[#0D1117] border border-[#222B3D] space-y-4 shadow-2xl hover:border-blue-500/50 transition-all">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-sm font-mono border border-emerald-500/20">
          03
        </div>
        <h3 class="text-xl font-bold text-white">Bi-Directional CRM Sync</h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Instantaneous creation of structured Salesforce, HubSpot, and Stripe opportunities with exact ARR deal attribution.
        </p>
        <div class="pt-2 text-[11px] font-mono text-emerald-400">
          ✓ Real-Time Pipeline Update
        </div>
      </div>

    </div>

  </div>
</section>
