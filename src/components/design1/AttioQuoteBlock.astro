---
import Icon from '../icons/Icon.astro';
---

<section class="py-20 border-t border-[#E5E7EB] dark:border-[#1E2636] bg-white dark:bg-[#0D1117] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Attio-Style Large Editorial Serif Quote Block -->
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <div class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 mx-auto flex items-center justify-center font-serif text-xl">
        “
      </div>

      <blockquote class="font-serif text-2xl sm:text-3xl md:text-4xl text-neutral-900 dark:text-white leading-snug tracking-tight font-normal">
        “When I first deployed New-Relay, I instantly got the feeling this was the next generation of revenue infrastructure. Our inbound speed-to-lead dropped from 45 minutes to 8 seconds, and our close rate jumped by 3.2x.”
      </blockquote>

      <div class="pt-2 flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-full bg-neutral-200 dark:bg-neutral-800 flex items-center justify-center font-bold text-xs text-neutral-700 dark:text-neutral-300">
          AR
        </div>
        <div class="text-left text-xs">
          <div class="font-bold text-neutral-950 dark:text-white">Alex Rivers</div>
          <div class="text-neutral-500 font-mono">VP Revenue Operations @ CloudScale Bio</div>
        </div>
      </div>
    </div>

  </div>
</section>
