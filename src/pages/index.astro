---
import BaseLayout from '../layouts/BaseLayout.astro';
import AutomateXNavbar from '../components/AutomateXNavbar.astro';
import AutomateXHero from '../components/AutomateXHero.astro';
import TrustLogos from '../components/home1/TrustLogos.astro';
import ProblemSolution from '../components/home1/ProblemSolution.astro';
import OmnichannelShowcase from '../components/home1/OmnichannelShowcase.astro';
import AutomationWorkflow from '../components/home1/AutomationWorkflow.astro';
import CoreFeaturesBento from '../components/home1/CoreFeaturesBento.astro';
import IntegrationsEcosystem from '../components/home1/IntegrationsEcosystem.astro';
import SocialProofTestimonials from '../components/home1/SocialProofTestimonials.astro';
import TransparentPricing from '../components/home1/TransparentPricing.astro';
import FaqSection from '../components/home1/FaqSection.astro';
import FinalCtaBanner from '../components/home1/FinalCtaBanner.astro';
import AutomateXFooter from '../components/AutomateXFooter.astro';
---

<BaseLayout 
  title="NewRelay — Turn customer conversations & reviews into growth"
  description="Bring WhatsApp, Instagram, Google Reviews, Email, and SMS into one unified workspace. Automate routine replies, coordinate your team, and convert leads in seconds."
  bodyClass="bg-white"
>
  <!-- Floating Pill Navbar -->
  <AutomateXNavbar />

  <main>
    <!-- 1. HERO SECTION -->
    <AutomateXHero />

    <!-- 2. PARTNER TRUST LOGOS -->
    <TrustLogos />

    <!-- 3. PROBLEM VS SOLUTION TRANSFORMATION -->
    <ProblemSolution />

    <!-- 4. INTERACTIVE OMNICHANNEL SHOWCASE (WHATSAPP, IG, REVIEWS, TEAM INBOX) -->
    <OmnichannelShowcase />

    <!-- 5. VISUAL AUTOMATION & SMART AUTO-RESPONDER -->
    <AutomationWorkflow />

    <!-- 6. CORE FEATURES BENTO GRID -->
    <CoreFeaturesBento />

    <!-- 7. INTEGRATIONS ECOSYSTEM -->
    <IntegrationsEcosystem />

    <!-- 8. REAL CUSTOMER TESTIMONIALS & PROOF METRICS -->
    <SocialProofTestimonials />

    <!-- 9. TRANSPARENT PRICING TIERS -->
    <TransparentPricing />

    <!-- 10. FAQS ACCORDION -->
    <FaqSection />

    <!-- 11. FINAL HIGH-CONVERTING CTA BANNER -->
    <FinalCtaBanner />
  </main>

  <!-- FOOTER -->
  <AutomateXFooter />
</BaseLayout>
