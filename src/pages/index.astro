---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import AttioHero from '../components/design1/AttioHero.astro';
import AttioQuoteBlock from '../components/design1/AttioQuoteBlock.astro';
import AttioMotionTabs from '../components/design1/AttioMotionTabs.astro';
import AttioUniversalContext from '../components/design1/AttioUniversalContext.astro';
import AttioWorkflowBuilder from '../components/design1/AttioWorkflowBuilder.astro';
import EnterpriseComparison from '../components/EnterpriseComparison.astro';
import EnterpriseSecurity from '../components/EnterpriseSecurity.astro';
import PricingSection from '../components/PricingSection.astro';
import ChangelogSection from '../components/ChangelogSection.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Website Design 1: Enterprise Revenue OS | New-Relay"
  description="Design Concept 1: The Attio-inspired revenue operating system with two-tone typography, high-density CRM table canvas, vertical motion tabs, and Universal Context."
>
  <Banner />
  <Header activeDesign="1" />
  
  <main>
    <AttioHero />
    <AttioQuoteBlock />
    <AttioMotionTabs />
    <AttioUniversalContext />
    <AttioWorkflowBuilder />
    <EnterpriseComparison />
    <EnterpriseSecurity />
    <PricingSection />
    <ChangelogSection />
    <CtaSection />
  </main>

  <Footer />
</Layout>
