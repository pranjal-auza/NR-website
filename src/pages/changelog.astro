---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/icons/Icon.astro';

const releases = [
  {
    version: "v2.8.0",
    date: "August 28, 2026",
    tag: "AI & Automation",
    tagColor: "brand",
    title: "Captain AI Autonomous Resolution 2.0 & Scenario Rules",
    description: "Empower Captain AI to autonomously resolve inbound leads across WhatsApp, SMS, and Email with strict SLA guardrails and automatic CRM deal generation.",
    features: [
      "Vector document ingestion with chunk-level source citations",
      "AI Scenario builder with deterministic threshold overrides",
      "Auto-deal creation upon high-budget lead qualification"
    ]
  },
  {
    version: "v2.7.4",
    date: "August 21, 2026",
    tag: "Reputation & Social Proof",
    tagColor: "purple",
    title: "60-Second Instant Video Review Collector Widget",
    description: "Allow happy customers to submit verified video testimonials straight from their mobile browser without downloading an app or creating accounts.",
    features: [
      "Custom brand color themes and floating testimonial walls",
      "Automatic SMS and WhatsApp review outreach trigger",
      "Direct Google Business, Yelp, and Facebook listing sync"
    ]
  },
  {
    version: "v2.6.0",
    date: "August 14, 2026",
    tag: "Developer Ecosystem",
    tagColor: "emerald",
    title: "Model Context Protocol (MCP) Server & TypeScript SDK 3.0",
    description: "Connect New-Relay directly to AI agents, Claude Desktop, Cursor, and custom LLM workflows via our open MCP server implementation.",
    features: [
      "Real-time customer context retrieval for LLM prompts",
      "Sub-50ms webhook event deliveries with HMAC-SHA256 signatures",
      "Complete TypeScript SDK with end-to-end type safety"
    ]
  },
  {
    version: "v2.5.1",
    date: "August 07, 2026",
    tag: "CRM & Pipelines",
    tagColor: "amber",
    title: "Dynamic Visual Kanban & Deal Velocity Forecasting",
    description: "Accelerate revenue with multi-stage drag-and-drop pipelines, custom property modeling, and automated stage progression.",
    features: [
      "Real-time pipeline value calculation and win-rate analytics",
      "Collision detection to prevent duplicate rep outreach",
      "1-click migration from HubSpot, Salesforce, and Pipedrive"
    ]
  }
];
---

<Layout 
  title="Product Changelog | New-Relay"
  description="Weekly product updates, new features, and improvements shipped to New-Relay."
>
  <Banner />
  <Header />

  <main class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Changelog Header -->
      <div class="space-y-4 text-center">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Weekly Shipping Cadence</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-foreground">
          Product Changelog
        </h1>

        <p class="text-base sm:text-lg text-secondary-fg max-w-xl mx-auto leading-relaxed">
          Stay up to date with new features, AI agent capabilities, and performance enhancements shipped to New-Relay every week.
        </p>
      </div>

      <!-- Release Timeline List -->
      <div class="space-y-8 pt-6">
        {releases.map((rel) => (
          <article class="p-6 sm:p-8 rounded-2xl glass-panel border border-subtle-stroke shadow-attio-3 space-y-5 hover:border-default-stroke transition-all">
            
            <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2.5">
                <span class="font-mono px-2.5 py-1 rounded-md bg-surface font-semibold text-foreground border border-subtle-stroke">
                  {rel.version}
                </span>
                <span class="text-caption-fg font-mono">{rel.date}</span>
              </div>

              <span class="px-2.5 py-0.5 rounded-full bg-brand-500/15 text-brand-400 text-[11px] font-semibold border border-brand-500/20">
                {rel.tag}
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-xl sm:text-2xl font-bold text-foreground tracking-tight">
                {rel.title}
              </h2>
              <p class="text-sm sm:text-base text-secondary-fg leading-relaxed">
                {rel.description}
              </p>
            </div>

            <div class="pt-4 border-t border-subtle-stroke space-y-2">
              <div class="text-[11px] font-semibold text-caption-fg uppercase tracking-wider">Key Highlights:</div>
              <ul class="space-y-1.5 text-xs sm:text-sm text-foreground">
                {rel.features.map((feat) => (
                  <li class="flex items-center gap-2">
                    <Icon name="check" class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

          </article>
        ))}
      </div>

    </div>

    <CtaSection />
  </main>

  <Footer />
</Layout>
