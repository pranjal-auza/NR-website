---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import LamossaHero from '../components/design2/LamossaHero.astro';
import LamossaImpact from '../components/design2/LamossaImpact.astro';
import LamossaServicesBento from '../components/design2/LamossaServicesBento.astro';
import LamossaProcess from '../components/design2/LamossaProcess.astro';
import Design2RoiCalculator from '../components/design2/Design2RoiCalculator.astro';
import VideoTestimonialsWall from '../components/VideoTestimonialsWall.astro';
import LamossaPricing from '../components/design2/LamossaPricing.astro';
import LamossaFaq from '../components/design2/LamossaFaq.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Website Design 2: Lamossa Modern Studio & Revenue Engine | New-Relay"
  description="Design Concept 2: The high-conversion Lamossa-inspired aesthetic with coral red accents (#FF4D36), clean 01-04 numbered bento modules, 4-step deployment process, and interactive ROI calculator."
>
  <Banner />
  <Header activeDesign="2" />
  
  <main>
    <LamossaHero />
    <LamossaImpact />
    <LamossaServicesBento />
    <LamossaProcess />
    <Design2RoiCalculator />
    <VideoTestimonialsWall />
    <LamossaPricing />
    <LamossaFaq />
    <CtaSection />
  </main>

  <Footer />
</Layout>
